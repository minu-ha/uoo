// Dress Suite - Equip
// Original credit for the concept to Demlar

// Waits and timeouts - Adjust if you have issues with aspect applying, etc.
@setvar! wait__short 300

@setvar! wait__gump 300
@setvar! wait__timeout 300
@setvar! config__chatty 1

// Find equipped glove item
if findlayer self gloves as item
    getlabel item label__gloves
    if config__chatty = 1
        overhead "Gloves: {{label__gloves}}"
    endif
    @setvar! var__gloves item
// Equip previous glove item if needed
else 
    if varexist var__gloves
        getlabel var__gloves label__gloves
        if config__chatty = 1
            overhead "Wearing: {{label__gloves}}"
        endif
        lift var__gloves
        drop self gloves
    endif
endif

