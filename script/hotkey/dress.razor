// The satchel is an equippable item, not a container, so it is asked for here rather than
// in loadout. find with self covers both cases: sitting in the backpack, or already worn.
if not varexist global__my_wizard_satchel or not find global__my_wizard_satchel self
    unsetvar global__my_wizard_satchel
    overhead "Target your wizard satchel" 55
    setvar global__my_wizard_satchel
endif

if find global__my_wizard_satchel backpack
    lift global__my_wizard_satchel
    drop self pants
    wait wait__short
endif

if findtype 12215 backpack as quiver
    lift quiver
    drop self pants
    wait wait__short
endif

if findtype 22198 backpack as short_pipe
    lift short_pipe
    drop self pants
    wait wait__short
endif

if findtype 31217 backpack as travel_backpack
    dclick travel_backpack
    wait wait__short
endif

if findtype 31164 backpack as hip_lantern
    dclick hip_lantern
    wait wait__short
endif

if findtype 2597 backpack as lantern
    dclick lantern
    wait wait__short
endif

if findtype 31158 backpack as black_rim_glasses
    dclick black_rim_glasses
    wait wait__short
endif


overhead "Dress Suite - Equip completed" 88
