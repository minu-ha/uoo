// The satchel is an equippable item, not a container, so it is asked for here rather than
// in loadout. find with self covers both cases: sitting in the backpack, or already worn.
//
// dclick rather than drop self pants. Double clicking an equippable item lets the server put
// it on the layer it actually belongs to. The satchel, the quiver and the short pipe were all
// being dropped on pants, which holds one item, so they overwrote each other.
if not varexist global__my_wizard_satchel or not find global__my_wizard_satchel self
    unsetvar global__my_wizard_satchel
    overhead "Target your wizard satchel" 55
    setvar global__my_wizard_satchel
endif

if find global__my_wizard_satchel backpack
    dclick global__my_wizard_satchel
    wait wait__short
endif

if findtype 12215 backpack as alias__quiver
    dclick alias__quiver
    wait wait__short
endif

if findtype 22198 backpack as alias__short_pipe
    dclick alias__short_pipe
    wait wait__short
endif

if findtype 31217 backpack as alias__travel_backpack
    dclick alias__travel_backpack
