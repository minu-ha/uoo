                say "[AspectSpellbook Fortune"
            else
                say "[AspectArmor Fortune"
            endif
        elseif var__aspect_kind = 12
            if var__aspect_type = 1
                say "[AspectWeapon Frost"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Frost"
            else
                say "[AspectArmor Frost"
            endif
        elseif var__aspect_kind = 13
            if var__aspect_type = 1
                say "[AspectWeapon Gadget"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Gadget"
            else
                say "[AspectArmor Gadget"
            endif
        elseif var__aspect_kind = 14
            if var__aspect_type = 1
                say "[AspectWeapon Harvest"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Harvest"
            else
                say "[AspectArmor Harvest"
            endif
        elseif var__aspect_kind = 15
            if var__aspect_type = 1
                say "[AspectWeapon Holy"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Holy"
            else
                say "[AspectArmor Holy"
            endif
        elseif var__aspect_kind = 16
            if var__aspect_type = 1
                say "[AspectWeapon Lightning"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Lightning"
            else
                say "[AspectArmor Lightning"
            endif
        elseif var__aspect_kind = 17
            if var__aspect_type = 1
                say "[AspectWeapon Lyric"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Lyric"
            else
                say "[AspectArmor Lyric"
            endif
        elseif var__aspect_kind = 18
            if var__aspect_type = 1
                say "[AspectWeapon Madness"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Madness"
            else
                say "[AspectArmor Madness"
            endif
        elseif var__aspect_kind = 19
            if var__aspect_type = 1
                say "[AspectWeapon Poison"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Poison"
            else
                say "[AspectArmor Poison"
            endif
        elseif var__aspect_kind = 20
            if var__aspect_type = 1
                say "[AspectWeapon Shadow"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Shadow"
            else
                say "[AspectArmor Shadow"
            endif
        elseif var__aspect_kind = 21
            if var__aspect_type = 1
                say "[AspectWeapon Temporal"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Temporal"
            else
                say "[AspectArmor Temporal"
            endif
        elseif var__aspect_kind = 22
            if var__aspect_type = 1
                say "[AspectWeapon Void"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Void"
            else
                say "[AspectArmor Void"
            endif
        elseif var__aspect_kind = 23
            if var__aspect_type = 1
                say "[AspectWeapon War"
            elseif var__aspect_type = 2
                say "[AspectSpellbook War"
            else
                say "[AspectArmor War"
            endif
        elseif var__aspect_kind = 24
            if var__aspect_type = 1
                say "[AspectWeapon Water"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Water"
            else
                say "[AspectArmor Water"
            endif
        endif

        wait wait__aspect

        # The name shows the aspect again once it took.
        if index = 0
            getlabel var__aspect_hand_item label__aspect_read
        else
            getlabel var__aspect_armor_piece label__aspect_read
        endif

        if "aspect" in label__aspect_read
            if config__chatty = 1
                overhead "[ aspect, on ]" 269
            endif
        else
            overhead "[ aspect, miss ]" 254
        endif
    endif
endfor


