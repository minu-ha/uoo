# ----------------------------------------------------------------------------------------
# The pvp expression means the structured-PvP restrictions, where these loops may not run.
if pvp
    overhead "[ script, blocked ]" 254
    stop
endif

if config__clear_at_start = 1
    clearall
    clearsysmsg
    cleardragdrop
    clearignore
endif


# ----------------------------------------------------------------------------------------
# module/recovery/heal-first.razor
# ----------------------------------------------------------------------------------------
while diffhits >= config__heal_first_hits and timer "timer__heal_first" < wait__heal_first and not dead and not bandaging
    @setvar! var__heal_first_drank 0

    if not targetexists and findtype "Yellow Potion" self as alias__heal_first_potion
        getlabel alias__heal_first_potion label__heal_first_potion
        if "next usable" in label__heal_first_potion
            # Still on its own cooldown.
        else
            hotkey "Drink Heal"
            @setvar! var__heal_first_drank 1
        endif
    endif

    if var__heal_first_drank = 0 and var__heal_first_no_greater_heal = 0 and skill "Magery" >= 50 and mana >= config__heal_first_mana and not casting and not targetexists
        hotkey "> Greater Heal/Cure Self"
        wait wait__short

        while casting and timer "timer__heal_first" < wait__heal_first
            wait wait__short
        endwhile

        # Without the reagents it would only fail again.
        if insysmsg "More reagents are needed"
            @setvar! var__heal_first_no_greater_heal 1
        endif

        # The agent leaves its cursor up when there is nothing left to heal.
        if targetexists "beneficial" and diffhits = 0
            hotkey "Cancel Current Target"
        endif
    elseif var__heal_first_drank = 0 and skill "Healing" > 0 and not targetexists and findtype 3617 backpack
        hotkey "Bandage Self"
    endif

    wait wait__short
endwhile


