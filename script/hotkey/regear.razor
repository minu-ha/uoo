# ----------------------------------------------------------------------------------------
# Whatever was still moving items has to finish before the names are read.
while queued
    wait wait__short
endwhile

# The held item. The right hand holds a one-handed weapon or the spellbook, the left a
# two-handed weapon.
if findlayer self righthand as alias__aspect_item
    @setvar! var__aspect_hand_item alias__aspect_item
elseif findlayer self lefthand as alias__aspect_item
    @setvar! var__aspect_hand_item alias__aspect_item
endif

if var__aspect_hand_item != 0
    getlabel var__aspect_hand_item label__aspect_hand
    if "spellbook" in label__aspect_hand
        @setvar! var__aspect_book 1
    endif
endif

# The armor. The first piece worn is kept for the check after an activation. The first one
# that shows an aspect is the one read.
if findlayer self head as alias__aspect_item
    @setvar! var__aspect_armor_piece alias__aspect_item
    getlabel alias__aspect_item label__aspect_armor
    if "aspect" in label__aspect_armor
        @setvar! var__aspect_armor_item alias__aspect_item
    endif
endif

if var__aspect_armor_item = 0
    if findlayer self neck as alias__aspect_item
        if var__aspect_armor_piece = 0
            @setvar! var__aspect_armor_piece alias__aspect_item
        endif
        getlabel alias__aspect_item label__aspect_armor
        if "aspect" in label__aspect_armor
            @setvar! var__aspect_armor_item alias__aspect_item
        endif
    endif
endif

if var__aspect_armor_item = 0
    if findlayer self gloves as alias__aspect_item
        if var__aspect_armor_piece = 0
            @setvar! var__aspect_armor_piece alias__aspect_item
        endif
        getlabel alias__aspect_item label__aspect_armor
        if "aspect" in label__aspect_armor
            @setvar! var__aspect_armor_item alias__aspect_item
        endif
    endif
endif

if var__aspect_armor_item = 0
    if findlayer self arms as alias__aspect_item
        if var__aspect_armor_piece = 0
            @setvar! var__aspect_armor_piece alias__aspect_item
        endif
        getlabel alias__aspect_item label__aspect_armor
        if "aspect" in label__aspect_armor
            @setvar! var__aspect_armor_item alias__aspect_item
        endif
    endif
endif

if var__aspect_armor_item = 0
    if findlayer self innertorso as alias__aspect_item
        if var__aspect_armor_piece = 0
            @setvar! var__aspect_armor_piece alias__aspect_item
        endif
        getlabel alias__aspect_item label__aspect_armor
        if "aspect" in label__aspect_armor
            @setvar! var__aspect_armor_item alias__aspect_item
        endif
    endif
endif

if var__aspect_armor_item = 0
    if findlayer self innerlegs as alias__aspect_item
        if var__aspect_armor_piece = 0
            @setvar! var__aspect_armor_piece alias__aspect_item
        endif
        getlabel alias__aspect_item label__aspect_armor
        if "aspect" in label__aspect_armor
            @setvar! var__aspect_armor_item alias__aspect_item
        endif
    endif
endif

# Read the aspects: one pass for the held item, one for the armor, through the same chain.
# 99 when the name shows no aspect, or nothing is there to read.
for 2
    @setvar! var__aspect_found 99
    @setvar! var__aspect_item 0

    if index = 0
        @setvar! var__aspect_item var__aspect_hand_item
    else
        @setvar! var__aspect_item var__aspect_armor_item
    endif

    if var__aspect_item != 0
        getlabel var__aspect_item label__aspect_read

        if "agorawave aspect" in label__aspect_read
            @setvar! var__aspect_found 0
        elseif "air aspect" in label__aspect_read
            @setvar! var__aspect_found 1
        elseif "arcane aspect" in label__aspect_read
            @setvar! var__aspect_found 2
        elseif "artisan aspect" in label__aspect_read
            @setvar! var__aspect_found 3
        elseif "blood aspect" in label__aspect_read
            @setvar! var__aspect_found 4
        elseif "command aspect" in label__aspect_read
            @setvar! var__aspect_found 5
        elseif "death aspect" in label__aspect_read
            @setvar! var__aspect_found 6
        elseif "discipline aspect" in label__aspect_read
            @setvar! var__aspect_found 7
        elseif "earth aspect" in label__aspect_read
            @setvar! var__aspect_found 8
        elseif "eldritch aspect" in label__aspect_read
            @setvar! var__aspect_found 9
        elseif "fire aspect" in label__aspect_read
            @setvar! var__aspect_found 10
        elseif "fortune aspect" in label__aspect_read
            @setvar! var__aspect_found 11
        elseif "frost aspect" in label__aspect_read
            @setvar! var__aspect_found 12
        elseif "gadget aspect" in label__aspect_read
            @setvar! var__aspect_found 13
        elseif "harvest aspect" in label__aspect_read
            @setvar! var__aspect_found 14
        elseif "holy aspect" in label__aspect_read
            @setvar! var__aspect_found 15
        elseif "lightning aspect" in label__aspect_read
            @setvar! var__aspect_found 16
        elseif "lyric aspect" in label__aspect_read
            @setvar! var__aspect_found 17
        elseif "madness aspect" in label__aspect_read
            @setvar! var__aspect_found 18
        elseif "poison aspect" in label__aspect_read
            @setvar! var__aspect_found 19
        elseif "shadow aspect" in label__aspect_read
            @setvar! var__aspect_found 20
        elseif "temporal aspect" in label__aspect_read
            @setvar! var__aspect_found 21
        elseif "void aspect" in label__aspect_read
            @setvar! var__aspect_found 22
        elseif "war aspect" in label__aspect_read
            @setvar! var__aspect_found 23
        elseif "water aspect" in label__aspect_read
            @setvar! var__aspect_found 24
        endif
    endif

    if index = 0
        @setvar! var__aspect_hand_found var__aspect_found
    else
        @setvar! var__aspect_armor_found var__aspect_found
    endif
endfor

# Remember or restore. A shown aspect is remembered. A lost one is turned back on when one
# is remembered, and a warning asks for it to be turned on by hand once when none is.
for 2
    @setvar! var__aspect_type 0
    @setvar! var__aspect_kind 99

    if index = 0
        if var__aspect_hand_item != 0
            if var__aspect_hand_found != 99
                @setvar! var__aspect_hand var__aspect_hand_found
                if config__sysmsg = 1
                    sysmsg "Aspect: held item shows aspect {{var__aspect_hand_found}}, remembered." 88
                endif
            elseif var__aspect_hand != 99
                @setvar! var__aspect_kind var__aspect_hand
                @setvar! var__aspect_type 1
                if var__aspect_book = 1
                    @setvar! var__aspect_type 2
                endif
            else
                overhead "[ aspect, out ]" 254
                if config__sysmsg = 1
                    sysmsg "Aspect: none remembered for the held item. Turn it on by hand once." 88
                endif
            endif
        endif
    else
        if var__aspect_armor_piece != 0
            if var__aspect_armor_found != 99
                @setvar! var__aspect_armor var__aspect_armor_found
                if config__sysmsg = 1
                    sysmsg "Aspect: armor shows aspect {{var__aspect_armor_found}}, remembered." 88
                endif
            elseif var__aspect_armor != 99
                @setvar! var__aspect_kind var__aspect_armor
                @setvar! var__aspect_type 3
            else
                overhead "[ aspect, out ]" 254
                if config__sysmsg = 1
                    sysmsg "Aspect: none remembered for the armor. Turn it on by hand once." 88
                endif
            endif
        endif
    endif

    if var__aspect_type != 0
        if config__sysmsg = 1
            sysmsg "Aspect: turning on aspect {{var__aspect_kind}}, command type {{var__aspect_type}}." 88
        endif

        if var__aspect_kind = 0
            if var__aspect_type = 1
                say "[AspectWeapon Agorawave"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Agorawave"
            else
                say "[AspectArmor Agorawave"
            endif
        elseif var__aspect_kind = 1
            if var__aspect_type = 1
                say "[AspectWeapon Air"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Air"
            else
                say "[AspectArmor Air"
            endif
        elseif var__aspect_kind = 2
            if var__aspect_type = 1
                say "[AspectWeapon Arcane"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Arcane"
            else
                say "[AspectArmor Arcane"
            endif
        elseif var__aspect_kind = 3
            if var__aspect_type = 1
                say "[AspectWeapon Artisan"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Artisan"
            else
                say "[AspectArmor Artisan"
            endif
        elseif var__aspect_kind = 4
            if var__aspect_type = 1
                say "[AspectWeapon Blood"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Blood"
            else
                say "[AspectArmor Blood"
            endif
        elseif var__aspect_kind = 5
            if var__aspect_type = 1
                say "[AspectWeapon Command"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Command"
            else
                say "[AspectArmor Command"
            endif
        elseif var__aspect_kind = 6
            if var__aspect_type = 1
                say "[AspectWeapon Death"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Death"
            else
                say "[AspectArmor Death"
            endif
        elseif var__aspect_kind = 7
            if var__aspect_type = 1
                say "[AspectWeapon Discipline"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Discipline"
            else
                say "[AspectArmor Discipline"
            endif
        elseif var__aspect_kind = 8
            if var__aspect_type = 1
                say "[AspectWeapon Earth"
            elseif var__aspect_type = 2
                say "[AspectSpellbook Earth"
            else
                say "[AspectArmor Earth"
            endif
        elseif var__aspect_kind = 9
