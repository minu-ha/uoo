# # TIMER
# ####################################################################################
if not timerexists "timer__combat_target_grace"
    createtimer "timer__combat_target_grace"
endif

if not timerexists "timer__message"
    createtimer "timer__message"
endif

if not timerexists "timer__equip"
    createtimer "timer__equip"
endif

if not timerexists "timer__str_potion"
    createtimer "timer__str_potion"
endif

if not timerexists "timer__agi_potion"
    createtimer "timer__agi_potion"
endif

if not timerexists "timer__sword_retry"
    createtimer "timer__sword_retry"
endif

if not timerexists "timer__sword_resync"
    createtimer "timer__sword_resync"
endif

if not timerexists "timer__parry_retry"
    createtimer "timer__parry_retry"
endif

if not timerexists "timer__parry_resync"
    createtimer "timer__parry_resync"
endif

if not timerexists "timer__ability"
    createtimer "timer__ability"
endif

if not timerexists "timer__carve"
    createtimer "timer__carve"
endif

if not timerexists "timer__grey_only"
    createtimer "timer__grey_only"
endif

if not timerexists "timer__reagents"
    createtimer "timer__reagents"
endif

if not timerexists "timer__food"
    createtimer "timer__food"
endif

if not timerexists "timer__pack_leather"
    createtimer "timer__pack_leather"
endif

settimer "timer__combat_target_grace" cooldown__combat_target_grace
settimer "timer__message" cooldown__message
settimer "timer__equip" cooldown__equip_retry
settimer "timer__str_potion" cooldown__stat_potion
settimer "timer__agi_potion" cooldown__stat_potion
settimer "timer__sword_retry" cooldown__stance_retry
settimer "timer__sword_resync" 0
settimer "timer__parry_retry" cooldown__stance_retry
settimer "timer__parry_resync" 0
settimer "timer__ability" cooldown__ability
settimer "timer__carve" cooldown__carve
settimer "timer__grey_only" cooldown__grey_only
# Ready on the first pass, so reagents are read before the first cast.
settimer "timer__reagents" cooldown__reagents
settimer "timer__food" cooldown__food
# Packing waits one full interval.
settimer "timer__pack_leather" 0

# ####################################################################################
# # STATE
# ####################################################################################
# The enemy picked with lasttarget. Carving overwrites lasttarget, so combat potions and the
# weapon ability read this copy instead.
if not varexist var__combat_target
    @setvar! var__combat_target 0
endif
# Scratch copy of the lasttarget serial for the mobile range check.
@setvar! var__fresh_serial 0
# 1 while an enemy is remembered. Recomputed every pass from var__combat_target.
@setvar! var__fighting 0

# Scratch: 1 once a heal potion went out on this pass. HEAL only.
@setvar! var__heal_potion_out 0

# Scratch: 1 when the light Heal goes on this pass. LIGHT HEAL only.
@setvar! var__light_heal_due 0

# Selected axe serial, reused across Stop and Play. 0 means rediscover from the backpack.
if not varexist var__my_weapon
    @setvar! var__my_weapon 0
endif

# Sword stance cache. 0 means unknown, which forces a codex label read on the first pass.
@setvar! var__sword_want config__sword_stance_main
@setvar! var__sword_active 0
# 1 when the codex label names no stance. Switching blind could toggle the stance off.
@setvar! var__sword_disabled 0
# The finisher is checked once per Play, on the first codex label read.
@setvar! var__sword_finisher_checked 0
# Scratch: 0 neither finisher named, 1 wanted finisher active, 2 the other one active.
@setvar! var__sword_finisher_state 0

# Parry stance cache, as for the sword codex. 0 means unknown and forces a label read.
@setvar! var__parry_want config__parry_stance_main
@setvar! var__parry_active 0
@setvar! var__parry_disabled 0
@setvar! var__parry_finisher_checked 0
@setvar! var__parry_finisher_state 0

# 1 while another block holds our buff casts back. Nothing sets it unless the loop has such a block.
@setvar! var__hold_casts 0

# Scratch: 1 when a Z pick arrived while the knife cursor was up.
@setvar! var__pick_during_carve 0
# Scratch: 1 targets the corpse, 0 uses Smart Harvest. Chosen for each carve.
@setvar! var__carve_direct 0
# Scratch: 1 when the corpse found this pass may be carved.
@setvar! var__corpse_ok 0
# 1 after a corpse carving criminal act, read from the carve reply. The label check should keep
# player remains out, so this is only a safety net. Direct carving then stays off until the next Play.
@setvar! var__carve_crime 0
# Corpse that missed once (too far or busy). It gets one more request, then it is ignored.
@setvar! var__carve_retry 0
# Scratch Smart Harvest reply: 0 none yet, 1 carved, 2 nothing left to carve here.
@setvar! var__carve_reply 0
# Selected knife serial, reused across Stop and Play. 0 means rediscover from the backpack.
if not varexist var__my_knife
    @setvar! var__my_knife 0
endif

# Reagent flags, written only by REAGENTS. 1 when every reagent of that spell was found.
#   Cure            garlic 3972, ginseng 3973
#   Heal            garlic, ginseng, silk 3981
#   Greater Heal    garlic, ginseng, silk, mandrake 3974
#   Reactive Armor  garlic, silk, ash 3980
#   Reflection      garlic, silk, mandrake
@setvar! var__regs_cure 0
@setvar! var__regs_heal 0
@setvar! var__regs_greater_heal 0
@setvar! var__regs_reactive_armor 0
@setvar! var__regs_magic_reflect 0
@setvar! var__has_garlic 0
@setvar! var__has_ginseng 0
@setvar! var__has_mandrake 0
@setvar! var__has_ash 0
@setvar! var__has_silk 0

if config__pack_leather = 1
    if not varexist global__my_looting_pouch or not find global__my_looting_pouch backpack
        overhead "[ loot pouch, pick ]" 255
        setvar global__my_looting_pouch
    endif
endif

# loot/recycle runs the hotkey named in this list when it finishes or gives up. A list, because
# a variable cannot hold a word (blueprint/razor.html part 3). It lasts until the client closes.
if not listexists 'list__resume_script'
    createlist 'list__resume_script'
endif
clearlist 'list__resume_script'
pushlist 'list__resume_script' 'Play Script: gather\skinning-enhanced'

if config__sysmsg = 1
    sysmsg "Skinning enhanced v11 loaded: skin unowned={{config__skin_unowned}}, sword stance={{config__sword_stance_main}}, parry stance={{config__parry_stance_main}}." 88
endif
if config__chatty = 1
    overhead "[ skinning, on ]" 290
endif

# ####################################################################################
# # MAIN LOOP
# ####################################################################################
while not dead
    # The pvp expression means structured-PvP restrictions, not a field PK encounter.
    if pvp
        overhead "[ script, blocked ]" 254
        stop
    endif

    # ################################################################################
    # # COMBAT TARGET CACHE
    # ################################################################################
    # Same cache as bard-mace. A carve targets the corpse or yourself, which moves lasttarget.
    # A targeted corpse is an item on the ground, so find matches it. dead and noto only take
    # mobiles, so the serial range is checked first. Mobile serials are below 0x40000000, and the
    # number has to be on the left (blueprint/razor.html part 3, debug-target-state S06).
    if find lasttarget ground -1 -1 12 as alias__fresh_target
        if var__combat_target != alias__fresh_target
            @setvar! var__fresh_serial alias__fresh_target
            if 0x40000000 > var__fresh_serial
                if not dead alias__fresh_target
                    if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                        @setvar! var__combat_target alias__fresh_target
                        settimer "timer__combat_target_grace" 0
                        if config__sysmsg = 1
                            sysmsg "Combat target: {{alias__fresh_target}}. Skinning and leather packing wait." 88
                        endif
                    endif
                endif
            endif
        endif
    endif

    if find var__combat_target ground -1 -1 12 as alias__stored_target
        if dead alias__stored_target
            @setvar! var__combat_target 0
            if config__sysmsg = 1
                sysmsg "Combat target cleared: dead." 88
            endif
        elseif noto alias__stored_target != "hostile" and noto alias__stored_target != "criminal" and noto alias__stored_target != "enemy" and noto alias__stored_target != "murderer"
            @setvar! var__combat_target 0
        else
            settimer "timer__combat_target_grace" 0
        endif
    elseif var__combat_target != 0 and timer "timer__combat_target_grace" >= cooldown__combat_target_grace
        @setvar! var__combat_target 0
        if config__sysmsg = 1
            sysmsg "Combat target cleared: gone from 12 tiles." 88
        endif
    endif

    # Fight-only blocks such as the stat potions read this.
    @setvar! var__fighting 0
    if var__combat_target != 0
        @setvar! var__fighting 1
    endif

    # ################################################################################
    # # PARALYZE
    # ################################################################################
    # Nothing else can act while held, so the pouch goes out at once, as in bard-necro-enhanced.
    if paralyzed
        if findtype 3705 backpack 38
            yell "[Pouch"
            wait wait__short
        elseif timer "timer__message" >= cooldown__message
            overhead "[ pouch, out ]" 254
            settimer "timer__message" 0
        endif
    endif

    # ################################################################################
    # # CURE
    # ################################################################################
    # Potion first, it is instant and has no cooldown, and it goes out during a cast. While any
    # cure potion is carried the agent is not used, so mana stays for Greater Heal. The agent
    # waits for the walk bar and for warmode as config__walk_guard and config__warmode_is_manual say.
    if poisoned and not paralyzed and not hidden and not queued and not targetexists
        if config__use_potions = 1 and findtype "Orange Potion" self
            hotkey "Drink Cure"
            wait wait__short
        else
            if config__use_potions = 1 and timer "timer__message" >= cooldown__message
                overhead "[ cure pot, out ]" 254
                settimer "timer__message" 0
            endif

            if config__use_magery = 1 and var__regs_cure = 1 and mana >= config__mana_cure and not casting
                if config__warmode_is_manual = 0 or not warmode
                    if config__walk_guard = 0 or cooldown "walk" = 0
                        hotkey "> Smart Heal/Cure Self"
                        if config__sysmsg = 1
                            sysmsg "Agent: Smart Heal/Cure Self for poison." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            wait wait__poll
                        endfor
                    endif
                endif
            endif
        endif
    endif

    # ################################################################################
    # # HEAL
    # ################################################################################
    # Heavy damage drinks first, because the potion is instant and goes out during a cast.
    # Greater Heal follows when no potion went out on this pass and the loss is at the
    # emergency line: none carried, on its own cooldown, or the bar still running.
    # The bar skips the label read while it runs. The label stays authoritative when the bar
    # is missing. Greater Heal waits for the walk bar and for warmode as the switches say.
    if not poisoned and not paralyzed and not hidden and not queued and not targetexists and diffhits >= config__heal_hits
        @setvar! var__heal_potion_out 0
        if config__use_potions = 1 and cooldown "heal pot" = 0
            if findtype "Yellow Potion" self as alias__heal_potion
                getlabel alias__heal_potion label__heal_potion
                if "next usable" in label__heal_potion
                    # Still on its own cooldown.
                else
                    hotkey "Drink Heal"
                    @setvar! var__heal_potion_out 1
                    wait wait__short
                endif
            elseif timer "timer__message" >= cooldown__message
                overhead "[ heal pot, out ]" 254
                settimer "timer__message" 0
            endif
        endif

        if var__heal_potion_out = 0 and diffhits >= config__emergency_hits and config__use_magery = 1 and var__regs_greater_heal = 1 and mana >= config__mana_greater_heal and not casting
            if config__warmode_is_manual = 0 or not warmode
                if config__walk_guard = 0 or cooldown "walk" = 0
                    hotkey "> Greater Heal/Cure Self"
                    if config__sysmsg = 1
                        sysmsg "Agent: Greater Heal/Cure Self." 88
                    endif
                    wait wait__short

                    for 60
                        if not casting
                            break
                        endif
                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            break
                        endif
                        wait wait__poll
                    endfor

                    # The agent leaves its beneficial cursor up when there is nothing left to heal.
                    if targetexists "beneficial" and diffhits = 0
                        hotkey "Cancel Current Target"
                        wait wait__short
                    endif
                endif
            endif
        endif
    endif

    # ################################################################################
    # # BANDAGE
    # ################################################################################
    # Never restarts a running bandage, and full health does not start one. Its target cursor
    # would replace a held precast, so it waits while any cursor is up.
    if config__use_bandages = 1 and not bandaging and not paralyzed and not hidden and not queued and not targetexists and skill "Healing" > config__heal_skill_min
        if diffhits > 0 or poisoned
            if findtype 3617 self
                hotkey "Bandage Self"
                wait wait__short
            elseif timer "timer__message" >= cooldown__message
                overhead "[ bandage, out ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif

    # ################################################################################
    # # LIGHT HEAL
    # ################################################################################
    # The bandage stand-in whenever no bandage can run: bandages off, no Healing, or none left
    # and none running. Beside the bandages only with config__use_light_heal 1. The agent waits
    # for the walk bar and for warmode as the switches say.
    if not poisoned and not paralyzed and not hidden and not queued and not casting and not targetexists and config__use_magery = 1 and var__regs_heal = 1 and diffhits >= config__light_hits and mana >= config__mana_heal
        @setvar! var__light_heal_due 0
        if config__use_light_heal = 1 or config__use_bandages = 0 or skill "Healing" <= config__heal_skill_min
            @setvar! var__light_heal_due 1
        elseif not bandaging and not findtype 3617 self
            @setvar! var__light_heal_due 1
        endif

        if var__light_heal_due = 1
            if config__warmode_is_manual = 0 or not warmode
                if config__walk_guard = 0 or cooldown "walk" = 0
                    hotkey "> Smart Heal/Cure Self"
                    if config__sysmsg = 1
                        sysmsg "Agent: Smart Heal/Cure Self, light Heal." 88
                    endif
                    wait wait__short

                    for 60
                        if not casting
                            break
                        endif
                        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                            break
                        endif
                        wait wait__poll
                    endfor

                    if targetexists "beneficial" and diffhits = 0
                        hotkey "Cancel Current Target"
                        wait wait__short
                    endif
                endif
            endif
        endif
    endif

    # ################################################################################
    # # REFRESH
    # ################################################################################
    if stam <= config__refresh_stam and config__use_potions = 1 and not paralyzed and not hidden and not queued and not targetexists
        if findtype "Red Potion" self
            hotkey "Drink Refresh"
            wait wait__short
        endif
    endif

    # ################################################################################
    # # WEAPON
    # ################################################################################
    # The Two-Handed Axe takes the lefthand layer, so an empty left hand means it is gone.
    # Arming before a cast completes interrupts the cast (wiki Combat Overview), so casting blocks this.
    # An axe already in hand is adopted once by label, including a replacement with a new serial.
    # Any other left hand item is left alone.
    if config__use_weapon = 1 and timer "timer__equip" >= cooldown__equip_retry
        if lhandempty
            if not hidden and not queued and not casting and not targetexists
                settimer "timer__equip" 0
                if not find var__my_weapon backpack
                    @setvar! var__my_weapon 0
                    if findtype config__weapon_graphic backpack as alias__packed_weapon
                        @setvar! var__my_weapon alias__packed_weapon
                    endif
                endif

                if find var__my_weapon backpack as alias__weapon_to_equip
                    # lift waits for the held item. The retry timer spaces the next hand check,
                    # so a refused equip after a disarm does not stall recovery.
                    lift alias__weapon_to_equip
                    drop self lefthand
                    if config__sysmsg = 1
                        sysmsg "Axe equip requested: serial={{alias__weapon_to_equip}}. The next check reads the hand." 88
                    endif
                    wait wait__short
                elseif timer "timer__message" >= cooldown__message
                    overhead "[ axe, out ]" 254
                    settimer "timer__message" 0
                endif
            endif
        elseif findlayer self lefthand as alias__equipped_weapon
            if var__my_weapon != alias__equipped_weapon
                settimer "timer__equip" 0
                getlabel alias__equipped_weapon label__hand_weapon
                # item-list names the type "two handed axe" and hally-mage reads "two-handed axe".
                if "two-handed axe" in label__hand_weapon or "two handed axe" in label__hand_weapon or "Two-Handed Axe" in label__hand_weapon or "Two Handed Axe" in label__hand_weapon
                    @setvar! var__my_weapon alias__equipped_weapon
                    if config__sysmsg = 1
                        sysmsg "Axe adopted from the left hand: serial={{alias__equipped_weapon}}." 88
                    endif
                endif
            endif
        endif
    endif

    # ################################################################################
    # # GOLD
    # ################################################################################
    # One drop per pass, so recovery still runs between drops. A refused drop goes back to the pack.
    if config__use_gold_drop = 1 and weight > maxweight
        if not hidden and not queued and not casting and not targetexists
            if findtype "gold coin" backpack as alias__found_gold
                lift alias__found_gold config__gold_drop_amount
                droprelloc 0 0
                if config__sysmsg = 1
                    sysmsg "Gold drop: up to {{config__gold_drop_amount}} at your feet, weight over max." 88
                endif
                wait wait__short

                if insysmsg "cannot drop anything"
                    drop backpack -1 -1 -1
                endif

                wait wait__long
                if config__chatty = 1
                    overhead "[ gold, dropped ]" 290
                endif
            elseif timer "timer__message" >= cooldown__message
                overhead "[ weight, over ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif

    # ################################################################################
    # # STAT POTIONS
    # ################################################################################
    # Kept up while var__fighting is 1. Strength and Agility read the stat against config__str_potion
    # and config__dex_potion, because Bless and the Strength and Agility spells show the same
    # icons as the potions, and each is tried once per cooldown__stat_potion. Magic Resist has an
    # icon of its own and is drunk once it is missing. Each potion is judged on its own, so
    # running out of one does not hold up the others.
    if var__fighting = 1 and config__use_potions = 1 and config__use_stat_potions = 1 and not paralyzed and not hidden and not targetexists
        if not queued and str < config__str_potion and timer "timer__str_potion" >= cooldown__stat_potion
            settimer "timer__str_potion" 0
            if findtype "White Potion" self
                hotkey "Drink Strength"
                wait wait__short
            endif
        endif
        if not queued and dex < config__dex_potion and timer "timer__agi_potion" >= cooldown__stat_potion
            settimer "timer__agi_potion" 0
            if findtype "Blue Potion" self
                hotkey "Drink Agility"
                wait wait__short
            endif
        endif
        if config__use_resist_potion = 1 and not queued and not findbuff "Magic Resist Potion"
            if findtype "Black Potion" self
                hotkey "Drink Magic Resist"
                wait wait__short
            endif
        endif
    endif

    # ################################################################################
    # # SWORD CODEX
    # ################################################################################
    # This template has no Arms Lore, so weapon specials (Lacerate and Bleed) stay at their 10%
    # base chance. Every choice below avoids depending on them.
    # Warrior is the default: accuracy, defense and damage at 2% per rank, with no condition
    # attached. Aggressive gives less per rank, Cleave needs a second enemy within 2 tiles and
    # Flaying only grows the special bleed. Defensive has the same damage bonus as Warrior and
    # trades accuracy and defense for 4% damage resistance per rank, so it takes over while hurt.
    # Stance numbers and effects are on the wiki, Weapon_and_Parry_Codex.
    #
    # The codex label is the only source of truth, as in bard-mace. The cache is refreshed from
    # the label on a timer, which also catches a stance changed by hand. getlabel runs after
    # recovery so a server round trip never delays a bandage or a heal potion.
    if config__use_sword_codex = 1 and var__sword_disabled = 0
        if timer "timer__sword_resync" > cooldown__stance_resync
            @setvar! var__sword_active 0
            settimer "timer__sword_resync" 0
        endif

        if diffhits > config__defensive_enter_diff
            @setvar! var__sword_want config__sword_stance_defensive
        elseif diffhits < config__defensive_leave_diff
            @setvar! var__sword_want config__sword_stance_main
        endif

        if var__sword_want != var__sword_active and timer "timer__sword_retry" > cooldown__stance_retry
            settimer "timer__sword_retry" 0

            if findtype 11890 backpack as alias__sword_codex
                getlabel alias__sword_codex label__sword_codex

                # All five names are tested. Finding none means the label does not carry the
                # stance, and blind switching would risk toggling the active stance off.
                if "Warrior" in label__sword_codex
                    @setvar! var__sword_active config__sword_stance_warrior
                elseif "Defensive" in label__sword_codex
                    @setvar! var__sword_active config__sword_stance_defensive
                elseif "Aggressive" in label__sword_codex
                    @setvar! var__sword_active config__sword_stance_aggressive
                elseif "Cleave" in label__sword_codex
                    @setvar! var__sword_active config__sword_stance_cleave
                elseif "Flaying" in label__sword_codex
                    @setvar! var__sword_active config__sword_stance_flaying
                else
                    @setvar! var__sword_disabled 1
                    overhead "[ sword stance, off ]" 254
                    if config__sysmsg = 1
                        sysmsg "Sword codex label names no stance, sword stance stands down: {{label__sword_codex}}" 88
                    endif
                endif

                # FINISHER: one finisher triggers once per creature at its health threshold.
                # The chance is 10% plus 10% scaled by Anatomy, so 18% at Anatomy 80.
                # Execute deals 600% at once. Its bleed resolve adds little with rare specials.
                # Bleed Out spreads 800% over time, and a creature at the threshold usually dies
                # before that resolves. The selection persists per character, so it is checked
                # once per Play. Only a label that names the other finisher is switched. No name
                # means none is selected or the label does not show it, and a blind command could
                # toggle it off.
                if var__sword_disabled = 0 and var__sword_finisher_checked = 0 and config__sword_finisher_main != 0
                    @setvar! var__sword_finisher_checked 1
                    @setvar! var__sword_finisher_state 0
                    if config__sword_finisher_main = config__sword_finisher_execute
                        if "Execute" in label__sword_codex
                            @setvar! var__sword_finisher_state 1
                        elseif "Bleed Out" in label__sword_codex
                            @setvar! var__sword_finisher_state 2
                        endif
                    else
                        if "Bleed Out" in label__sword_codex
                            @setvar! var__sword_finisher_state 1
                        elseif "Execute" in label__sword_codex
                            @setvar! var__sword_finisher_state 2
                        endif
                    endif

                    if var__sword_finisher_state = 2
                        if config__sword_finisher_main = 1
                            say "[SwordsFinisher1"
                        elseif config__sword_finisher_main = 2
                            say "[SwordsFinisher2"
                        endif
                        if config__sysmsg = 1
                            sysmsg "Sword finisher switch: slot {{config__sword_finisher_main}}." 88
                        endif
                        # Keep the finisher and stance commands apart.
                        wait wait__short
                        if config__chatty = 1
                            if config__sword_finisher_main = config__sword_finisher_execute
                                overhead "[ sword, execute ]" 290
                            else
                                overhead "[ sword, bleed out ]" 290
                            endif
                        endif
                    elseif var__sword_finisher_state = 0
                        if config__sword_finisher_main = config__sword_finisher_execute
                            overhead "[ execute, off ]" 254
                        else
                            overhead "[ bleed out, off ]" 254
                        endif
                    endif
                endif

                if var__sword_disabled = 0 and var__sword_want != var__sword_active
                    if config__sysmsg = 1
                        sysmsg "Sword stance switch: slot {{var__sword_active}} to {{var__sword_want}}." 88
                    endif
                    if var__sword_want = 1
                        say "[SwordsStance1"
                    elseif var__sword_want = 2
                        say "[SwordsStance2"
                    elseif var__sword_want = 3
                        say "[SwordsStance3"
                    elseif var__sword_want = 4
                        say "[SwordsStance4"
                    elseif var__sword_want = 5
                        say "[SwordsStance5"
                    endif

                    # Assume it took. Saying it again before the label catches up would risk
                    # toggling the stance straight back off.
                    @setvar! var__sword_active var__sword_want
                    settimer "timer__sword_resync" 0

                    if config__chatty = 1
                        if var__sword_want = config__sword_stance_defensive
                            overhead "[ sword, defensive ]" 290
                        elseif var__sword_want = config__sword_stance_warrior
                            overhead "[ sword, warrior ]" 290
                        elseif var__sword_want = config__sword_stance_aggressive
                            overhead "[ sword, aggressive ]" 290
                        elseif var__sword_want = config__sword_stance_cleave
                            overhead "[ sword, cleave ]" 290
                        elseif var__sword_want = config__sword_stance_flaying
                            overhead "[ sword, flaying ]" 290
                        endif
                    endif
                endif
            elseif timer "timer__message" >= cooldown__message
                overhead "[ sword codex, out ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif

    # ################################################################################
    # # PARRY CODEX
    # ################################################################################
    # Parrying works with a two handed weapon and the codex needs Parrying 80 and Tactics 80
    # (wiki Parrying). Per rank, from Weapon_and_Parry_Codex:
    #   Testudo  damage resistance 3%, 6% while you are in the front arc of the target
    #   Warding  damage resistance 2%, and poison, bleed and disease ticks 6% lower
    #   Bulwark  5% after 3 seconds standing still. Mirror 2% and spell damage 6% lower.
    # Testudo is the main stance. A creature meleeing you nearly always has you in its front arc.
    # Warding takes over while poisoned, bleeding or diseased, but only away from melee. Next to
    # the remembered enemy Testudo still blocks 4% per rank more of every hit, which outweighs
    # the tick reduction unless the ticks deal most of the damage. config__parry_dot_in_melee 1
    # switches anyway. Bleed and Disease are buff bar icons on the wiki, Template:BuffIcons.
    #
    # Last Stand is the default finisher: below the parry threshold it has a 5% chance per rank to
    # turn a hit into 1 damage. Barrier takes a flat 0.6 per rank off each hit, which is less
    # against the big hits that matter there.
    #
    # Same label machinery as SWORD CODEX. No stance name in the label means none is selected or
    # the label does not show it, and a blind command could toggle it off, so the block warns once
    # and stands down for this Play.
    if config__use_parry_codex = 1 and var__parry_disabled = 0
        if timer "timer__parry_resync" > cooldown__stance_resync
            @setvar! var__parry_active 0
            settimer "timer__parry_resync" 0
        endif

        @setvar! var__parry_want config__parry_stance_main
        if poisoned or findbuff "Bleed" or findbuff "Disease"
            if config__parry_dot_in_melee = 1 or not find var__combat_target ground -1 -1 2
                @setvar! var__parry_want config__parry_stance_dot
            endif
        endif

        if var__parry_want != var__parry_active and timer "timer__parry_retry" > cooldown__stance_retry
            settimer "timer__parry_retry" 0

            if findtype 11889 backpack as alias__parry_codex
                getlabel alias__parry_codex label__parry_codex
                if "Testudo" in label__parry_codex
                    @setvar! var__parry_active config__parry_stance_testudo
                elseif "Warding" in label__parry_codex
                    @setvar! var__parry_active config__parry_stance_warding
                elseif "Shield Bash" in label__parry_codex
                    @setvar! var__parry_active config__parry_stance_shield_bash
                elseif "Mirror" in label__parry_codex
                    @setvar! var__parry_active config__parry_stance_mirror
                elseif "Bulwark" in label__parry_codex
                    @setvar! var__parry_active config__parry_stance_bulwark
                else
                    @setvar! var__parry_disabled 1
                    overhead "[ parry stance, off ]" 254
                    if config__sysmsg = 1
                        sysmsg "Parry codex label names no stance, parry stance stands down: {{label__parry_codex}}" 88
                    endif
                endif

                # FINISHER: checked once per Play, only when the label proved it carries the stance.
                if var__parry_disabled = 0 and var__parry_finisher_checked = 0 and config__parry_finisher_main != 0
                    @setvar! var__parry_finisher_checked 1
                    @setvar! var__parry_finisher_state 0
                    if config__parry_finisher_main = config__parry_finisher_last_stand
                        if "Last Stand" in label__parry_codex
                            @setvar! var__parry_finisher_state 1
                        elseif "Barrier" in label__parry_codex
                            @setvar! var__parry_finisher_state 2
                        endif
                    else
                        if "Barrier" in label__parry_codex
                            @setvar! var__parry_finisher_state 1
                        elseif "Last Stand" in label__parry_codex
                            @setvar! var__parry_finisher_state 2
                        endif
                    endif

                    if var__parry_finisher_state = 2
                        if config__parry_finisher_main = 1
                            say "[ShieldsFinisher1"
                        elseif config__parry_finisher_main = 2
                            say "[ShieldsFinisher2"
                        endif
                        if config__sysmsg = 1
                            sysmsg "Parry finisher switch: slot {{config__parry_finisher_main}}." 88
                        endif
                        # Keep the finisher and stance commands apart.
                        wait wait__short
                        if config__chatty = 1
                            if config__parry_finisher_main = config__parry_finisher_last_stand
                                overhead "[ parry, last stand ]" 290
                            else
                                overhead "[ parry, barrier ]" 290
                            endif
                        endif
                    elseif var__parry_finisher_state = 0
                        if config__parry_finisher_main = config__parry_finisher_last_stand
                            overhead "[ last stand, off ]" 254
                        else
                            overhead "[ barrier, off ]" 254
                        endif
                    endif
                endif

                if var__parry_disabled = 0 and var__parry_want != var__parry_active
                    if config__sysmsg = 1
                        sysmsg "Parry stance switch: slot {{var__parry_active}} to {{var__parry_want}}. Damage over time and melee decide Warding." 88
                    endif
                    if var__parry_want = 1
                        say "[ShieldsStance1"
                    elseif var__parry_want = 2
                        say "[ShieldsStance2"
                    elseif var__parry_want = 3
                        say "[ShieldsStance3"
                    elseif var__parry_want = 4
                        say "[ShieldsStance4"
                    elseif var__parry_want = 5
                        say "[ShieldsStance5"
                    endif

                    # Assume it took, as in SWORD CODEX.
                    @setvar! var__parry_active var__parry_want
                    settimer "timer__parry_resync" 0

                    if config__chatty = 1
                        if var__parry_want = config__parry_stance_testudo
                            overhead "[ parry, testudo ]" 290
                        elseif var__parry_want = config__parry_stance_warding
                            overhead "[ parry, warding ]" 290
                        elseif var__parry_want = config__parry_stance_shield_bash
                            overhead "[ parry, shield bash ]" 290
                        elseif var__parry_want = config__parry_stance_mirror
                            overhead "[ parry, mirror ]" 290
                        elseif var__parry_want = config__parry_stance_bulwark
                            overhead "[ parry, bulwark ]" 290
                        endif
                    endif
                endif
            elseif timer "timer__message" >= cooldown__message
                overhead "[ shield codex, out ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif

    # ################################################################################
    # # WEAPON ABILITY
    # ################################################################################
    # Chop is the default: one hit at +250%, independent of weapon specials. Spinslash spreads
    # +15% over 15 seconds, about two hits' worth. Rend needs bleeds already on the target.
    # All three share one meter, and the ability fires on the next melee hit. Chop is further
    # scaled by weapon speed, and that formula is not documented.
    # A timer spaces the request, as in bard-mace. A wrong interval only shifts the timing.
    if config__use_weapon_ability = 1 and timer "timer__ability" >= cooldown__ability and find var__combat_target ground -1 -1 2
        if config__ability_main = 1
            say "[WeaponAbility1"
        elseif config__ability_main = 2
            say "[WeaponAbility2"
        elseif config__ability_main = 3
            say "[WeaponAbility3"
        endif
        settimer "timer__ability" 0
        if config__sysmsg = 1
            sysmsg "Weapon ability request: slot {{config__ability_main}}. Fires on the next melee hit." 88
        endif

        if config__chatty = 1
            if config__ability_main = config__ability_chop
                overhead "[ chop ]" 219
            elseif config__ability_main = config__ability_spinslash
                overhead "[ spinslash ]" 219
            elseif config__ability_main = config__ability_rend
                overhead "[ rend ]" 219
            endif
        endif
    endif

    # ################################################################################
    # # SELF BUFFS
    # ################################################################################
    # Reactive Armor, then Magic Reflection, whenever one is missing and the window is free.
    # Not started at config__buff_max_loss, and cut there mid cast so the next pass can heal.
    # With config__buff_when_poisoned 0 poison holds them back and cuts them too, so the cure
    # goes first. var__hold_casts lets another block keep the cast window (a latched Recall).
    # The walk and warmode switches apply as for the heal agents. The reflect bar is the
    # server's recast lock after Reflect is used up.
    if config__use_magery = 1 and var__hold_casts = 0 and not paralyzed and not hidden and not queued and not casting and not targetexists and diffhits < config__buff_max_loss
        if config__buff_when_poisoned = 1 or not poisoned
            if config__warmode_is_manual = 0 or not warmode
                if config__walk_guard = 0 or cooldown "walk" = 0
                    if config__use_reactive_armor = 1 and var__regs_reactive_armor = 1 and mana >= config__mana_reactive_armor and not findbuff "Reactive Armor"
                        cast "Reactive Armor"
                        if config__sysmsg = 1
                            sysmsg "Buff: Reactive Armor." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif
                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif
                            wait wait__poll
                        endfor
                    elseif config__use_magic_reflect = 1 and var__regs_magic_reflect = 1 and mana >= config__mana_magic_reflect and cooldown "reflect" = 0 and not findbuff "Magic Reflection"
                        cast "Magic Reflection"
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Reflection." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif
                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif
                            wait wait__poll
                        endfor
                    endif
                endif
            endif
        endif
    endif

    # ################################################################################
    # # SKINNING
    # ################################################################################
    # Smart Harvest (target self) carves grey corpses within 2 tiles. Corpses without looting
    # rights need the corpse itself as the target. Wiki: Forensic_Evaluation.
    # Some areas refuse that as a criminal action: "Criminal actions are not permitted in the
    # Sanctuary Dungeon." A refusal switches this block to Smart Harvest for cooldown__grey_only,
    # and each later refusal starts that window again.
    #
    # Handled corpses are ignored so findtype returns the next one. Only the startup clearignore
    # empties the list. Leather packing ignores pouch leather without clearing it.
    #   direct: creature corpses only. A finished or refused corpse is ignored. A miss (too far,
    #           busy) gets one more request, and a second miss ignores it.
    #           A creature corpse label reads "<creature> corpse". A player corpse reads
    #           "the remains of <name>", and carving one without looting rights is a criminal
    #           act (in-game 2026-10-07). Any label without "corpse", or with "remains", is
    #           ignored without a request.
    #   Smart Harvest: until the server finds nothing worth carving here, then ignore every
    #                  corpse within 2 tiles until a new one drops.
    #
    # Carving waits while an enemy is remembered, so it runs between fights. A carve moves Razor's
    # lasttarget to the corpse or to yourself, and the V after a Z can come any time later.
    # setlasttarget cannot put it back in this client: it opened a Set Last Target cursor and held
    # the script on that line (blueprint/razor.html part 3). A Z pick made while the knife cursor is
    # up cancels that cursor rather than overwriting lasttarget.
    # The profile shows the refusal itself. The script only records the mode change.
    if insysmsg "Criminal actions are not permitted"
        settimer "timer__grey_only" 0
        if config__sysmsg = 1
            sysmsg "Carve mode: grey corpses only for 5 minutes after a criminal action refusal." 88
        endif
    endif

    if config__use_skinning = 1 and timer "timer__carve" >= cooldown__carve and var__combat_target = 0
        settimer "timer__carve" 0
        @setvar! var__carve_direct 0
        if config__skin_unowned = 1 and var__carve_crime = 0 and timer "timer__grey_only" >= cooldown__grey_only
            @setvar! var__carve_direct 1
        endif

        if diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not queued and not casting and not targetexists and findtype 8198 ground -1 -1 2 as alias__corpse
            @setvar! var__corpse_ok 1
            if var__carve_direct = 1
                getlabel alias__corpse label__corpse
                @setvar! var__corpse_ok 0
                if "corpse" in label__corpse or "Corpse" in label__corpse
                    @setvar! var__corpse_ok 1
                endif
                if "remains" in label__corpse or "Remains" in label__corpse
                    @setvar! var__corpse_ok 0
                endif
                if var__corpse_ok = 0
                    @ignore alias__corpse
                    if config__sysmsg = 1
                        sysmsg "Carve skip: corpse={{alias__corpse}}, label={{label__corpse}}." 88
                    endif
                endif
            endif

            if var__corpse_ok = 1
                if not find var__my_knife backpack
                    @setvar! var__my_knife 0
                    if findtype 11552|11564 backpack as alias__packed_knife
                        @setvar! var__my_knife alias__packed_knife
                    endif
                endif

                if find var__my_knife backpack as alias__knife
                    dclick alias__knife
                    waitfortarget wait__carve_target

                    if targetexists "neutral" and not hidden
                        # No enemy was remembered when this block started, so a live enemy in lasttarget
                        # now is a Z pressed during the cursor wait.
                        @setvar! var__pick_during_carve 0
                        if find lasttarget ground -1 -1 12 as alias__fresh_target
                            @setvar! var__fresh_serial alias__fresh_target
                            if 0x40000000 > var__fresh_serial
                                if not dead alias__fresh_target
                                    if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                        @setvar! var__pick_during_carve 1
                                        @setvar! var__combat_target alias__fresh_target
                                        settimer "timer__combat_target_grace" 0
                                    endif
                                endif
                            endif
                        endif

                        if var__pick_during_carve = 1
                            # Leave lasttarget on the new enemy. The corpse is tried again after the fight.
                            hotkey "Cancel Current Target"
                            if config__sysmsg = 1
                                sysmsg "Carve cancelled: an enemy was picked during the knife cursor." 88
                            endif
                            wait wait__short
                        elseif var__carve_direct = 1
                            target alias__corpse
                            if config__sysmsg = 1
                                sysmsg "Carve request: corpse={{alias__corpse}}." 88
                            endif
                            # Read the reply, without break. The criminal lines come first so a later
                            # match cannot clear them before they are seen. Replies (in-game 2026-10-07):
                            #   1 "You carve materials from the corpse." or "That corpse has already been carved."
                            #   2 "That is too far away." or "You must wait to perform another action."
                            #   3 a criminal act or a criminal action refusal
                            @setvar! var__carve_reply 0
                            settimer "timer__carve" 0
                            while var__carve_reply = 0 and timer "timer__carve" < wait__carve_reply
                                if insysmsg "corpse carving on"
                                    @setvar! var__carve_reply 3
                                    @setvar! var__carve_crime 1
                                    overhead "[ carve, grey only ]" 254
                                elseif insysmsg "Criminal actions are not permitted"
                                    @setvar! var__carve_reply 3
                                    settimer "timer__grey_only" 0
                                elseif insysmsg "You carve materials"
                                    @setvar! var__carve_reply 1
                                elseif insysmsg "already been carved"
                                    @setvar! var__carve_reply 1
                                elseif insysmsg "too far away"
                                    @setvar! var__carve_reply 2
                                elseif insysmsg "must wait to perform another action"
                                    @setvar! var__carve_reply 2
                                else
                                    wait wait__poll
                                endif
                            endwhile

                            # A miss gets one more request, so a step closer can still carve it.
                            # Everything else, and a second miss, ignores the corpse.
                            if var__carve_reply = 2 and var__carve_retry != alias__corpse
                                @setvar! var__carve_retry alias__corpse
                            else
                                @ignore alias__corpse
                                @setvar! var__carve_retry 0
                            endif

                            if config__sysmsg = 1
                                if var__carve_reply = 1
                                    sysmsg "Carve done: corpse={{alias__corpse}}." 88
                                elseif var__carve_reply = 2 and var__carve_retry = alias__corpse
                                    sysmsg "Carve miss: corpse={{alias__corpse}}, too far or busy. One more try." 88
                                elseif var__carve_reply = 2
                                    sysmsg "Carve miss again: corpse={{alias__corpse}}. Skipped." 88
                                elseif var__carve_reply = 3
                                    sysmsg "Carve refused as criminal: corpse={{alias__corpse}}. Grey corpses only for now." 88
                                else
                                    sysmsg "Carve no reply: corpse={{alias__corpse}}. Skipped." 88
                                endif
                            endif
                        else
                            target self
                            if config__sysmsg = 1
                                sysmsg "Carve request: Smart Harvest." 88
                            endif
                            # Condition-terminated wait, without break.
                            @setvar! var__carve_reply 0
                            settimer "timer__carve" 0
                            while var__carve_reply = 0 and timer "timer__carve" < wait__carve_reply
                                if insysmsg "worth carving"
                                    @setvar! var__carve_reply 2
                                elseif insysmsg "You carve materials"
                                    @setvar! var__carve_reply 1
                                else
                                    wait wait__poll
                                endif
                            endwhile

                            # Nothing grey is left here. Bounded sweep, no break.
                            if var__carve_reply = 2
                                for 10
                                    if findtype 8198 ground -1 -1 2 as alias__carved_corpse
                                        @ignore alias__carved_corpse
                                    endif
                                endfor
                            endif

                            if config__sysmsg = 1
                                if var__carve_reply = 1
                                    sysmsg "Smart Harvest: carved." 88
                                elseif var__carve_reply = 2
                                    sysmsg "Smart Harvest: nothing left here. Corpses within 2 tiles skipped." 88
                                else
                                    sysmsg "Smart Harvest: no reply." 88
                                endif
                            endif
                        endif
                    endif
                elseif timer "timer__message" >= cooldown__message
                    overhead "[ knife, out ]" 254
                    settimer "timer__message" 0
                endif
            endif
        endif
        settimer "timer__carve" 0
    endif

    # ################################################################################
    # # REAGENTS
    # ################################################################################
    # First in the pass, so every cast block below reads fresh flags. On the interval, or at once
    # after a refusal for reagents, so a stale flag cannot send the same doomed cast every pass.
    if config__use_magery = 1
        if timer "timer__reagents" >= cooldown__reagents or insysmsg "More reagents are needed"
            settimer "timer__reagents" 0

            @setvar! var__has_garlic 0
            @setvar! var__has_ginseng 0
            @setvar! var__has_mandrake 0
            @setvar! var__has_ash 0
            @setvar! var__has_silk 0

            if findtype 3972 self
                @setvar! var__has_garlic 1
            endif
            if findtype 3973 self
                @setvar! var__has_ginseng 1
            endif
            if findtype 3974 self
                @setvar! var__has_mandrake 1
            endif
            if findtype 3980 self
                @setvar! var__has_ash 1
            endif
            if findtype 3981 self
                @setvar! var__has_silk 1
            endif

            @setvar! var__regs_cure 0
            @setvar! var__regs_heal 0
            @setvar! var__regs_greater_heal 0
            @setvar! var__regs_reactive_armor 0
            @setvar! var__regs_magic_reflect 0

            if var__has_garlic = 1 and var__has_ginseng = 1
                @setvar! var__regs_cure 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_silk = 1
                @setvar! var__regs_heal 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_silk = 1 and var__has_mandrake = 1
                @setvar! var__regs_greater_heal 1
            endif
            if var__has_garlic = 1 and var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_reactive_armor 1
            endif
            if var__has_garlic = 1 and var__has_silk = 1 and var__has_mandrake = 1
                @setvar! var__regs_magic_reflect 1
            endif
        endif
    endif

    # ################################################################################
    # # FOOD
    # ################################################################################
    # Looked at once a minute. The buff lasts far longer.
    if timer "timer__food" >= cooldown__food and not findbuff "Food Satisfaction"
        if not hidden and not queued and not casting and not targetexists
            settimer "timer__food" 0
            if findtype tray backpack as alias__food
                dclick alias__food
                wait wait__short
            endif
        endif
    endif

    # ################################################################################
    # # LEATHER
    # ################################################################################
    # Same shape as the lumberjack-enhanced Boards pass. No hue filter, so colored leather moves too.
    # Only between fights. Recursive backpack searches can return leather already in the pouch,
    # so membership is checked before ignore, and only pouch stacks are ignored.
    # No clearignore here: the list also holds the carved corpses. A refused move is found
    # again and retried until the pass budget runs out, then on the next interval.
    if config__pack_leather = 1 and timer "timer__pack_leather" >= cooldown__pack_leather and var__combat_target = 0
        if diffhits < config__heal_hits and not poisoned and not paralyzed
            if not hidden and not queued and not casting and not targetexists
                settimer "timer__pack_leather" 0
                if find global__my_looting_pouch backpack
                    if config__sysmsg = 1
                        sysmsg "Leather pack BEGIN." 88
                    endif
                    dclick global__my_looting_pouch
                    wait wait__pack_item
                    settimer "timer__pack_leather" 0

                    while queued and timer "timer__pack_leather" < wait__pack_batch and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists
                        wait wait__poll
                    endwhile

                    while timer "timer__pack_leather" < wait__pack_batch and not queued and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists and find global__my_looting_pouch backpack and findtype 4225 backpack as alias__leather_stack
                        if find alias__leather_stack global__my_looting_pouch
                            @ignore alias__leather_stack
                        else
                            # Complete lift/drop together. Do not leave the item held during a wait.
                            if config__sysmsg = 1
                                sysmsg "Leather move request: serial={{alias__leather_stack}}." 88
                            endif
                            lift alias__leather_stack 60000
                            drop global__my_looting_pouch -1 -1
                            wait wait__pack_item
                        endif

                        while queued and timer "timer__pack_leather" < wait__pack_batch and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists
                            wait wait__poll
                        endwhile
                    endwhile
                    if config__sysmsg = 1
                        sysmsg "Leather pack END." 88
                    endif
                elseif timer "timer__message" >= cooldown__message
                    overhead "[ loot pouch, out ]" 254
                    settimer "timer__message" 0
                endif
                # The next interval starts after this pass, including a missing-pouch attempt.
                settimer "timer__pack_leather" 0
            endif
        endif
    endif

    wait wait__poll
endwhile
