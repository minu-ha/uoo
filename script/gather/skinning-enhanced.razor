                @setvar! var__regs_magic_arrow 1
            endif
            if var__has_nightshade = 1 and var__has_silk = 1
                @setvar! var__regs_harm 1
            endif
            if var__has_black_pearl = 1
                @setvar! var__regs_fireball 1
            endif
            if var__has_mandrake = 1 and var__has_ash = 1
                @setvar! var__regs_lightning 1
            endif
            if var__has_garlic = 1 and var__has_nightshade = 1 and var__has_ash = 1
                @setvar! var__regs_curse 1
            endif
            if var__has_black_pearl = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_mana_drain 1
            endif
            if var__has_black_pearl = 1 and var__has_nightshade = 1
                @setvar! var__regs_energy_bolt 1
            endif
            if var__has_garlic = 1 and var__has_mandrake = 1
                @setvar! var__regs_bless 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1 and var__has_ash = 1
                @setvar! var__regs_arch_protection 1
            endif
            if var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_flamestrike 1
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # FOOD                                                          module/buff/food.razor
    # ------------------------------------------------------------------------------------
    if timer "timer__food" >= interval__food and not findbuff "Food Satisfaction"
        if config__warmode_is_manual = 0 or not warmode
            if not hidden and not queued and not casting and not targetexists
                settimer "timer__food" 0
                if findtype tray backpack as alias__food
                    dclick alias__food
                    wait wait__short
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # LEATHER                                                    module/pack/leather.razor
    # ------------------------------------------------------------------------------------
    if timer "timer__pack_leather" >= interval__pack_leather and var__combat_target = 0
        if diffhits < config__heal_hits and not poisoned and not paralyzed
            if not hidden and not queued and not casting and not targetexists
                settimer "timer__pack_leather" 0
                if find global__my_looting_pouch backpack
                    if config__sysmsg = 1
                        sysmsg "Leather pack BEGIN." 88
                    endif
                    dclick global__my_looting_pouch
                    wait wait__pack_item
                    settimer "timer__pack_leather" 0

                    while queued and timer "timer__pack_leather" < wait__pack_batch and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists
                        wait wait__poll
                    endwhile

                    while timer "timer__pack_leather" < wait__pack_batch and not queued and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists and find global__my_looting_pouch backpack and findtype 4225 backpack as alias__leather_stack
                        if find alias__leather_stack global__my_looting_pouch
                            @ignore alias__leather_stack
                        else
                            # Complete lift/drop together. Do not leave the item held during a wait.
                            if config__sysmsg = 1
                                sysmsg "Leather move request: serial={{alias__leather_stack}}." 88
                            endif
                            lift alias__leather_stack 60000
                            drop global__my_looting_pouch -1 -1
                            wait wait__pack_item
                        endif

                        while queued and timer "timer__pack_leather" < wait__pack_batch and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists
                            wait wait__poll
                        endwhile
                    endwhile
                    if config__sysmsg = 1
                        sysmsg "Leather pack END." 88
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ loot pouch, out ]" 254
                    settimer "timer__message" 0
                endif
                # The next interval starts after this pass, including a missing-pouch attempt.
                settimer "timer__pack_leather" 0
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # END OF PASS                                                        module/base.razor
    # ------------------------------------------------------------------------------------
    wait wait__poll
endwhile
