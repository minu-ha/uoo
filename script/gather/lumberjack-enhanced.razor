# loot/recycle runs the hotkey named in this list when it finishes or gives up. A list, because
# a variable cannot hold a word (blueprint/razor.html part 3). It lasts until the client closes.
if not listexists 'list__resume_script'
    createlist 'list__resume_script'
endif
clearlist 'list__resume_script'
pushlist 'list__resume_script' 'Play Script: gather\lumberjack-enhanced'

if config__sysmsg = 1
    sysmsg "Lumberjack enhanced v18 loaded: tracking color={{config__tracking_color}}." 88
endif
if config__chatty = 1
    overhead "[ lumberjack, on ]" 290
endif


# ========================================================================================
# MAIN LOOP
# ========================================================================================
while not dead
    # ------------------------------------------------------------------------------------
    # PASS START                                                         module/base.razor
    #
    # The pvp expression means structured-PvP restrictions, not a field PK encounter. With
    # config__settle_first 1 the pass then waits for the item queue and any cast to
    # finish.
    # ------------------------------------------------------------------------------------
    if pvp
        overhead "[ script, blocked ]" 254
        stop
    endif

    if config__settle_first = 1
        while queued or casting
            wait wait__short
        endwhile
    endif

    if paralyzed or poisoned or diffhits > 0
        # --------------------------------------------------------------------------------
        # PARALYZE                                             module/recovery/pouch.razor
        #
        # Nothing else can act while held, so the pouch goes out at once, as in
        # bard-necro-enhanced.
        # --------------------------------------------------------------------------------
        if paralyzed
            if findtype 3705 backpack 38
                yell "[Pouch"
                wait wait__short
            elseif timer "timer__message" >= interval__message
                overhead "[ pouch, out ]" 254
                settimer "timer__message" 0
            endif
        endif

        # --------------------------------------------------------------------------------
        # CURE                                                  module/recovery/cure.razor
        #
        # Potion first, it is instant and has no cooldown, and it goes out during a cast.
        # While any cure potion is carried the agent is not used, so mana stays for
        # Greater Heal. The agent waits for the walk bar and for warmode as
        # config__walk_guard and config__warmode_is_manual say.
        # --------------------------------------------------------------------------------
        if poisoned and not paralyzed and not hidden and not queued and not targetexists
            if config__use_potions = 1 and findtype "Orange Potion" self
                hotkey "Drink Cure"
                wait wait__short
            else
                if config__use_potions = 1 and timer "timer__message" >= interval__message
                    overhead "[ cure pot, out ]" 254
                    settimer "timer__message" 0
                endif

                if config__use_magery = 1 and var__regs_cure = 1 and mana >= config__mana_cure and not casting
                    if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                        if config__walk_guard = 0 or cooldown "walk" = 0
                            hotkey "> Smart Heal/Cure Self"
                            if config__sysmsg = 1
                                sysmsg "Agent: Smart Heal/Cure Self for poison." 88
                            endif
                            wait wait__short

                            for 60
                                if not casting
                                    break
                                endif
                                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                    break
                                endif
                                wait wait__poll
                            endfor
                        endif
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # HEAL                                                  module/recovery/heal.razor
        #
        # Heavy damage drinks first, because the potion is instant and goes out during a
        # cast. Greater Heal follows when no potion went out on this pass and the loss is
        # at the emergency line: none carried, on its own cooldown, or the bar still
        # running. The bar skips the label read while it runs. The label stays
        # authoritative when the bar is missing. Greater Heal waits for the walk bar and
        # for warmode as config__walk_guard and config__warmode_is_manual say.
        # --------------------------------------------------------------------------------
        if not poisoned and not paralyzed and not hidden and not queued and not targetexists and diffhits >= config__heal_hits
            @setvar! var__heal_potion_out 0
            if config__use_potions = 1 and cooldown "heal pot" = 0
                if findtype "Yellow Potion" self as alias__heal_potion
                    getlabel alias__heal_potion label__heal_potion
                    if "next usable" in label__heal_potion
                        # Still on its own cooldown.
                    else
                        hotkey "Drink Heal"
                        cooldown "heal pot" cooldown__heal_potion
                        @setvar! var__heal_potion_out 1
                        wait wait__short
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ heal pot, out ]" 254
                    settimer "timer__message" 0
                endif
            endif

            if var__heal_potion_out = 0 and diffhits >= config__emergency_hits and config__use_magery = 1 and var__regs_greater_heal = 1 and mana >= config__mana_greater_heal and not casting
                if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                    if config__walk_guard = 0 or cooldown "walk" = 0
                        hotkey "> Greater Heal/Cure Self"
                        if config__sysmsg = 1
                            sysmsg "Agent: Greater Heal/Cure Self." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            wait wait__poll
                        endfor

                        # The agent leaves its beneficial cursor up when there is nothing left to heal.
                        if targetexists "beneficial" and diffhits = 0
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # BANDAGE                                            module/recovery/bandage.razor
        #
        # Never restarts a running bandage, and full health does not start one. Its target
        # cursor would replace a held precast, so it waits while any cursor is up.
        # --------------------------------------------------------------------------------
        if config__use_bandages = 1 and not bandaging and not paralyzed and not hidden and not queued and not targetexists and skill "Healing" > config__heal_skill_min
            if diffhits > 0 or poisoned
                if findtype 3617 self
                    hotkey "Bandage Self"
                    wait wait__short
                elseif timer "timer__message" >= interval__message
                    overhead "[ bandage, out ]" 254
                    settimer "timer__message" 0
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # LIGHT HEAL                                      module/recovery/light-heal.razor
        #
        # The bandage stand-in whenever no bandage can run: bandages off, no Healing, or
        # none left and none running. Beside the bandages only with config__use_light_heal
        # 1. The agent waits for the walk bar and for warmode as config__walk_guard and
        # config__warmode_is_manual say.
        # --------------------------------------------------------------------------------
        if not poisoned and not paralyzed and not hidden and not queued and not casting and not targetexists and config__use_magery = 1 and var__regs_heal = 1 and diffhits >= config__light_hits and mana >= config__mana_heal
            @setvar! var__light_heal_due 0
            if config__use_light_heal = 1 or config__use_bandages = 0 or skill "Healing" <= config__heal_skill_min
                @setvar! var__light_heal_due 1
            elseif not bandaging and not findtype 3617 self
                @setvar! var__light_heal_due 1
            endif

            if var__light_heal_due = 1
                if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                    if config__walk_guard = 0 or cooldown "walk" = 0
                        hotkey "> Smart Heal/Cure Self"
                        if config__sysmsg = 1
                            sysmsg "Agent: Smart Heal/Cure Self, light Heal." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            wait wait__poll
                        endfor

                        if targetexists "beneficial" and diffhits = 0
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # REFRESH                                                module/recovery/refresh.razor
    # ------------------------------------------------------------------------------------
    if stam <= config__refresh_stam and config__use_potions = 1 and not paralyzed and not hidden and not queued and not targetexists
        if findtype "Red Potion" self
            hotkey "Drink Refresh"
            wait wait__short
        endif
    endif

    # ------------------------------------------------------------------------------------
    # RECALL                                                    module/escape/recall.razor
    #
    # The slow checks (book, Tracking buff, weight) run every interval__recall_check.
    # ------------------------------------------------------------------------------------
    @setvar! var__recall_check_due 0
    if timer "timer__recall_check" >= interval__recall_check
        @setvar! var__recall_check_due 1
        settimer "timer__recall_check" 0
    endif

    if var__recall_sent = 0
        if var__recall_check_due = 1
            if var__recall_needed = 0 and config__recall_on_detection = 1 and skill "Tracking" > 0
                @setvar! var__tracking_hunting_active 0
                if var__tracking_filter_confirmed = 1 and findbuff "tracking"
                    @setvar! var__tracking_hunting_active 1
                endif

                if var__tracking_hunting_active = 0 and timer "timer__message" >= interval__message
                    overhead "[ track, check ]" 255
                    settimer "timer__message" 0
                endif
            endif

            @setvar! var__recall_book_available 0
            if findtype "runebook" backpack or findtype "runetome" backpack
                @setvar! var__recall_book_available 1
            elseif config__require_runebook = 1 and timer "timer__message" >= interval__message
                overhead "[ runebook, out ]" 254
                settimer "timer__message" 0
            endif
        endif

        # Read Tracking before harvesting and inventory maintenance. Profile overheads display it.
        if config__recall_on_detection = 1
            if var__tracking_hunting_active = 1 and var__recall_needed = 0
                if config__recall_at_any_distance = 1
                    if insysmsg "Now tracking:" or insysmsg "Distance to destination:" or insysmsg "spaces to target"
                        @setvar! var__recall_needed 1
                    endif
                else
                    # Keep all 45 literal distance branches. No player find is needed.
                    if insysmsg "Distance to destination: 45 steps" or insysmsg "(45 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 44 steps" or insysmsg "(44 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 43 steps" or insysmsg "(43 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 42 steps" or insysmsg "(42 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 41 steps" or insysmsg "(41 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 40 steps" or insysmsg "(40 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 39 steps" or insysmsg "(39 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 38 steps" or insysmsg "(38 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 37 steps" or insysmsg "(37 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 36 steps" or insysmsg "(36 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 35 steps" or insysmsg "(35 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 34 steps" or insysmsg "(34 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 33 steps" or insysmsg "(33 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 32 steps" or insysmsg "(32 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 31 steps" or insysmsg "(31 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 30 steps" or insysmsg "(30 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 29 steps" or insysmsg "(29 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 28 steps" or insysmsg "(28 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 27 steps" or insysmsg "(27 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 26 steps" or insysmsg "(26 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 25 steps" or insysmsg "(25 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 24 steps" or insysmsg "(24 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 23 steps" or insysmsg "(23 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 22 steps" or insysmsg "(22 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 21 steps" or insysmsg "(21 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 20 steps" or insysmsg "(20 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 19 steps" or insysmsg "(19 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 18 steps" or insysmsg "(18 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 17 steps" or insysmsg "(17 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 16 steps" or insysmsg "(16 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 15 steps" or insysmsg "(15 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 14 steps" or insysmsg "(14 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 13 steps" or insysmsg "(13 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 12 steps" or insysmsg "(12 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 11 steps" or insysmsg "(11 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 10 steps" or insysmsg "(10 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 9 steps" or insysmsg "(9 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 8 steps" or insysmsg "(8 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 7 steps" or insysmsg "(7 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 6 steps" or insysmsg "(6 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 5 steps" or insysmsg "(5 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 4 steps" or insysmsg "(4 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 3 steps" or insysmsg "(3 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 2 steps" or insysmsg "(2 spaces to target)"
                        @setvar! var__recall_needed 1
                    elseif insysmsg "Distance to destination: 1 steps" or insysmsg "(1 spaces to target)"
                        @setvar! var__recall_needed 1
                    endif
                endif
                if var__recall_needed = 1 and config__sysmsg = 1
                    sysmsg "Recall trigger: Tracking report, configured color={{config__tracking_color}}." 88
                endif
            endif
        endif

        # Weight shares the check clock. Detection is always read first.
        if var__recall_check_due = 1
            if config__recall_on_weight = 1 and var__recall_needed = 0
                if diffweight <= config__weight_remaining
                    @setvar! var__recall_needed 1
                    if config__sysmsg = 1
                        sysmsg "Recall trigger: spare weight at or below {{config__weight_remaining}}." 88
                    endif
                    if timer "timer__message" >= interval__message
                        overhead "[ weight, low ]" 254
                        settimer "timer__message" 0
                    endif
                endif
            endif
        endif

        # Keep gathering paused while waiting for mana, a book or free input.
        if var__recall_needed = 1
            # Heat of Battle is not a local gate. Let the server accept or refuse the request.
            # Recall uses no combat preparation or Strength and Agility potions.
            if mana >= config__mana_recall and not paralyzed and not warmode
                if not hidden and not queued and not casting and not targetexists and cooldown "walk" = 0
                    if var__recall_book_available = 1
                        if findtype "runebook" backpack or findtype "runetome" backpack
                            # Change Home to your rune name. This requests Recall, not Gate Travel.
                            say "[RecallCharge Home"
                            @setvar! var__recall_sent 1

                            if config__chatty = 1
                                overhead "[ recall, on ]" 290
                            endif

                            wait wait__short
                        else
                            # A removed book invalidates the cache. Wait for the next check to search again.
                            @setvar! var__recall_book_available 0
                        endif
                    endif

                    if var__recall_book_available = 0 and timer "timer__message" >= interval__message
                        overhead "[ runebook, out ]" 254
                        settimer "timer__message" 0
                    endif
                endif
            elseif mana < config__mana_recall and timer "timer__message" >= interval__message
                overhead "[ mana, low ]" 254
                settimer "timer__message" 0
            endif
        endif
    else
        # One request per Play. Recovery keeps running, but harvest and repeat Recall stay paused.
        # Only an actual refusal gets a result notice. Silence or elapsed time does not prove arrival.
        if insysmsg "Magical travel is not allowed in this location." or insysmsg "Magical travel from inside a dungeon is only possible near golden moongates." or insysmsg "You do not have access to travel inside this house."
            overhead "[ recall, blocked ]" 254
        endif
    endif

    # A latched Recall keeps the cast window and stops gathering until the script restarts.
    # Gathering also waits for a required book and, when detection is on and the character has
    # Tracking, for the hunt.
    @setvar! var__hold_gathering 0
    if var__recall_needed = 1
        @setvar! var__hold_casts 1
        @setvar! var__hold_gathering 1
    elseif config__require_runebook = 1 and var__recall_book_available = 0
        @setvar! var__hold_gathering 1
    elseif config__recall_on_detection = 1 and var__tracking_hunting_active = 0 and skill "Tracking" > 0
        @setvar! var__hold_gathering 1
    endif

    # ------------------------------------------------------------------------------------
    # REAGENTS                                                module/magery/reagents.razor
    #
    # On the interval, or at once after a refusal for reagents, so a stale flag cannot
    # send the same doomed cast every pass. Each reagent is looked up once, and every
    # spell flag comes from those seven with plain comparisons.
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1
        if timer "timer__reagents" >= interval__reagents or insysmsg "More reagents are needed"
            settimer "timer__reagents" 0

            @setvar! var__has_black_pearl 0
            @setvar! var__has_garlic 0
            @setvar! var__has_ginseng 0
            @setvar! var__has_mandrake 0
            @setvar! var__has_nightshade 0
            @setvar! var__has_ash 0
            @setvar! var__has_silk 0

            if findtype 3962 self
                @setvar! var__has_black_pearl 1
            endif
            if findtype 3972 self
                @setvar! var__has_garlic 1
            endif
            if findtype 3973 self
                @setvar! var__has_ginseng 1
            endif
            if findtype 3974 self
                @setvar! var__has_mandrake 1
            endif
            if findtype 3976 self
                @setvar! var__has_nightshade 1
            endif
            if findtype 3980 self
                @setvar! var__has_ash 1
            endif
            if findtype 3981 self
                @setvar! var__has_silk 1
            endif

            @setvar! var__regs_cure 0
            @setvar! var__regs_heal 0
            @setvar! var__regs_greater_heal 0
            @setvar! var__regs_create_food 0
            @setvar! var__regs_reactive_armor 0
            @setvar! var__regs_magic_reflect 0
            @setvar! var__regs_magic_arrow 0
            @setvar! var__regs_harm 0
            @setvar! var__regs_fireball 0
            @setvar! var__regs_lightning 0
            @setvar! var__regs_curse 0
            @setvar! var__regs_mana_drain 0
            @setvar! var__regs_energy_bolt 0

            if var__has_garlic = 1 and var__has_ginseng = 1
                @setvar! var__regs_cure 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_silk = 1
                @setvar! var__regs_heal 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_greater_heal 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1
                @setvar! var__regs_create_food 1
            endif
            if var__has_garlic = 1 and var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_reactive_armor 1
            endif
            if var__has_garlic = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_magic_reflect 1
            endif
            if var__has_ash = 1
                @setvar! var__regs_magic_arrow 1
            endif
            if var__has_nightshade = 1 and var__has_silk = 1
                @setvar! var__regs_harm 1
            endif
            if var__has_black_pearl = 1
                @setvar! var__regs_fireball 1
            endif
            if var__has_mandrake = 1 and var__has_ash = 1
                @setvar! var__regs_lightning 1
            endif
            if var__has_garlic = 1 and var__has_nightshade = 1 and var__has_ash = 1
                @setvar! var__regs_curse 1
            endif
            if var__has_black_pearl = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_mana_drain 1
            endif
            if var__has_black_pearl = 1 and var__has_nightshade = 1
                @setvar! var__regs_energy_bolt 1
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # SMART HARVEST                                      module/gather/lumberjacking.razor
    #
    # Tracking/Recall reads take priority over this lower-priority result message. The
    # profile displays harvest,out. Start the next retry from this response, without
    # blocking recovery.
    # ------------------------------------------------------------------------------------
    if insysmsg "You do not see any harvestable resources nearby"
        @setvar! var__harvest_retry interval__harvest_out_retry
        settimer "timer__harvest" 0
    endif

    # Equip independently of spare weight. var__hold_gathering pauses both equip and harvest.
    if var__hold_gathering = 0 and diffhits < config__heal_hits and not poisoned and not paralyzed and not warmode and timer "timer__harvest" >= var__harvest_retry
        if not hidden and not queued and not casting and not targetexists and cooldown "walk" = 0
            settimer "timer__harvest" 0
            @setvar! var__harvest_retry interval__harvest_retry

            # Follow archive/bard-mace: an empty left hand needs equipment, regardless of type-search results.
            if lhandempty
                if not find var__my_hatchet backpack
                    @setvar! var__my_hatchet 0
                    if findtype 3907|3908 backpack as alias__packed_hatchet
                        @setvar! var__my_hatchet alias__packed_hatchet
                    endif
                endif

                if find var__my_hatchet backpack as alias__hatchet_to_equip
                    # lift waits for the held item. Do not infer equipped state from this request.
                    lift alias__hatchet_to_equip
                    drop self lefthand
                    if config__sysmsg = 1
                        sysmsg "Hatchet equip requested: stored serial={{var__my_hatchet}}. Next attempt checks lefthand." 88
                    endif
                    wait wait__equip
                elseif timer "timer__message" >= interval__message
                    overhead "[ hatchet, out ]" 254
                    settimer "timer__message" 0
                endif
            elseif findlayer self lefthand as alias__equipped_hatchet
                # Adopt an already held Hatchet once, including replacement tools with a new serial.
                if var__my_hatchet != alias__equipped_hatchet
                    getlabel alias__equipped_hatchet label__hand_tool
                    if "hatchet" in label__hand_tool or "Hatchet" in label__hand_tool
                        @setvar! var__my_hatchet alias__equipped_hatchet
                    elseif not hidden and not queued and not casting and not targetexists and not warmode
                        # Clear only a different left-hand tool. The next attempt equips our Hatchet.
                        lift alias__equipped_hatchet
                        drop backpack
                        wait wait__short
                    endif
                endif

                # A slot-to-serial match proves this selected tool is actually in lefthand.
                # Recheck input after tool discovery. Do not add a separate ready state.
                if var__my_hatchet != alias__equipped_hatchet or diffweight <= 0 or hidden or queued or casting or targetexists or warmode
                    # The hand, spare weight or player input is not ready for harvesting.
                else
                    hotkey "Use item in hand"
                    waitfortarget wait__harvest_target

                    # The tool queue can still be pending. A neutral cursor is ready to answer.
                    if targetexists "neutral" and not hidden and not casting and not warmode
                        target self
                        wait wait__short
                    endif
                    settimer "timer__harvest" 0
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # SELF BUFFS                                                  module/buff/spells.razor
    #
    # Reactive Armor, then Magic Reflection, whenever one is missing and the window is
    # free. Not started at config__buff_max_loss, and cut there mid cast so the next pass
    # can heal. With config__buff_when_poisoned 0 poison holds them back and cuts them
    # too, so the cure goes first. var__hold_casts lets another block keep the cast window
    # (a latched Recall). config__walk_guard and config__warmode_is_manual apply as for
    # the heal agents. The reflect bar is the server's recast lock after Reflect is used
    # up.
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1 and var__hold_casts = 0 and not paralyzed and not hidden and not queued and not casting and not targetexists and diffhits < config__buff_max_loss
        if config__buff_when_poisoned = 1 or not poisoned
            if config__warmode_is_manual = 0 or not warmode
                if config__walk_guard = 0 or cooldown "walk" = 0
                    if config__use_reactive_armor = 1 and var__regs_reactive_armor = 1 and mana >= config__mana_reactive_armor and not findbuff "Reactive Armor"
                        cast "Reactive Armor"
                        @setvar! var__buff_cast 1
                        if config__sysmsg = 1
                            sysmsg "Buff: Reactive Armor." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif
                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif
                            wait wait__poll
                        endfor
                    elseif config__use_magic_reflect = 1 and var__regs_magic_reflect = 1 and mana >= config__mana_magic_reflect and cooldown "reflect" = 0 and not findbuff "Magic Reflection"
                        cast "Magic Reflection"
                        @setvar! var__buff_cast 1
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Reflection." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif
                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif
                            wait wait__poll
                        endfor
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # FOOD                                                          module/buff/food.razor
    #
    # Looked at once a minute. The buff lasts far longer. With config__warmode_is_manual 1
    # it stands down in warmode, as our casts do.
    # ------------------------------------------------------------------------------------
    if timer "timer__food" >= interval__food and not findbuff "Food Satisfaction"
        if config__warmode_is_manual = 0 or not warmode
            if not hidden and not queued and not casting and not targetexists
                settimer "timer__food" 0
                if findtype tray backpack as alias__food
                    dclick alias__food
                    wait wait__short
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # LUMBER                                                      module/pack/lumber.razor
    #
    # Try each selected stack once, with no snapshots or foreach iterator. Bound scans by
    # the existing timer. A failed conversion/drop waits for the next interval.
    # ------------------------------------------------------------------------------------
    if var__hold_gathering = 0 and timer "timer__pack_lumber" >= interval__pack_lumber
        if diffhits < config__light_hits and not poisoned and not paralyzed and not warmode
            if not hidden and not queued and not casting and not targetexists
                settimer "timer__pack_lumber" 0
                if find global__my_looting_pouch backpack
                    if config__sysmsg = 1
                        sysmsg "Lumber pack BEGIN: convert Logs, then move Boards." 88
                    endif
                    dclick global__my_looting_pouch
                    wait wait__lumber_item

                    # Two phases share one body: Logs first, then current Boards.
                    # Both scans end by their conditions. Each phase has its own time budget.
                    # Do not reuse pre-conversion serials after conversion or stack merging.
                    for 2
                        if index = 0
                            @setvar! var__lumber_graphic 7133
                        else
                            @setvar! var__lumber_graphic 7127
                        endif
                        settimer "timer__pack_lumber" 0
                        @clearignore

                        # End loops by their conditions. No break skips an if scope or resets the outer for.
                        # Settle the pouch/previous-phase queue within this phase's existing budget.
                        while queued and timer "timer__pack_lumber" < wait__lumber_batch and not dead and not pvp and diffhits < config__light_hits and not poisoned and not paralyzed and not warmode and not hidden and not casting and not targetexists
                            wait wait__poll
                        endwhile

                        # No hue filter. Search current inventory after each conversion or move.
                        # The timer advances even when ignore cannot advance a failed/packed stack.
                        while timer "timer__pack_lumber" < wait__lumber_batch and not queued and not dead and not pvp and diffhits < config__light_hits and not poisoned and not paralyzed and not warmode and not hidden and not casting and not targetexists and find global__my_looting_pouch backpack and findtype var__lumber_graphic backpack as alias__lumber_stack
                            if var__lumber_graphic = 7133
                                if config__sysmsg = 1
                                    sysmsg "Lumber convert: serial={{alias__lumber_stack}}." 88
                                endif
                                dclick alias__lumber_stack
                                wait wait__lumber_item
                            elseif find alias__lumber_stack global__my_looting_pouch
                                # Recursive backpack searches can return Boards already in the pouch.
                                if config__sysmsg = 1
                                    sysmsg "Lumber skip: serial={{alias__lumber_stack}}, already in pouch." 88
                                endif
                            elseif find global__my_looting_pouch backpack
                                if config__sysmsg = 1
                                    sysmsg "Lumber move request: serial={{alias__lumber_stack}}, pouch={{global__my_looting_pouch}}." 88
                                endif
                                # Complete lift/drop together. Do not leave the item held during a wait.
                                lift alias__lumber_stack 60000
                                drop global__my_looting_pouch -1 -1
                                wait wait__lumber_item
                            endif
                            # Check container membership before ignore, which can hide it from find.
                            # Skip this selected serial only for this phase, including failed requests.
                            @ignore alias__lumber_stack

                            # A pending item queue pauses the next search, without leaving its loop scope.
                            while queued and timer "timer__pack_lumber" < wait__lumber_batch and not dead and not pvp and diffhits < config__light_hits and not poisoned and not paralyzed and not warmode and not hidden and not casting and not targetexists
                                wait wait__poll
                            endwhile
                        endwhile
                        @clearignore
                    endfor
                    if config__sysmsg = 1
                        sysmsg "Lumber pack END: returning to recovery and harvest checks." 88
                        if queued
                            sysmsg "Lumber pack: item queue still active. Harvest waits for queued=0." 88
                        endif
                        if targetexists
                            sysmsg "Lumber pack: target cursor active. Harvest leaves it to the player." 88
                        endif
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ loot pouch, out ]" 254
                    settimer "timer__message" 0
                endif
                # The next interval starts after this batch, including a missing-pouch attempt.
                settimer "timer__pack_lumber" 0
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # END OF PASS                                                        module/base.razor
    # ------------------------------------------------------------------------------------
    wait wait__poll
endwhile
