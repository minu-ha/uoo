        endif

        # Detection is read before weight. No more inventory scans after sending Recall.
        if var__recall_sent = 0 and timer "timer__recall_scan" >= cooldown__recall_scan
            if config__recall_on_weight = 1 and var__recall_needed = 0
                if diffweight <= config__weight_remaining
                    @setvar! var__recall_needed 1
                    if timer "timer__message" >= cooldown__message
                        overhead "[ weight, low ]" 53
                        settimer "timer__message" 0
                    endif
                endif
            endif

            settimer "timer__recall_scan" 0
        endif

        # A single attempt per run. Neither silence nor a timed notice proves arrival.
        if var__recall_sent = 1
            if insysmsg "Magical travel is not allowed in this location." or insysmsg "Magical travel from inside a dungeon is only possible near golden moongates."
                @setvar! var__recall_notice_shown 1
                overhead "[ recall, blocked ]" 53
            elseif var__recall_notice_shown = 0 and timer "timer__recall" >= cooldown__recall_response
                @setvar! var__recall_notice_shown 1
                overhead "[ recall, check ]" 55
            endif

        elseif var__recall_needed = 1
            # Do not block on a Heat of Battle buff here. The server decides whether Recall is allowed.
            # This path performs no combat preparation and drinks no Strength or Agility potion.
            if mana >= config__mana_recall and not paralyzed and not warmode
                if not hidden and not queued and not casting and not targetexists and cooldown "walk" = 0
                    if var__recall_book_available = 1
                        if findtype "runebook" backpack or findtype "runetome" backpack
                            # Change Home here to your rune name. This command casts Recall, not Gate Travel.
                            say "[RecallCharge Home"
                            @setvar! var__recall_sent 1
                            settimer "timer__recall" 0

                            if config__chatty = 1
                                overhead "[ recall, on ]" 90
                            endif

                            wait wait__short
                        elseif timer "timer__message" >= cooldown__message
                            overhead "[ runebook, out ]" 53
                            settimer "timer__message" 0
                        endif
                    elseif timer "timer__message" >= cooldown__message
                        overhead "[ runebook, out ]" 53
                        settimer "timer__message" 0
                    endif
                endif
            elseif mana < config__mana_recall and timer "timer__message" >= cooldown__message
                overhead "[ mana, low ]" 53
                settimer "timer__message" 0
            endif
        endif
    endif

    # A matching message may consume older events. Read shortages after Tracking.
    # Housekeeping schedules the next refresh instead of polling this every pass.
    if var__housekeeping_pass = 1
        if insysmsg "More reagents are needed"
            settimer "timer__reagents" cooldown__reagents
        endif
    endif

    wait wait__poll
