clearall
clearsysmsg
cleardragdrop
clearignore

@setvar! wait__short 300
@setvar! wait__target 2000

// ####################################################################################
// # CONFIG
// ####################################################################################
// 1 when the stockpile, safe, bench, shelf and recycler are stored inside one furniture
// container. 0 when they stand on the floor. Either way they must be within reach.
@setvar! config__use_furniture_container 1

// Magic instrument pickup. 1 carries one out of the supply box.
@setvar! config__use_magic_instrument 1

// Everything a hand can touch is 2 tiles away at most, so that is the range every check uses.
@setvar! config__reach 2

// ####################################################################################
// # CONTAINERS YOU WALK UP TO
// ####################################################################################
// Personal containers, kept in your Razor profile so no serial sits in this shared file.
//
// varexist only reports that a name was declared, not that the serial still resolves, so a
// container targeted by mistake would stay wrong forever. These sit on the floor, so find
// can check them for real: a serial that no longer resolves within reach is dropped and
// asked for again.
//
// Asked for before the dclick below, because you can target something you can see.
if config__use_furniture_container = 1
    if not varexist global__my_furniture_container or not find global__my_furniture_container ground -1 -1 config__reach
        unsetvar global__my_furniture_container
        overhead "Target the furniture the containers sit in" 55
        setvar global__my_furniture_container
    endif
endif

if not varexist global__my_supply_box or not find global__my_supply_box ground -1 -1 config__reach
    unsetvar global__my_supply_box
    overhead "Target the supply box that holds tools and instruments" 55
    setvar global__my_supply_box
endif

if not varexist global__my_recall_scroll_container or not find global__my_recall_scroll_container ground -1 -1 config__reach
    unsetvar global__my_recall_scroll_container
    overhead "Target the recall scroll container" 55
    setvar global__my_recall_scroll_container
endif

setvar global__my_recall_scroll 0

while queued
    wait wait__short
endwhile


// A container has to be open before anything can be taken from or put into it.
if config__use_furniture_container = 1
    dclick global__my_furniture_container
    wait wait__short
endif

dclick global__my_recall_scroll_container
wait wait__short
dclick global__my_supply_box
wait wait__short


