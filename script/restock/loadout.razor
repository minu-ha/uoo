// ####################################################################################
// # Refill runebook
// ####################################################################################
clearsysmsg
cleardragdrop
clearignore
if findtype 8012 var_my_recall_scroll_container as found_recall_scroll
    setvar! var_my_recall_scroll found_recall_scroll
    wait var_global_waiting_time
endif

if var_my_recall_scroll = 0
    overhead "out of recall scroll" 34
    stop
endif

// Backpack
while findtype "runetome|runebook" backpack as found_runetome
    getlabel var_my_recall_scroll found_runetome_description
    overhead found_runetome_description 88

    lift var_my_recall_scroll 6000
    if insysmsg 'not found or out of range'
        overhead "out of recall scroll" 34
        stop
    endif

    drop found_runetome
    @ignore found_runetome
endwhile

// Nearby tomes
while findtype "runetome|runebook" ground -1 -1 2 as found_runetome
    getlabel var_my_recall_scroll found_runetome_description
    overhead found_runetome_description 88

    lift var_my_recall_scroll 6000
    if insysmsg 'not found or out of range'
        overhead "out of recall scroll" 34
        stop
    endif

    drop found_runetome
    @ignore found_runetome
endwhile

# Nearby chests
while findtype 47202|62764|2473|3710|41451|41452|3646|3647|3644|3645|41449|41450|29832|29833|2472|29077|29078|2475|3648|3649|3708|3650|3651|41453|41454|2474|3709|3650|3651|41455|41456|29086|29087 true as found_container
