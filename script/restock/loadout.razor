        getlabel var_my_recall_scroll found_runetome_description
        overhead found_runetome_description 88

        lift var_my_recall_scroll 60000
        if insysmsg 'not found or out of range'
            overhead "out of recall scroll" 34
            stop
        endif

        drop found_runetome
        @ignore found_runetome
    endwhile

    @ignore found_container
endwhile

