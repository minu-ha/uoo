# ----------------------------------------------------------------------------------------
# module/restock/runebook.razor
# ----------------------------------------------------------------------------------------
if config__use_runebook_refill = 1
    if not varexist global__my_recall_scroll_container or not find global__my_recall_scroll_container ground -1 -1 config__reach
        unsetvar global__my_recall_scroll_container
        overhead "[ scroll box, pick ]" 255
        setvar global__my_recall_scroll_container
    endif

    setvar global__my_recall_scroll 0

    dclick global__my_recall_scroll_container
    wait wait__short

    clearsysmsg
    cleardragdrop
    clearignore

    for 10
        if findtype 8012 global__my_recall_scroll_container as alias__found_recall_scroll
            setvar! global__my_recall_scroll alias__found_recall_scroll
            break
        endif

        wait wait__short
    endfor

    if global__my_recall_scroll = 0
        overhead "[ recall scroll, out ]" 254
        @setvar! var__runebook_scrolls_out 1
    endif

    while var__runebook_scrolls_out = 0 and findtype "runetome|runebook" backpack as alias__found_runetome
        getlabel alias__found_runetome label__found_runetome
        overhead "[ scroll, {{label__found_runetome}} ]" 290

        lift global__my_recall_scroll 6000
        if insysmsg 'not found or out of range'
            overhead "[ recall scroll, out ]" 254
            @setvar! var__runebook_scrolls_out 1
        else
            drop alias__found_runetome
        endif

        @ignore alias__found_runetome
    endwhile

    while var__runebook_scrolls_out = 0 and findtype "runetome|runebook" ground -1 -1 2 as alias__found_runetome
        getlabel alias__found_runetome label__found_runetome
        overhead "[ scroll, {{label__found_runetome}} ]" 290

        lift global__my_recall_scroll 6000
        if insysmsg 'not found or out of range'
            overhead "[ recall scroll, out ]" 254
            @setvar! var__runebook_scrolls_out 1
        else
            drop alias__found_runetome
        endif

        @ignore alias__found_runetome
    endwhile

    while var__runebook_scrolls_out = 0 and findtype 47202|62764|2473|3710|41451|41452|3646|3647|3644|3645|41449|41450|29832|29833|2472|29077|29078|2475|3648|3649|3708|3650|3651|41453|41454|2474|3709|3650|3651|41455|41456|29086|29087 true as alias__found_container
        while var__runebook_scrolls_out = 0 and findtype "runetome|runebook" alias__found_container as alias__found_runetome
            getlabel alias__found_runetome label__found_runetome
            overhead "[ scroll, {{label__found_runetome}} ]" 290

            lift global__my_recall_scroll 60000
            if insysmsg 'not found or out of range'
                overhead "[ recall scroll, out ]" 254
                @setvar! var__runebook_scrolls_out 1
            else
                drop alias__found_runetome
            endif

            @ignore alias__found_runetome
        endwhile

        @ignore alias__found_container
    endwhile

    cleardragdrop
    clearignore
endif


