clearall
clearsysmsg
cleardragdrop
clearignore

setvar var_global_waiting_time 300
setvar var_global_waiting_target_time 2000

setvar var_my_barrel_container "0x450581D2"
setvar var_my_recall_scroll_container "0x45147618"
setvar var_my_furniture_container "0x488AC23E"
setvar var_my_wand_container "0x45147DD7"
setvar var_my_resource_stockpile "0x49C8351F"
setvar var_my_magic_item_recycler "0x462490DB"
setvar var_my_repair_bench "0x439B7713"
setvar var_my_storage_shelf "0x41FCEC56"
setvar var_my_bank_deposit_safe "0x4625F87C"
setvar var_my_wizard_satchel "0x49F2F20C"
setvar var_my_recall_scroll 0

setvar var_use_magic_instrument_item 0

while queued
    wait var_global_waiting_time
endwhile


dclick var_my_barrel_container
wait var_global_waiting_time
dclick var_my_furniture_container
wait var_global_waiting_time
dclick var_my_recall_scroll_container
wait var_global_waiting_time
dclick var_my_wand_container
wait var_global_waiting_time


// ####################################################################################
// # AGENT
// ####################################################################################
if find var_my_wand_container ground -1 -1 2
    if not findtype 3997 backpack or not findtype 20496 backpack
        restock 10
        waitfortarget var_global_waiting_target_time
        if targetexists
            target var_my_wand_container
        endif
    endif
endif

// ####################################################################################
// # Bank Deposit safe
// ####################################################################################
if find var_my_bank_deposit_safe var_my_furniture_container and findtype 3821 backpack
    overhead "Bank Deposit safe" 82
    menu 0x4625F87C 0
    wait var_global_waiting_time
endif

// ####################################################################################
// # Resource stockpile
// ####################################################################################
if find var_my_resource_stockpile var_my_furniture_container
    overhead "Resource stockpile" 82
    menu var_my_resource_stockpile 0
    waitfortarget var_global_waiting_target_time
    target self
    wait var_global_waiting_time
endif

// ####################################################################################
// # Repair bench
// ####################################################################################
if find var_my_repair_bench var_my_furniture_container
    dclick var_my_repair_bench
    wait 2000

    if insysmsg "You do not have any items equipped or in your backpack in need of repairs."
        overhead "Pass repair bench" 82
    else
        overhead "Repair bench" 82
        waitforsysmsg "Repaired"
    endif
endif

// ####################################################################################
// # Storage shelf
// ####################################################################################
if find var_my_storage_shelf var_my_furniture_container
    overhead "Storage shelf" 82
    menu var_my_storage_shelf 0
    waitfortarget var_global_waiting_target_time
    target self
    wait var_global_waiting_time
    gumpclose
    menu var_my_storage_shelf 1
    wait var_global_waiting_time
endif

// ####################################################################################
// # Magic item recycler
// ####################################################################################
if find var_my_magic_item_recycler var_my_furniture_container
    overhead "Magic item recycler" 82
    menu var_my_magic_item_recycler 0
endif

// ####################################################################################
// # Looting bag
// ####################################################################################
if not varexist var_my_looting_pouch
    overhead "Set looting pouch" 88
    wait var_global_waiting_time

    if findtype 3705 backpack 0 as found_pouch
        setvar var_my_looting_pouch found_pouch
    else
        setvar var_my_looting_pouch
    endif
else
    if not find var_my_looting_pouch backpack
        wait var_global_waiting_time
        overhead "Looting pouch not found."

        if findtype 3705 backpack 0 as found_pouch
            setvar var_my_looting_pouch found_pouch
        else
            setvar var_my_looting_pouch
        endif
    endif
endif

// ####################################################################################
// # INSTRUMENT
// ####################################################################################
#Instruments - all serials: 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016
    #bamboo flute "bamboo flute" 10245
    #drums "drum" 3740
    #gemshorn "gemshorn" 20006
    #harp "lap harp" 3762
    #hurdy-gurdy "hurdy gurdy" 20008
    #lute "lute" 3763
    #psaltery "psaltery" 20010
    #sackbut "sackbut" 20012
    #shawm "shawm" 20014
    #tambourine "tambourine" 3742
    #Vielle "vielle" 20016
if var_use_magic_instrument_item = 1
    while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 var_my_magic_item_recycler as found_instrument
        getlabel found_instrument found_instrument_description
        overhead found_instrument_description 88

        if "supremely" in found_instrument_description
            if find found_instrument var_my_magic_item_recycler
                lift found_instrument
                wait var_global_waiting_time
                drop backpack 0 0 50
                wait var_global_waiting_time
            endif
            break
        endif

        @ignore found_instrument
    endwhile

    clearignore
endif


// ####################################################################################
// # Soritng items
// ####################################################################################
clearall
clearsysmsg
cleardragdrop
clearignore
#bandage "clean bandage%s%" 3617
#adventure pack "adventure pack" 2726
#dagger "dagger" 3922
#pouch "pouch" 3705
#scissors "scissors" 3998|3999
#kindling "kindling" 3553
#skinning knife "Elven Spellblade" 11552|11564
#smoke bomb "bombs" 52149
#adventurers rope "rope" 5370 (Hue 2799)
#Delectable food 28879|28880|28881|28883|28885|28886|28888|29773|29774
#potion satchel "alchemists satchel" 31262
#item identification wand "wand" 20496
#magic mushroom "mushroom" 29012

removelist sorting_item_list
createlist sorting_item_list

while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016|20496|3922|3617|2726|3998|3999|3553|11552|11564|52149|5370|28879|28880|28881|28883|28885|28886|28888|29773|29774|29012 backpack as found_item
    getlabel found_item found_item_description
    pushlist sorting_item_list found_item
    @ignore found_item
endwhile

clearsysmsg
cleardragdrop
clearignore

wait var_global_waiting_time

foreach sorting_item in sorting_item_list
    getlabel sorting_item sorting_item_description
    overhead sorting_item_description 11

    if "item identification wand" in sorting_item_description
        lift sorting_item 1000
        wait var_global_waiting_time
        drop var_my_looting_pouch 150 0
        wait var_global_waiting_time
    elseif "supremely" in sorting_item_description or "lute" in sorting_item_description
        lift sorting_item 1000
        wait var_global_waiting_time
        drop var_my_looting_pouch 130 0
        wait var_global_waiting_time
    else
        lift sorting_item 1000
        wait var_global_waiting_time
        drop var_my_looting_pouch 0 0 0
        wait var_global_waiting_time
    endif

    @ignore sorting_item
endfor

while findtype 3705 backpack 0 as found_pouch
    lift found_pouch
    drop backpack 0 0 0
    ignore found_pouch
    wait var_global_waiting_time
    dclick found_pouch
endwhile

while findtype 3705 backpack 38 as found_trap_pouch
    lift found_trap_pouch
    drop backpack 0 0 0
    ignore found_trap_pouch
    wait var_global_waiting_time
endwhile

if findtype 30765 backpack as found_reagent_satchel
    lift found_reagent_satchel
    wait var_global_waiting_time
    drop var_my_looting_pouch 150 140
    wait var_global_waiting_time
    dclick found_reagent_satchel
endif

if findtype 31262 backpack as found_alchemists_satchel
    lift found_alchemists_satchel
    wait var_global_waiting_time
    drop var_my_looting_pouch 130 140
    wait var_global_waiting_time
    dclick found_alchemists_satchel
endif

