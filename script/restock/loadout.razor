// ####################################################################################
// # Bank Deposit safe
// ####################################################################################
// Every one of these blocks waits with waitfortarget, never with a plain wait. A fixed sleep
// is not long enough for the server to answer: the cursor turns up after the block has moved
// on, and then the next block's waitfortarget picks up that stale cursor instead of its own.
// That is what kept breaking the storage shelf restock.
//
// One rule, applied everywhere: a block clears up after itself. It answers its own cursor and
// closes its own gump before it ends, so the block after it does not have to defend against
// anything. That is why none of these start with a cancel or a gumpclose.
if var__has_bank_deposit_safe = 1 and findtype 3821 backpack
    overhead "Bank Deposit safe" 82
    menu global__my_bank_deposit_safe 0
    waitfortarget wait__target

    if targetexists
        target backpack
    endif

    if targetexists
        hotkey "Cancel Current Target"
    endif

    wait wait__short
endif

// ####################################################################################
// # Resource stockpile
// ####################################################################################
// This is the block that was leaking a cursor. Its prompt,
//   "Where do you wish to restock this from? You may target yourself, a container, ..."
// was still up when the storage shelf asked its own question, so the shelf's answer went to
// this one and the shelf restock never ran. target self was already here, but it does not
// always take, and the block had nothing to clean up after itself.
if var__has_resource_stockpile = 1
    overhead "Resource stockpile" 82
    menu global__my_resource_stockpile 0
    waitfortarget wait__target

    if targetexists
        target self
    endif

    if targetexists
        hotkey "Cancel Current Target"
    endif

    wait wait__short
endif

// ####################################################################################
// # Repair bench
// ####################################################################################
if var__has_repair_bench = 1
    dclick global__my_repair_bench
    wait wait__repair

    if insysmsg "You do not have any items equipped or in your backpack in need of repairs."
        overhead "Pass repair bench" 82
    else
        overhead "Repair bench" 82
        waitforsysmsg "Repaired"
    endif
endif

// ####################################################################################
// # Magic item recycler
// ####################################################################################
// The recycler takes no target. It acts on the backpack straight away.
//
//   0  everything in the backpack
//   1  unidentified items only
//
// 1 is the default on purpose. 0 also swallows the magic instrument and any identified gear
// you came home with, and the instrument section further down would then pull a replacement
// out of the supply box every run. 1 takes the loot you have not looked at yet and leaves
// your kit alone.
//
// If this prompts for a target, the variable is pointing at the Magic Item Vault instead of
// the recycler. Run  unsetvar global__my_magic_item_recycler  and rerun to retarget it.
@setvar! config__recycle_unidentified_only 1

if var__has_magic_item_recycler = 1
    overhead "Magic item recycler" 82

    if config__recycle_unidentified_only = 1
        menu global__my_magic_item_recycler 1
    else
        menu global__my_magic_item_recycler 0
    endif

    wait wait__short
endif

// ####################################################################################
// # Storage shelf restock
// ####################################################################################
// Restock puts things in, Resupply takes things out. Two menu entries, 0 and 1, and both are
// needed: crafted gear and anything looted goes into the shelf before the loadout comes back
// out. Restock belongs here with the deposits, Resupply runs later with the withdrawals.
//
// Restock asks what to take from and self is the answer. The two targetexists checks are not
// the same test: the first answers the prompt, the second catches an answer that was refused
// and left the cursor up. Nothing cancels before the menu, because every block above already
// clears up after itself.
//
// No waitforgump. Restock reports "N items were added" without the shelf gump necessarily
// opening, so waiting on that gump ended the run right here. The gumpclose at the end covers
// the times it does open.
if var__has_storage_shelf = 1
    overhead "Storage shelf restock" 82
    menu global__my_storage_shelf 0
    waitfortarget wait__target

    if targetexists
        target self
    endif

    if targetexists
        hotkey "Cancel Current Target"
    endif

    wait wait__long
    gumpclose
endif

// ####################################################################################
// # Storage shelf resupply
// ####################################################################################
// The withdrawal half, and the short one: resupply raises no cursor and answers at once.
// It used to wait on a target anyway, on the theory that the wait kept the restock above from
// colliding with it. That was wrong. The run was dying on an undeclared wait__long, and the
// context menu left on screen was the symptom, not the cause.
if var__has_storage_shelf = 1
    overhead "Storage shelf resupply" 82
    menu global__my_storage_shelf 1
    wait wait__short
    gumpclose
endif

// ####################################################################################
// # TOOLS
// ####################################################################################
// 3997 sewing kit, 20496 item identification wand. Both live in the supply box.
//
// Exactly one of each is carried. The backpack is walked first: the first one found stays,
// every further copy goes back to the supply box. Only if none was carried is one fetched.
// Runs kept stacking duplicates before, because the old check stopped at the first hit and
// never looked at what else was already in the bag.
//
// Extras go to the supply box rather than the shelf because the shelf restock already ran,
// back with the deposits. Anything left in the bag from here on stays in the bag, so this
// pass has to put it somewhere itself.
//
// This also replaced the Restock 10 agent, which only carried the sewing kit, so the
// identification wand was checked for and then never actually fetched.
if find global__my_supply_box ground -1 -1 config__reach
    @setvar! var__kept_sewing_kit 0

    while findtype 3997 backpack as alias__found_sewing_kit
        if var__kept_sewing_kit = 0
            @setvar! var__kept_sewing_kit 1
        else
            lift alias__found_sewing_kit 1
            wait wait__short
            drop global__my_supply_box
            wait wait__short
        endif

        @ignore alias__found_sewing_kit
    endwhile

    clearignore

    if var__kept_sewing_kit = 0
        if findtype 3997 global__my_supply_box as alias__found_sewing_kit
            lift alias__found_sewing_kit 1
            wait wait__short
            drop backpack
            wait wait__short
        else
            overhead "No sewing kit in the supply box." 33
        endif
    endif

    @setvar! var__kept_identification_wand 0

    while findtype 20496 backpack as alias__found_identification_wand
        if var__kept_identification_wand = 0
            @setvar! var__kept_identification_wand 1
        else
            lift alias__found_identification_wand 1
            wait wait__short
            drop global__my_supply_box
            wait wait__short
        endif

        @ignore alias__found_identification_wand
    endwhile

    clearignore

    if var__kept_identification_wand = 0
        if findtype 20496 global__my_supply_box as alias__found_identification_wand
            lift alias__found_identification_wand 1
            wait wait__short
            drop backpack
            wait wait__short
        else
            overhead "No identification wand in the supply box." 33
        endif
    endif
endif

// ####################################################################################
// # INSTRUMENT
// ####################################################################################
//   #instruments   3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016
//   #bamboo flute 10245   #drums 3740       #gemshorn 20006   #harp 3762
//   #hurdy-gurdy 20008    #lute 3763        #psaltery 20010   #sackbut 20012
//   #shawm 20014          #tambourine 3742  #vielle 20016
//
// Only magic instruments are handled here. A crafted one belongs to the storage shelf: the
// restock above puts it away and the resupply brings it back, so this section leaves every
// crafted instrument exactly where it is and only counts the magic ones.
//
// Exactly one magic instrument is carried. The first one found stays, any further copy goes
// back to the supply box, and only if none was carried is one fetched. The combat scripts
// match the same two label words when they pick what to equip.
if config__use_magic_instrument = 1
    @setvar! var__kept_instrument 0

    while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as alias__found_instrument
        getlabel alias__found_instrument label__found_instrument

        if "supremely" in label__found_instrument or "exceedingly" in label__found_instrument
            if var__kept_instrument = 0
                @setvar! var__kept_instrument 1
            else
                lift alias__found_instrument 1
                wait wait__short
                drop global__my_supply_box
                wait wait__short
            endif
        endif

        @ignore alias__found_instrument
    endwhile

    clearignore

    if var__kept_instrument = 0
        while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 global__my_supply_box as alias__found_instrument
            getlabel alias__found_instrument label__found_instrument

            if "supremely" in label__found_instrument or "exceedingly" in label__found_instrument
                lift alias__found_instrument 1
                wait wait__short
                drop backpack
                wait wait__short
                @setvar! var__kept_instrument 1
                break
            endif

            @ignore alias__found_instrument
        endwhile

        clearignore

        if var__kept_instrument = 0
            overhead "No magic instrument in the supply box." 33
        endif
    endif
endif

// ####################################################################################
// # Looting bag
// ####################################################################################
if not varexist global__my_looting_pouch
    overhead "Set looting pouch" 88
    wait wait__short

    if findtype 3705 backpack 0 as alias__found_pouch
        setvar global__my_looting_pouch alias__found_pouch
    else
        setvar global__my_looting_pouch
    endif
else
    if not find global__my_looting_pouch backpack
        wait wait__short
        overhead "Looting pouch not found."

        if findtype 3705 backpack 0 as alias__found_pouch
            setvar global__my_looting_pouch alias__found_pouch
        else
            setvar global__my_looting_pouch
        endif
    endif
endif

// ####################################################################################
// # Sorting items
// ####################################################################################
// Everything the backpack should hold, and where it goes. Format matches library/item-list.razor.
//
//   #bandage                 "clean bandage%s%"      3617
//   #adventure pack          "adventure pack"        2726
//   #dagger                  "dagger"                3922
//   #pouch                   "pouch"                 3705   (hue 0 plain, hue 38 trapped)
//   #scissors                "scissors"              3998|3999
//   #kindling                "kindling"              3553
//   #skinning knife          "Elven Spellblade"      11552|11564
//   #smoke bomb              "bombs"                 52149
//   #adventurers rope        "rope"                  5370   (hue 2799)
//   #delectable food                                 28879|28880|28881|28883|28885|28886|28888|29773|29774
//   #magic mushroom          "mushroom"              29012
//   #sewing kit              "sewing kit"            3997
//   #item identification wand "wand"                 20496
//   #instruments                                     3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016
//   #reagent satchel         "reagent satchel"       30765
//   #potion satchel          "alchemists satchel"    31262
//
// Placement. drop takes literal coordinates, so the numbers are inline, but they only appear
// in this section. They are gump pixels, not grid cells, so nudge them if items overlap.
//
//   backpack 140 110      the pouches
//   pouch    0 0          everything not named below
//   pouch    130 0        identification wand, sewing kit
//   pouch    130 80       the instrument
//   pouch    0 80         the two satchels
//
// Order matters. Moving a pouch closes it, and a closed container does not report what is
// inside: the counters for the cure and heal potions in there read zero until it is opened
// again, and a combat script that believes it has no cure potion will not drink one. Leaving
// the contents loose in the backpack would count fine and lose them to the first thief, so
// the pouches move first, get reopened, and only then does anything get sorted into them.
cleardragdrop
clearignore

// 1. the plain pouch, moved and reopened
while findtype 3705 backpack 0 as alias__found_pouch
    lift alias__found_pouch
    wait wait__short
    drop backpack 140 110
    wait wait__short
    dclick alias__found_pouch
    wait wait__short
    @ignore alias__found_pouch
endwhile

clearignore

// 2. the trapped pouch. Not reopened on purpose, nothing reads inside it.
while findtype 3705 backpack 38 as alias__found_trap_pouch
    lift alias__found_trap_pouch
    wait wait__short
    drop backpack 140 110
    wait wait__short
    @ignore alias__found_trap_pouch
endwhile

clearignore

// 3. the satchels, into the now open pouch. Reopened for the same counting reason.
if findtype 30765 backpack as alias__found_reagent_satchel
    lift alias__found_reagent_satchel
    wait wait__short
    drop global__my_looting_pouch 0 80
    wait wait__short
    dclick alias__found_reagent_satchel
    wait wait__short
endif

if findtype 31262 backpack as alias__found_alchemists_satchel
    lift alias__found_alchemists_satchel
    wait wait__short
    drop global__my_looting_pouch 0 80
    wait wait__short
    dclick alias__found_alchemists_satchel
    wait wait__short
endif

// 4. everything else. Collected first, because the walk below moves items out of the
//    backpack and a findtype loop cannot be trusted while its own source is changing.
removelist sorting_item_list
createlist sorting_item_list

while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016|20496|3997|3922|3617|2726|3998|3999|3553|11552|11564|52149|5370|28879|28880|28881|28883|28885|28886|28888|29773|29774|29012 backpack as alias__found_item
    pushlist sorting_item_list alias__found_item
    @ignore alias__found_item
endwhile

clearignore

foreach alias__sorting_item in sorting_item_list
    getlabel alias__sorting_item label__sorting_item

    if config__chatty = 1
        overhead label__sorting_item 11
    endif

    lift alias__sorting_item 1000
    wait wait__short

    if "item identification wand" in label__sorting_item or "sewing kit" in label__sorting_item
        drop global__my_looting_pouch 130 0
    elseif "flute" in label__sorting_item or "drum" in label__sorting_item or "harp" in label__sorting_item or "lute" in label__sorting_item or "tambourine" in label__sorting_item or "gemshorn" in label__sorting_item or "hurdy" in label__sorting_item or "psaltery" in label__sorting_item or "sackbut" in label__sorting_item or "shawm" in label__sorting_item or "vielle" in label__sorting_item
        drop global__my_looting_pouch 130 80
    else
        drop global__my_looting_pouch 0 0
    endif

    wait wait__short
endfor

// ####################################################################################
// # Dress setting
// ####################################################################################
// Records what is worn, nothing else. Putting it back on is script/hotkey/dress.razor's job.
//
// One block per layer findlayer accepts, so nothing is addressed by item graphic any more.
// The old version equipped a few items by graphic and sent three of them to the pants layer,
// which only holds one thing: the quiver, the short pipe and the wizard satchel were
// overwriting each other. hair and facialhair are left out, they are not equipment.
//
// @setvar! keeps these for the rest of the Razor session and any script can read them, so
// the dress hotkey sees them later. They are gone after a client restart, which is fine:
// this script runs again before the next trip.
if findlayer self righthand as item
    @setvar! var__right_hand item

    if config__chatty = 1
        getlabel item label__right_hand
        overhead "righthand: {{label__right_hand}}" 88
