    endif
else
    if not varexist global__my_magic_item_recycler or not find global__my_magic_item_recycler ground -1 -1 config__reach
        unsetvar global__my_magic_item_recycler
        overhead "Target the magic item recycler" 55
        setvar global__my_magic_item_recycler
    endif

    if find global__my_magic_item_recycler ground -1 -1 config__reach
