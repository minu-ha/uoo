// ####################################################################################
// # Storage shelf
// ####################################################################################
// One context menu entry, not two. The wiki says Begin Resupply "attempts to equip items and
// stock resources", so it already covers what the other entry was being called for, and
// script/train/magery.razor drives the same shelf with entry 1 alone and no target.
//
// The old version called entry 0 first and answered its cursor with an unguarded target self,
// then called entry 1 and never answered anything it raised. That is where the cursor was
// getting stuck: a target left hanging blocks every lift and drop after it.
//
// If your shelf has resupply on a different entry, change this one number.
@setvar! config__shelf_menu_resupply 1

if var__has_storage_shelf = 1
    overhead "Storage shelf" 82
    menu global__my_storage_shelf config__shelf_menu_resupply
    wait wait__short

    // Answer a cursor only if one actually came up, and close the gump either way.
    waitfortarget wait__target

    if targetexists
        target self
        wait wait__short
    endif

    gumpclose
    wait wait__short
endif

// ####################################################################################
// # TOOLS
// ####################################################################################
// 3997 sewing kit, 20496 item identification wand. Both live in the wand container.
//
// This used to call the Restock 10 agent. The agent only carried the sewing kit, so the
// identification wand was checked for and then never actually fetched. Pulling each item
// by graphic fixes that, and it also keeps the list in the script where it can be read,
// instead of in one player's profile.
if find global__my_supply_box ground -1 -1 2
    if not findtype 3997 backpack
        if findtype 3997 global__my_supply_box as alias__found_sewing_kit
            lift alias__found_sewing_kit 1
            wait wait__short
            drop backpack
            wait wait__short
        else
            overhead "No sewing kit in the wand container." 33
        endif
    endif

    if not findtype 20496 backpack
        if findtype 20496 global__my_supply_box as alias__found_identification_wand
            lift alias__found_identification_wand 1
            wait wait__short
            drop backpack
            wait wait__short
        else
            overhead "No identification wand in the wand container." 33
        endif
    endif
endif

// ####################################################################################
// # INSTRUMENT
// ####################################################################################
#Instruments - all serials: 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016
    #bamboo flute "bamboo flute" 10245
    #drums "drum" 3740
    #gemshorn "gemshorn" 20006
    #harp "lap harp" 3762
    #hurdy-gurdy "hurdy gurdy" 20008
    #lute "lute" 3763
    #psaltery "psaltery" 20010
    #sackbut "sackbut" 20012
    #shawm "shawm" 20014
    #tambourine "tambourine" 3742
    #Vielle "vielle" 20016
// A magic instrument carries more effective barding skill than a crafted one, and any one
// of them will do, so this takes the first that matches and stops. The combat scripts read
// the same two words off the label when they pick what to equip.
//
// Source is the supply box, the same place the tools come from. One is enough: the combat
// scripts reselect from the backpack only when the carried one is gone.
//
// Is one already carried? findtype alone cannot tell a magic instrument from a crafted one,
// so the backpack is walked and the label read, the same two words the combat scripts match.
// Without this the run fetched another one every time, however many were already in the bag.
@setvar! var__has_magic_instrument 0

while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as alias__carried_instrument
    getlabel alias__carried_instrument label__carried_instrument

    if "supremely" in label__carried_instrument or "exceedingly" in label__carried_instrument
        @setvar! var__has_magic_instrument 1
        break
    endif

    @ignore alias__carried_instrument
endwhile

clearignore

if config__use_magic_instrument = 1 and var__has_magic_instrument = 0
    while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 global__my_supply_box as alias__found_instrument
        getlabel alias__found_instrument label__found_instrument

        if "supremely" in label__found_instrument or "exceedingly" in label__found_instrument
            lift alias__found_instrument 1
            wait wait__short
            drop backpack
            wait wait__short
            @setvar! var__has_magic_instrument 1
            break
        endif

        @ignore alias__found_instrument
    endwhile

    clearignore

    if var__has_magic_instrument = 0
        overhead "No magic instrument in the supply box." 33
    endif
endif


// ####################################################################################
// # Sorting items
// ####################################################################################
// cleardragdrop and clearignore only. Nothing below reads the system message buffer, and a
// clearall here would drop every alias the sections above bound.
cleardragdrop
clearignore
#bandage "clean bandage%s%" 3617
#adventure pack "adventure pack" 2726
#dagger "dagger" 3922
#pouch "pouch" 3705
#scissors "scissors" 3998|3999
#kindling "kindling" 3553
#skinning knife "Elven Spellblade" 11552|11564
#smoke bomb "bombs" 52149
#adventurers rope "rope" 5370 (Hue 2799)
#Delectable food 28879|28880|28881|28883|28885|28886|28888|29773|29774
#potion satchel "alchemists satchel" 31262
#item identification wand "wand" 20496
#magic mushroom "mushroom" 29012

removelist sorting_item_list
createlist sorting_item_list

while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016|20496|3922|3617|2726|3998|3999|3553|11552|11564|52149|5370|28879|28880|28881|28883|28885|28886|28888|29773|29774|29012 backpack as alias__found_item
    getlabel alias__found_item label__found_item
    pushlist sorting_item_list alias__found_item
    @ignore alias__found_item
endwhile

cleardragdrop
clearignore

wait wait__short

foreach alias__sorting_item in sorting_item_list
    getlabel alias__sorting_item label__sorting_item
    overhead label__sorting_item 11

    if "item identification wand" in label__sorting_item
        lift alias__sorting_item 1000
        wait wait__short
        drop global__my_looting_pouch 150 0
        wait wait__short
    elseif "supremely" in label__sorting_item or "lute" in label__sorting_item
        lift alias__sorting_item 1000
        wait wait__short
        drop global__my_looting_pouch 130 0
        wait wait__short
    else
        lift alias__sorting_item 1000
        wait wait__short
        drop global__my_looting_pouch 0 0 0
        wait wait__short
    endif

    @ignore alias__sorting_item
endfor

while findtype 3705 backpack 0 as alias__found_pouch
    lift alias__found_pouch
    drop backpack 0 0 0
    ignore alias__found_pouch
    wait wait__short
    dclick alias__found_pouch
endwhile

while findtype 3705 backpack 38 as alias__found_trap_pouch
    lift alias__found_trap_pouch
    drop backpack 0 0 0
    ignore alias__found_trap_pouch
    wait wait__short
endwhile

if findtype 30765 backpack as alias__found_reagent_satchel
    lift alias__found_reagent_satchel
    wait wait__short
    drop global__my_looting_pouch 150 140
    wait wait__short
    dclick alias__found_reagent_satchel
endif

if findtype 31262 backpack as alias__found_alchemists_satchel
    lift alias__found_alchemists_satchel
    wait wait__short
    drop global__my_looting_pouch 130 140
    wait wait__short
    dclick alias__found_alchemists_satchel
