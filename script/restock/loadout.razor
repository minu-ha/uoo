    endif

    if find global__my_bank_deposit_safe global__my_furniture_container
        @setvar! var__has_bank_deposit_safe 1
    endif
else
    if not varexist global__my_bank_deposit_safe or not find global__my_bank_deposit_safe ground -1 -1 config__reach
        unsetvar global__my_bank_deposit_safe
        overhead "Target the bank deposit safe" 55
        setvar global__my_bank_deposit_safe
    endif

    if find global__my_bank_deposit_safe ground -1 -1 config__reach
        @setvar! var__has_bank_deposit_safe 1
    endif
