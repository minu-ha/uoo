# ----------------------------------------------------------------------------------------
# module/escape/tracking.razor
# ----------------------------------------------------------------------------------------
# Reuse the color verified by this script while Hunting remains active.
# A buff alone does not identify the filter. A first run checks the current window instead.
if skill "Tracking" > 0
    if findbuff "tracking" and var__tracking_setup_color = config__tracking_color
        @setvar! var__tracking_filter_confirmed 1
        @setvar! var__tracking_hunting_active 1
    elseif diffhits < config__heal_hits and not poisoned and not warmode
        if not hidden and not queued and not casting and not targetexists
            useskill "Tracking"
            waitforgump 4267467659 wait__tracking_gump

            if gumpexists 4267467659
                # Do not cycle past an already correct filter. The window displays the selected type.
                if config__tracking_color = 1 and ingump "Murderer Players" 4267467659
                    @setvar! var__tracking_filter_confirmed 1
                elseif config__tracking_color = 2 and ingump "Criminal Players" 4267467659
                    @setvar! var__tracking_filter_confirmed 1
                elseif config__tracking_color = 3 and ingump "Enemy Players" 4267467659
                    @setvar! var__tracking_filter_confirmed 1
                elseif config__tracking_color = 4 and ingump "All Hostile Players" 4267467659
                    @setvar! var__tracking_filter_confirmed 1
                endif

                if var__tracking_filter_confirmed = 0
                    # An active hunt must stop before cycling through animals and other player colors.
                    if findbuff "tracking"
                        gumpresponse 6 4267467659
                        wait wait__short
                        for 60
                            if not findbuff "tracking"
                                break
                            endif
                            wait wait__poll
                        endfor
                    endif

                    # Discard the old target and old filter replies only while setting up.
                    clearsysmsg
                    if not findbuff "tracking" and gumpexists 4267467659
                        # Button 8 cycles ten hunt filters. Bound the attempt to one complete rotation.
                        for 10
                            if diffhits >= config__heal_hits or poisoned or warmode or hidden or queued or casting or targetexists
                                break
                            endif
                            if not gumpexists 4267467659
                                break
                            endif
                            gumpresponse 8 4267467659
                            @setvar! var__tracking_button_answered 0
                            # Only one selection is outstanding. Do not outrun a delayed server response.
                            for 60
                                if diffhits >= config__heal_hits or poisoned or warmode or hidden or queued or casting or targetexists
                                    break
                                endif
                                if config__tracking_color = 1
                                    if insysmsg "You will now hunt murderer players"
                                        @setvar! var__tracking_filter_confirmed 1
                                        @setvar! var__tracking_button_answered 1
                                        break
                                    endif
                                elseif config__tracking_color = 2
                                    if insysmsg "You will now hunt criminal players"
                                        @setvar! var__tracking_filter_confirmed 1
                                        @setvar! var__tracking_button_answered 1
                                        break
                                    endif
                                elseif config__tracking_color = 3
                                    if insysmsg "You will now hunt enemy players"
                                        @setvar! var__tracking_filter_confirmed 1
                                        @setvar! var__tracking_button_answered 1
                                        break
                                    endif
                                elseif config__tracking_color = 4
                                    if insysmsg "You will now hunt all hostile players"
                                        @setvar! var__tracking_filter_confirmed 1
                                        @setvar! var__tracking_button_answered 1
                                        break
                                    endif
                                endif
                                if insysmsg "You will now hunt"
                                    @setvar! var__tracking_button_answered 1
                                    break
                                endif
                                wait wait__poll
                            endfor
                            if var__tracking_filter_confirmed = 1 or var__tracking_button_answered = 0
                                break
                            endif
                        endfor
                    endif
                endif

                if var__tracking_filter_confirmed = 1 and gumpexists 4267467659 and diffhits < config__heal_hits and not poisoned and not warmode and not hidden and not queued and not casting and not targetexists
                    # Setup reports belong to the old/intermediate filter, never to Recall detection.
                    clearsysmsg
                    if not findbuff "tracking"
                        gumpresponse 6 4267467659
                        wait wait__short
                    endif
                    if findbuff "tracking"
                        @setvar! var__tracking_hunting_active 1
                        @setvar! var__tracking_setup_color config__tracking_color
                    endif
                    if config__show_tracking = 0
                        gumpclose 4267467659
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ track, miss ]" 254
                    settimer "timer__message" 0
                endif
            elseif timer "timer__message" >= interval__message
                overhead "[ track, miss ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif
endif


# ----------------------------------------------------------------------------------------
# recipe/tamer-mage-enhanced-recipe.razor
# ----------------------------------------------------------------------------------------
# loot/recycle runs the hotkey named in this list when it finishes or gives up. A list, because
# a variable cannot hold a word (blueprint/razor.html part 3). It lasts until the client closes.
if not listexists 'list__resume_script'
    createlist 'list__resume_script'
endif
clearlist 'list__resume_script'
pushlist 'list__resume_script' 'Play Script: combat\tamer-mage-enhanced'

if config__sysmsg = 1
    sysmsg "Tamer mage enhanced v6 loaded: flamestrike mana={{config__mana_flamestrike}}, tracking color={{config__tracking_color}}." 88
endif
if config__chatty = 1
    overhead "[ tamer, on ]" 290
endif


# ========================================================================================
# MAIN LOOP
# ========================================================================================
while not dead
    # ------------------------------------------------------------------------------------
    # PASS START                                                         module/base.razor
    #
    # The pvp expression means structured-PvP restrictions, not a field PK encounter. With
    # config__settle_first 1 the pass then waits for the item queue and any cast to
    # finish.
    # ------------------------------------------------------------------------------------
    if pvp
        overhead "[ script, blocked ]" 254
        stop
    endif

    if config__settle_first = 1
        while queued or casting
            wait wait__short
        endwhile
    endif

    # ------------------------------------------------------------------------------------
    # TRACKING CHECK                                          module/escape/tracking.razor
    #
    # Hunting has to stay on for the profile's Tracking overheads to warn and for
    # escape/recall to read a report, so the loop looks at it every interval__tracking_check
    # and asks for it while it is off. A character without Tracking skips it.
    # ------------------------------------------------------------------------------------
    if timer "timer__tracking_check" >= interval__tracking_check and skill "Tracking" > 0
        settimer "timer__tracking_check" 0
        @setvar! var__tracking_hunting_active 0
        if var__tracking_filter_confirmed = 1 and findbuff "tracking"
            @setvar! var__tracking_hunting_active 1
        endif

        if var__tracking_hunting_active = 0 and timer "timer__message" >= interval__message
            overhead "[ track, check ]" 255
            settimer "timer__message" 0
        endif
    endif

    # ------------------------------------------------------------------------------------
    # COMBAT TARGET                                              module/fight/target.razor
    #
    # A pick within config__acquire_range becomes the remembered enemy. A carve or a song
    # targets a corpse or an item, and dead and noto only take mobiles, so the serial
    # range is checked first: mobile serials are below 0x40000000, and the number has to
    # be on the left (blueprint/razor.html part 3, debug-target-state S06). The enemy is a
    # fight (var__fighting 1) inside config__target_range, kept outside it while still
    # within config__acquire_range, and dropped config__target_grace after it leaves that.
    # ------------------------------------------------------------------------------------
    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
        if var__combat_target != alias__fresh_target
            @setvar! var__fresh_serial alias__fresh_target
            if 0x40000000 > var__fresh_serial
                if not dead alias__fresh_target
                    if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                        @setvar! var__combat_target alias__fresh_target
                        settimer "timer__target_grace" 0
                        if config__chatty = 1
                            overhead "[ target, set ]" 1288 var__combat_target
                        endif
                        if config__sysmsg = 1
                            sysmsg "Combat target: {{alias__fresh_target}}." 88
                        endif
                    endif
                endif
            endif
        endif
    endif

    @setvar! var__fighting 0
    if var__combat_target = 0
        # No enemy remembered, nothing to keep.
    elseif find var__combat_target ground -1 -1 config__target_range as alias__stored_target
        settimer "timer__target_grace" 0
        if dead alias__stored_target
            @setvar! var__combat_target 0
        elseif noto alias__stored_target != "hostile" and noto alias__stored_target != "criminal" and noto alias__stored_target != "enemy" and noto alias__stored_target != "murderer"
            @setvar! var__combat_target 0
        else
            @setvar! var__fighting 1
        endif
    elseif find var__combat_target ground -1 -1 config__acquire_range as alias__stored_target
        settimer "timer__target_grace" 0
        if dead alias__stored_target
            @setvar! var__combat_target 0
        endif
    elseif timer "timer__target_grace" >= config__target_grace
        @setvar! var__combat_target 0
    endif

    if paralyzed or poisoned or diffhits > 0
        # --------------------------------------------------------------------------------
        # PARALYZE                                             module/recovery/pouch.razor
        #
        # Nothing else can act while held, so the pouch goes out at once.
        # --------------------------------------------------------------------------------
        if paralyzed
            if findtype 3705 backpack 38
                yell "[Pouch"
                wait wait__short
            elseif timer "timer__message" >= interval__message
                overhead "[ pouch, out ]" 254
                settimer "timer__message" 0
            endif
        endif

        # --------------------------------------------------------------------------------
        # CURE                                                  module/recovery/cure.razor
        #
        # Potion first, it is instant and has no cooldown, and it goes out during a cast.
        # While any cure potion is carried the agent is not used, so mana stays for
        # Greater Heal. The agent waits for the walk bar and for warmode as
        # config__walk_guard and config__warmode_is_manual say.
        # --------------------------------------------------------------------------------
        if poisoned and not paralyzed and not hidden and not queued and not targetexists
            if config__use_potions = 1 and findtype "Orange Potion" self
                hotkey "Drink Cure"
                wait wait__short
            else
                if config__use_potions = 1 and timer "timer__message" >= interval__message
                    overhead "[ cure pot, out ]" 254
                    settimer "timer__message" 0
                endif

                if config__use_magery = 1 and var__regs_cure = 1 and mana >= config__mana_cure and not casting
                    if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                        if config__walk_guard = 0 or cooldown "walk" = 0
                            hotkey "> Smart Heal/Cure Self"
                            if config__sysmsg = 1
                                sysmsg "Agent: Smart Heal/Cure Self for poison." 88
                            endif
                            wait wait__short

                            for 60
                                if not casting
                                    break
                                endif
                                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                    break
                                endif
                                wait wait__poll
                            endfor
                        endif
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # HEAL                                                  module/recovery/heal.razor
        #
        # Heavy damage drinks first, because the potion is instant and goes out during a
        # cast. Greater Heal follows when no potion went out on this pass and the loss is
        # at the emergency line: none carried, on its own cooldown, or the bar still
        # running. The bar skips the label read while it runs. The label stays
        # authoritative when the bar is missing. Greater Heal waits for the walk bar and
        # for warmode as config__walk_guard and config__warmode_is_manual say.
        # --------------------------------------------------------------------------------
        if not poisoned and not paralyzed and not hidden and not queued and not targetexists and diffhits >= config__heal_hits
            @setvar! var__heal_potion_out 0
            if config__use_potions = 1 and cooldown "heal pot" = 0
                if findtype "Yellow Potion" self as alias__heal_potion
                    getlabel alias__heal_potion label__heal_potion
                    if "next usable" in label__heal_potion
                        # Still on its own cooldown.
                    else
                        hotkey "Drink Heal"
                        cooldown "heal pot" cooldown__heal_potion
                        @setvar! var__heal_potion_out 1
                        wait wait__short
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ heal pot, out ]" 254
                    settimer "timer__message" 0
                endif
            endif

            if var__heal_potion_out = 0 and diffhits >= config__emergency_hits and config__use_magery = 1 and var__regs_greater_heal = 1 and mana >= config__mana_greater_heal and not casting
                if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                    if config__walk_guard = 0 or cooldown "walk" = 0
                        hotkey "> Greater Heal/Cure Self"
                        if config__sysmsg = 1
                            sysmsg "Agent: Greater Heal/Cure Self." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            wait wait__poll
                        endfor

                        # The agent leaves its beneficial cursor up when there is nothing left to heal.
                        if targetexists "beneficial" and diffhits = 0
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # REFRESH                                                module/recovery/refresh.razor
    # ------------------------------------------------------------------------------------
    if stam <= config__refresh_stam and config__use_potions = 1 and not paralyzed and not hidden and not queued and not targetexists
        if findtype "Red Potion" self
            hotkey "Drink Refresh"
            wait wait__short
        endif
    endif

    # ------------------------------------------------------------------------------------
    # VET KIT                                                   module/tamer/vet-kit.razor
    #
    # Veterinary supplies (25750), the self bandage that also reaches the followers.
    #   running  A kit that began is left alone until "You finish using veterinary
    #            supplies", because using the supplies again cancels it.
    #            interval__vet_running ends the wait when another insysmsg consumed that
    #            line first.
    #   hurt     Any hit point loss sends the kit at once.
    #   pets     At full health the kit goes once var__vet_wait has passed: at once after a
    #            finish, and interval__vet_refused after "do not require healing". diffhits
    #            reads only our own hit points, so that answer is the pets' health check.
    # Bandaging gates it too, since a manual bandage on a pet would be cancelled the same
    # way. The answer is read on the spot. With no answer the kit is taken as running, so a
    # late begin line cannot let the next pass cancel it.
    # ------------------------------------------------------------------------------------
    if var__vet_running = 1
        if insysmsg "You finish using veterinary supplies"
            @setvar! var__vet_running 0
            @setvar! var__vet_wait 0
        elseif timer "timer__vet_kit" >= interval__vet_running
            @setvar! var__vet_running 0
            @setvar! var__vet_wait 0
        endif
    endif

    if var__vet_running = 0 and not bandaging and not hidden and not queued and not targetexists
        if diffhits > 0 or timer "timer__vet_kit" >= var__vet_wait
            settimer "timer__vet_kit" 0
            if findtype 25750 backpack as alias__vet_kit
                dclick alias__vet_kit
                @setvar! var__vet_running 1
                for 20
                    if insysmsg "You begin using veterinary supplies"
                        break
                    endif
                    if insysmsg "do not require healing"
                        @setvar! var__vet_running 0
                        break
                    endif
                    wait wait__poll
                endfor

                # Nothing was applied. A hurt pass tries again at once, the pets after the wait.
                if var__vet_running = 0
                    @setvar! var__vet_wait interval__vet_refused
                    settimer "timer__vet_kit" 0
                endif
            else
                # Out of supplies. Looked up again after the same wait, or at once when hurt.
                @setvar! var__vet_wait interval__vet_refused
                if timer "timer__message" >= interval__message
                    overhead "[ vet kit, out ]" 254
                    settimer "timer__message" 0
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # REAGENTS                                                module/magery/reagents.razor
    #
    # On the interval, or at once after a refusal for reagents, so a stale flag cannot
    # send the same doomed cast every pass. Each reagent is looked up once, and every
    # spell flag comes from those seven with plain comparisons.
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1
        if timer "timer__reagents" >= interval__reagents or insysmsg "More reagents are needed"
            settimer "timer__reagents" 0

            @setvar! var__has_black_pearl 0
            @setvar! var__has_garlic 0
            @setvar! var__has_ginseng 0
            @setvar! var__has_mandrake 0
            @setvar! var__has_nightshade 0
            @setvar! var__has_ash 0
            @setvar! var__has_silk 0

            if findtype 3962 self
                @setvar! var__has_black_pearl 1
            endif
            if findtype 3972 self
                @setvar! var__has_garlic 1
            endif
            if findtype 3973 self
                @setvar! var__has_ginseng 1
            endif
            if findtype 3974 self
                @setvar! var__has_mandrake 1
            endif
            if findtype 3976 self
                @setvar! var__has_nightshade 1
            endif
            if findtype 3980 self
                @setvar! var__has_ash 1
            endif
            if findtype 3981 self
                @setvar! var__has_silk 1
            endif

            @setvar! var__regs_cure 0
            @setvar! var__regs_heal 0
            @setvar! var__regs_greater_heal 0
            @setvar! var__regs_create_food 0
            @setvar! var__regs_reactive_armor 0
            @setvar! var__regs_magic_reflect 0
            @setvar! var__regs_magic_arrow 0
            @setvar! var__regs_harm 0
            @setvar! var__regs_fireball 0
            @setvar! var__regs_lightning 0
            @setvar! var__regs_curse 0
            @setvar! var__regs_mana_drain 0
            @setvar! var__regs_energy_bolt 0
            @setvar! var__regs_bless 0
            @setvar! var__regs_arch_protection 0
            @setvar! var__regs_flamestrike 0

            if var__has_garlic = 1 and var__has_ginseng = 1
                @setvar! var__regs_cure 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_silk = 1
                @setvar! var__regs_heal 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_greater_heal 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1
                @setvar! var__regs_create_food 1
            endif
            if var__has_garlic = 1 and var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_reactive_armor 1
            endif
            if var__has_garlic = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_magic_reflect 1
            endif
            if var__has_ash = 1
                @setvar! var__regs_magic_arrow 1
            endif
            if var__has_nightshade = 1 and var__has_silk = 1
                @setvar! var__regs_harm 1
            endif
            if var__has_black_pearl = 1
                @setvar! var__regs_fireball 1
            endif
            if var__has_mandrake = 1 and var__has_ash = 1
                @setvar! var__regs_lightning 1
            endif
            if var__has_garlic = 1 and var__has_nightshade = 1 and var__has_ash = 1
                @setvar! var__regs_curse 1
            endif
            if var__has_black_pearl = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_mana_drain 1
            endif
            if var__has_black_pearl = 1 and var__has_nightshade = 1
                @setvar! var__regs_energy_bolt 1
            endif
            if var__has_garlic = 1 and var__has_mandrake = 1
                @setvar! var__regs_bless 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1 and var__has_ash = 1
                @setvar! var__regs_arch_protection 1
            endif
            if var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_flamestrike 1
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # STAT POTIONS                                               module/buff/potions.razor
    #
    # Kept up while var__fighting is 1. Strength and Agility read the stat against
    # config__str_potion and config__dex_potion, because Bless and the Strength and
    # Agility spells show the same icons as the potions, and each is tried once per
    # interval__stat_potion. Magic Resist has an icon of its own and is drunk once it is
    # missing. Each potion is judged on its own, so running out of one does not hold up
    # the others.
    # ------------------------------------------------------------------------------------
    if var__fighting = 1 and config__use_potions = 1 and not paralyzed and not hidden and not targetexists
        if not queued and str < config__str_potion and timer "timer__str_potion" >= interval__stat_potion
            settimer "timer__str_potion" 0
            if findtype "White Potion" self
                hotkey "Drink Strength"
                wait wait__short
            endif
        endif
        if not queued and dex < config__dex_potion and timer "timer__agi_potion" >= interval__stat_potion
            settimer "timer__agi_potion" 0
            if findtype "Blue Potion" self
                hotkey "Drink Agility"
                wait wait__short
            endif
        endif
        if config__use_resist_potion = 1 and not queued and not findbuff "Magic Resist Potion"
            if findtype "Black Potion" self
                hotkey "Drink Magic Resist"
                wait wait__short
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # SELF BUFFS                                                  module/buff/spells.razor
    #
    # Reactive Armor, then Magic Reflection, whenever one is missing and the window is
    # free, then Bless and Arch Protection out of a fight. One cast per pass. Bless shows
    # Strength, Agility and Cunning, and only Cunning is Bless alone, since the stat
    # potions show the other two. Arch Protection shows Protection. Each icon arrives a
    # round trip after the target, so the block waits for it before the next pass reads it. Not started at config__buff_max_loss, and cut there mid cast so the next pass
    # can heal. With config__buff_when_poisoned 0 poison holds them back and cuts them
    # too, so the cure goes first. var__hold_casts lets another block keep the cast window
    # (a latched Recall). config__walk_guard and config__warmode_is_manual apply as for
    # the heal agents. The reflect bar is the server's recast lock after Reflect is used
    # up.
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1 and var__hold_casts = 0 and not paralyzed and not hidden and not queued and not casting and not targetexists and diffhits < config__buff_max_loss
        if config__buff_when_poisoned = 1 or not poisoned
            if config__warmode_is_manual = 0 or not warmode
                if config__walk_guard = 0 or cooldown "walk" = 0
                    if config__use_reactive_armor = 1 and var__regs_reactive_armor = 1 and mana >= config__mana_reactive_armor and not findbuff "Reactive Armor"
                        cast "Reactive Armor"
                        @setvar! var__buff_cast 1
                        if config__sysmsg = 1
                            sysmsg "Buff: Reactive Armor." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif
                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif
                            wait wait__poll
                        endfor
                    elseif config__use_magic_reflect = 1 and var__regs_magic_reflect = 1 and mana >= config__mana_magic_reflect and cooldown "reflect" = 0 and not findbuff "Magic Reflection"
                        cast "Magic Reflection"
                        @setvar! var__buff_cast 1
                        if config__sysmsg = 1
                            sysmsg "Buff: Magic Reflection." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif
                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif
                            wait wait__poll
                        endfor
                    elseif config__use_bless = 1 and var__fighting = 0 and not warmode and var__regs_bless = 1 and mana >= config__mana_bless and not findbuff "Cunning"
                        cast "Bless"
                        @setvar! var__buff_cast 1
                        if config__sysmsg = 1
                            sysmsg "Buff: Bless." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif
                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif
                            wait wait__poll
                        endfor

                        if targetexists "beneficial"
                            target self
                            for 10
                                if findbuff "Cunning"
                                    break
                                endif
                                wait wait__poll
                            endfor
                        endif
                    elseif config__use_arch_protection = 1 and var__fighting = 0 and not warmode and var__regs_arch_protection = 1 and mana >= config__mana_arch_protection and not findbuff "Protection"
                        cast "Arch Protection"
                        @setvar! var__buff_cast 1
                        if config__sysmsg = 1
                            sysmsg "Buff: Arch Protection." 88
                        endif
                        wait wait__short

                        for 60
                            if targetexists
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            if diffhits >= config__buff_max_loss
                                hotkey "> Interrupt"
                                break
                            endif
                            if config__buff_when_poisoned = 0 and poisoned
                                hotkey "> Interrupt"
                                break
                            endif
                            wait wait__poll
                        endfor

                        if targetexists "beneficial"
                            target self
                            for 10
                                if findbuff "Protection"
                                    break
                                endif
                                wait wait__poll
                            endfor
                        endif
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # FLAMESTRIKE                                          module/magery/flamestrike.razor
    #
    # On the engaged enemy (var__fighting), with warmode off, and not at the emergency line.
    # The targeted cast shape of blueprint/razor.html part 4: drain a stale disturbance,
    # cast, poll for the cursor, then read lasttarget once more. If the player picked
    # another enemy during the cast, or the enemy died, the cursor is cancelled and the
    # next pass casts on the new pick. An emergency during the cast cuts it as
    # config__interrupt_to_heal says.
    # ------------------------------------------------------------------------------------
    if var__fighting = 1 and not warmode and var__regs_flamestrike = 1 and mana >= config__mana_flamestrike and diffhits < config__emergency_hits and not paralyzed and not hidden and not queued and not casting and not targetexists and cooldown "walk" = 0
        if find var__combat_target ground -1 -1 config__target_range as alias__fs_target
            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                # Consumed. A stale disturbance cannot end the poll below early.
            endif
            cast "Flamestrike"
            wait wait__short

            for 60
                if targetexists
                    break
                endif
                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                    break
                endif
                if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                    if config__chatty = 1
                        overhead "[ flamestrike, cut ]" 254
                    endif
                    hotkey "> Interrupt"
                    break
                endif
                wait wait__poll
            endfor

            if targetexists "harmful"
                @setvar! var__keep_lasttarget 0
                if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                    if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                        if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                            @setvar! var__keep_lasttarget 1
                        endif
                    endif
                endif

                if var__keep_lasttarget = 1 or dead alias__fs_target
                    hotkey "Cancel Current Target"
                    wait wait__short
                else
                    target alias__fs_target
                    if config__sysmsg = 1
                        sysmsg "Flamestrike on {{alias__fs_target}}." 88
                    endif
                    wait wait__cast
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # FOOD                                                          module/buff/food.razor
    #
    # Looked at once a minute. The buff lasts far longer. With config__warmode_is_manual 1
    # it stands down in warmode, as our casts do.
    # ------------------------------------------------------------------------------------
    if timer "timer__food" >= interval__food and not findbuff "Food Satisfaction"
        if config__warmode_is_manual = 0 or not warmode
            if not hidden and not queued and not casting and not targetexists
                settimer "timer__food" 0
                if findtype tray backpack as alias__food
                    dclick alias__food
                    wait wait__short
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # MUSHROOM                                                  module/buff/mushroom.razor
    #
    # Eating is an item use, so like a potion it goes out during a cast and on the move,
    # and waits only for a held cursor. Create Food is a cast and waits for a fight to end,
    # so its 60 second cooldown burns on the walk rather than taking a cast from the
    # rotation. It also stands down in warmode and for the walk bar.
    # ------------------------------------------------------------------------------------
    if mana <= config__mushroom_eat_mana and not findbuff 'Magic Mushroom Cooldown' and not hidden and not queued and not targetexists and findtype "mushroom" backpack
        hotkey 'Eat Magic Mushroom'
        wait wait__short
    elseif var__fighting = 0 and mana >= config__mushroom_create_mana and var__regs_create_food = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0 and counttype "mushroom" backpack < config__mushroom_min_count
        cast 'Create Food'
        wait wait__short

        for 60
            if not casting
                break
            endif

            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                break
            endif

            wait wait__poll
        endfor
    endif

    # ------------------------------------------------------------------------------------
    # GOLD                                                     module/pack/gold-drop.razor
    #
    # One drop per pass, so recovery still runs between drops. A refused drop goes back to
    # the pack.
    # ------------------------------------------------------------------------------------
    if weight > maxweight
        if not hidden and not queued and not casting and not targetexists
            if findtype "gold coin" backpack as alias__found_gold
                lift alias__found_gold config__gold_drop_amount
                droprelloc 0 0
                if config__sysmsg = 1
                    sysmsg "Gold drop: up to {{config__gold_drop_amount}} at your feet, weight over max." 88
                endif
                wait wait__short

                if insysmsg "cannot drop anything"
                    drop backpack -1 -1 -1
                endif

                wait wait__gold_drop
                if config__chatty = 1
                    overhead "[ gold, dropped ]" 290
                endif
            elseif timer "timer__message" >= interval__message
                overhead "[ weight, over ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # END OF PASS                                                        module/base.razor
    # ------------------------------------------------------------------------------------
    wait wait__poll
endwhile
