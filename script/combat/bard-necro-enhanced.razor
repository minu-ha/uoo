endif


# ----------------------------------------------------------------------------------------
# recipe/bard-necro-enhanced-recipe.razor
# ----------------------------------------------------------------------------------------
# loot/recycle runs the hotkey named in this list when it finishes or gives up. A list, because
# a variable cannot hold a word (blueprint/razor.html part 3). It lasts until the client closes.
if not listexists 'list__resume_script'
    createlist 'list__resume_script'
endif
clearlist 'list__resume_script'
pushlist 'list__resume_script' 'Play Script: combat\bard-necro-enhanced'

if config__chatty = 1
    overhead "[ bard necro, on ]" 290
endif


# ========================================================================================
# MAIN LOOP
# ========================================================================================
while not dead
    # ------------------------------------------------------------------------------------
    # PASS START                                                         module/base.razor
    #
    # The pvp expression means structured-PvP restrictions, not a field PK encounter. With
    # config__settle_first 1 the pass then waits for the item queue and any cast to
    # finish.
    # ------------------------------------------------------------------------------------
    if pvp
        overhead "[ script, blocked ]" 254
        stop
    endif

    if config__settle_first = 1
        while queued or casting
            wait wait__short
        endwhile
    endif

    if paralyzed or poisoned or diffhits > 0
        # --------------------------------------------------------------------------------
        # PARALYZE                                             module/recovery/pouch.razor
        #
        # Nothing else can act while held, so the pouch goes out at once, as in
        # bard-necro-enhanced.
        # --------------------------------------------------------------------------------
        if paralyzed
            if findtype 3705 backpack 38
                yell "[Pouch"
                wait wait__short
            elseif timer "timer__message" >= interval__message
                overhead "[ pouch, out ]" 254
                settimer "timer__message" 0
            endif
        endif

        # --------------------------------------------------------------------------------
        # CURE                                                  module/recovery/cure.razor
        #
        # Potion first, it is instant and has no cooldown, and it goes out during a cast.
        # While any cure potion is carried the agent is not used, so mana stays for
        # Greater Heal. The agent waits for the walk bar and for warmode as
        # config__walk_guard and config__warmode_is_manual say.
        # --------------------------------------------------------------------------------
        if poisoned and not paralyzed and not hidden and not queued and not targetexists
            if config__use_potions = 1 and findtype "Orange Potion" self
                hotkey "Drink Cure"
                wait wait__short
            else
                if config__use_potions = 1 and timer "timer__message" >= interval__message
                    overhead "[ cure pot, out ]" 254
                    settimer "timer__message" 0
                endif

                if config__use_magery = 1 and var__regs_cure = 1 and mana >= config__mana_cure and not casting
                    if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                        if config__walk_guard = 0 or cooldown "walk" = 0
                            hotkey "> Smart Heal/Cure Self"
                            if config__sysmsg = 1
                                sysmsg "Agent: Smart Heal/Cure Self for poison." 88
                            endif
                            wait wait__short

                            for 60
                                if not casting
                                    break
                                endif
                                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                    break
                                endif
                                wait wait__poll
                            endfor
                        endif
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # HEAL                                                  module/recovery/heal.razor
        #
        # Heavy damage drinks first, because the potion is instant and goes out during a
        # cast. Greater Heal follows when no potion went out on this pass and the loss is
        # at the emergency line: none carried, on its own cooldown, or the bar still
        # running. The bar skips the label read while it runs. The label stays
        # authoritative when the bar is missing. Greater Heal waits for the walk bar and
        # for warmode as config__walk_guard and config__warmode_is_manual say.
        # --------------------------------------------------------------------------------
        if not poisoned and not paralyzed and not hidden and not queued and not targetexists and diffhits >= config__heal_hits
            @setvar! var__heal_potion_out 0
            if config__use_potions = 1 and cooldown "heal pot" = 0
                if findtype "Yellow Potion" self as alias__heal_potion
                    getlabel alias__heal_potion label__heal_potion
                    if "next usable" in label__heal_potion
                        # Still on its own cooldown.
                    else
                        hotkey "Drink Heal"
                        cooldown "heal pot" cooldown__heal_potion
                        @setvar! var__heal_potion_out 1
                        wait wait__short
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ heal pot, out ]" 254
                    settimer "timer__message" 0
                endif
            endif

            if var__heal_potion_out = 0 and diffhits >= config__emergency_hits and config__use_magery = 1 and var__regs_greater_heal = 1 and mana >= config__mana_greater_heal and not casting
                if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                    if config__walk_guard = 0 or cooldown "walk" = 0
                        hotkey "> Greater Heal/Cure Self"
                        if config__sysmsg = 1
                            sysmsg "Agent: Greater Heal/Cure Self." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            wait wait__poll
                        endfor

                        # The agent leaves its beneficial cursor up when there is nothing left to heal.
                        if targetexists "beneficial" and diffhits = 0
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # LIGHT HEAL                                      module/recovery/light-heal.razor
        #
        # The bandage stand-in whenever no bandage can run: bandages off, no Healing, or
        # none left and none running. Beside the bandages only with config__use_light_heal
        # 1. The agent waits for the walk bar and for warmode as config__walk_guard and
        # config__warmode_is_manual say.
        # --------------------------------------------------------------------------------
        if not poisoned and not paralyzed and not hidden and not queued and not casting and not targetexists and config__use_magery = 1 and var__regs_heal = 1 and diffhits >= config__light_hits and mana >= config__mana_heal
            @setvar! var__light_heal_due 0
            if config__use_light_heal = 1 or config__use_bandages = 0 or skill "Healing" <= config__heal_skill_min
                @setvar! var__light_heal_due 1
            elseif not bandaging and not findtype 3617 self
                @setvar! var__light_heal_due 1
            endif

            if var__light_heal_due = 1
                if config__warmode_is_manual = 0 or config__recover_in_warmode = 1 or not warmode
                    if config__walk_guard = 0 or cooldown "walk" = 0
                        hotkey "> Smart Heal/Cure Self"
                        if config__sysmsg = 1
                            sysmsg "Agent: Smart Heal/Cure Self, light Heal." 88
                        endif
                        wait wait__short

                        for 60
                            if not casting
                                break
                            endif
                            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                break
                            endif
                            wait wait__poll
                        endfor

                        if targetexists "beneficial" and diffhits = 0
                            hotkey "Cancel Current Target"
                            wait wait__short
                        endif
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # COMBAT TARGET                                              module/fight/target.razor
    #
    # A pick within config__acquire_range becomes the remembered enemy. A carve or a song
    # targets a corpse or an item, and dead and noto only take mobiles, so the serial
    # range is checked first: mobile serials are below 0x40000000, and the number has to
    # be on the left (blueprint/razor.html part 3, debug-target-state S06). The enemy is a
    # fight (var__fighting 1) inside config__target_range, kept outside it while still
    # within config__acquire_range, and dropped config__target_grace after it leaves that.
    # ------------------------------------------------------------------------------------
    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
        if var__combat_target != alias__fresh_target
            @setvar! var__fresh_serial alias__fresh_target
            if 0x40000000 > var__fresh_serial
                if not dead alias__fresh_target
                    if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                        @setvar! var__combat_target alias__fresh_target
                        settimer "timer__target_grace" 0
                        if config__chatty = 1
                            overhead "[ target, set ]" 1288 var__combat_target
                        endif
                        if config__sysmsg = 1
                            sysmsg "Combat target: {{alias__fresh_target}}." 88
                        endif
                    endif
                endif
            endif
        endif
    endif

    @setvar! var__fighting 0
    if var__combat_target = 0
        # No enemy remembered, nothing to keep.
    elseif find var__combat_target ground -1 -1 config__target_range as alias__stored_target
        settimer "timer__target_grace" 0
        if dead alias__stored_target
            @setvar! var__combat_target 0
        elseif noto alias__stored_target != "hostile" and noto alias__stored_target != "criminal" and noto alias__stored_target != "enemy" and noto alias__stored_target != "murderer"
            @setvar! var__combat_target 0
        else
            @setvar! var__fighting 1
        endif
    elseif find var__combat_target ground -1 -1 config__acquire_range as alias__stored_target
        settimer "timer__target_grace" 0
        if dead alias__stored_target
            @setvar! var__combat_target 0
        endif
    elseif timer "timer__target_grace" >= config__target_grace
        @setvar! var__combat_target 0
    endif

    # ------------------------------------------------------------------------------------
    # REAGENTS                                                module/magery/reagents.razor
    #
    # On the interval, or at once after a refusal for reagents, so a stale flag cannot
    # send the same doomed cast every pass. Each reagent is looked up once, and every
    # spell flag comes from those seven with plain comparisons.
    # ------------------------------------------------------------------------------------
    if config__use_magery = 1
        if timer "timer__reagents" >= interval__reagents or insysmsg "More reagents are needed"
            settimer "timer__reagents" 0

            @setvar! var__has_black_pearl 0
            @setvar! var__has_garlic 0
            @setvar! var__has_ginseng 0
            @setvar! var__has_mandrake 0
            @setvar! var__has_nightshade 0
            @setvar! var__has_ash 0
            @setvar! var__has_silk 0

            if findtype 3962 self
                @setvar! var__has_black_pearl 1
            endif
            if findtype 3972 self
                @setvar! var__has_garlic 1
            endif
            if findtype 3973 self
                @setvar! var__has_ginseng 1
            endif
            if findtype 3974 self
                @setvar! var__has_mandrake 1
            endif
            if findtype 3976 self
                @setvar! var__has_nightshade 1
            endif
            if findtype 3980 self
                @setvar! var__has_ash 1
            endif
            if findtype 3981 self
                @setvar! var__has_silk 1
            endif

            @setvar! var__regs_cure 0
            @setvar! var__regs_heal 0
            @setvar! var__regs_greater_heal 0
            @setvar! var__regs_create_food 0
            @setvar! var__regs_reactive_armor 0
            @setvar! var__regs_magic_reflect 0
            @setvar! var__regs_magic_arrow 0
            @setvar! var__regs_harm 0
            @setvar! var__regs_fireball 0
            @setvar! var__regs_lightning 0
            @setvar! var__regs_curse 0
            @setvar! var__regs_mana_drain 0
            @setvar! var__regs_energy_bolt 0

            if var__has_garlic = 1 and var__has_ginseng = 1
                @setvar! var__regs_cure 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_silk = 1
                @setvar! var__regs_heal 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_greater_heal 1
            endif
            if var__has_garlic = 1 and var__has_ginseng = 1 and var__has_mandrake = 1
                @setvar! var__regs_create_food 1
            endif
            if var__has_garlic = 1 and var__has_silk = 1 and var__has_ash = 1
                @setvar! var__regs_reactive_armor 1
            endif
            if var__has_garlic = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_magic_reflect 1
            endif
            if var__has_ash = 1
                @setvar! var__regs_magic_arrow 1
            endif
            if var__has_nightshade = 1 and var__has_silk = 1
                @setvar! var__regs_harm 1
            endif
            if var__has_black_pearl = 1
                @setvar! var__regs_fireball 1
            endif
            if var__has_mandrake = 1 and var__has_ash = 1
                @setvar! var__regs_lightning 1
            endif
            if var__has_garlic = 1 and var__has_nightshade = 1 and var__has_ash = 1
                @setvar! var__regs_curse 1
            endif
            if var__has_black_pearl = 1 and var__has_mandrake = 1 and var__has_silk = 1
                @setvar! var__regs_mana_drain 1
            endif
            if var__has_black_pearl = 1 and var__has_nightshade = 1
                @setvar! var__regs_energy_bolt 1
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # UNHOLY SYMBOLS                                            module/necro/symbols.razor
    #
    # The count is read off the necro hotbar gump, which prints them as "<have>/<max>".
    # ingump matches a substring, so the chain runs from the top down: "10/" is checked
    # before the single digits, and none of "1/" to "9/" occurs inside "10/10", so each
    # line only ever sees the count it names. Ten is the ceiling: the bank is Effective
    # Necromancy / 10 and this character sits at 100. Should the hotbar ever show more
    # than ten, add the higher readings above the 10/ line, or a two digit reading falls
    # into "1/". A closed gump reads as zero, which parks every ability until necro/hotbar
    # reopens it. An elseif chain is evaluated in a single tick, whatever its length.
    #
    # The gates compare against the list, list 'x' >= n being the one size comparison a
    # script variable takes part in. Each reading refills the list only when it differs
    # from the last fill: at ten symbols the old refill on every pass was some twenty
    # statements, this is two, the chain and the inner if. The fill is a literal for count
    # per reading because a for count cannot be a variable.
    # ------------------------------------------------------------------------------------
    if ingump "10/" 622436516
        if var__symbols_listed != 10
            clearlist 'list__necro_symbols'

            for 10
                pushlist 'list__necro_symbols' '1' 'back'
            endfor

            @setvar! var__symbols_listed 10
        endif
    elseif ingump "9/" 622436516
        if var__symbols_listed != 9
            clearlist 'list__necro_symbols'

            for 9
                pushlist 'list__necro_symbols' '1' 'back'
            endfor

            @setvar! var__symbols_listed 9
        endif
    elseif ingump "8/" 622436516
        if var__symbols_listed != 8
            clearlist 'list__necro_symbols'

            for 8
                pushlist 'list__necro_symbols' '1' 'back'
            endfor

            @setvar! var__symbols_listed 8
        endif
    elseif ingump "7/" 622436516
        if var__symbols_listed != 7
            clearlist 'list__necro_symbols'

            for 7
                pushlist 'list__necro_symbols' '1' 'back'
            endfor

            @setvar! var__symbols_listed 7
        endif
    elseif ingump "6/" 622436516
        if var__symbols_listed != 6
            clearlist 'list__necro_symbols'

            for 6
                pushlist 'list__necro_symbols' '1' 'back'
            endfor

            @setvar! var__symbols_listed 6
        endif
    elseif ingump "5/" 622436516
        if var__symbols_listed != 5
            clearlist 'list__necro_symbols'

            for 5
                pushlist 'list__necro_symbols' '1' 'back'
            endfor

            @setvar! var__symbols_listed 5
        endif
    elseif ingump "4/" 622436516
        if var__symbols_listed != 4
            clearlist 'list__necro_symbols'

            for 4
                pushlist 'list__necro_symbols' '1' 'back'
            endfor

            @setvar! var__symbols_listed 4
        endif
    elseif ingump "3/" 622436516
        if var__symbols_listed != 3
            clearlist 'list__necro_symbols'

            for 3
                pushlist 'list__necro_symbols' '1' 'back'
            endfor

            @setvar! var__symbols_listed 3
        endif
    elseif ingump "2/" 622436516
        if var__symbols_listed != 2
            clearlist 'list__necro_symbols'

            for 2
                pushlist 'list__necro_symbols' '1' 'back'
            endfor

            @setvar! var__symbols_listed 2
        endif
    elseif ingump "1/" 622436516
        if var__symbols_listed != 1
            clearlist 'list__necro_symbols'

            for 1
                pushlist 'list__necro_symbols' '1' 'back'
            endfor

            @setvar! var__symbols_listed 1
        endif
    else
        if var__symbols_listed != 0
            clearlist 'list__necro_symbols'
            @setvar! var__symbols_listed 0
        endif
    endif

    if timer "timer__housekeeping" >= interval__housekeeping
        settimer "timer__housekeeping" 0

        # --------------------------------------------------------------------------------
        # INSTRUMENT                                          module/bard/instrument.razor
        #
        # Mid run recovery is auto detect only. A manual pick would block the loop on a
        # cursor the player is not looking at, in the middle of a fight.
        #
        # Whether the instrument is still in the backpack is looked at every thirty
        # seconds, not every pass. The bard blocks test not warmode, var__instrument_ok
        # and var__my_instrument themselves. A bard block that finds the instrument gone
        # clears var__my_instrument on the spot, which stands them down at once, clock or
        # no clock.
        # --------------------------------------------------------------------------------
        if var__my_instrument = 0
            if not targetexists and not casting
                if findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as alias__spare_instrument
                    @setvar! var__my_instrument alias__spare_instrument
                    @setvar! var__instrument_ok 1

                    if config__chatty = 1
                        overhead "[ inst, set ]" 290
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ inst, out ]" 254
                    settimer "timer__message" 0
                endif
            endif
        endif

        if timer "timer__instrument_check" >= interval__instrument_check
            settimer "timer__instrument_check" 0
            @setvar! var__instrument_ok 0

            if find var__my_instrument backpack
                @setvar! var__instrument_ok 1
            endif
        endif

        # --------------------------------------------------------------------------------
        # REFRESH                                            module/recovery/refresh.razor
        # --------------------------------------------------------------------------------
        if stam <= config__refresh_stam and config__use_potions = 1 and not paralyzed and not hidden and not queued and not targetexists
            if findtype "Red Potion" self
                hotkey "Drink Refresh"
                wait wait__short
            endif
        endif

        # --------------------------------------------------------------------------------
        # FOOD                                                      module/buff/food.razor
        #
        # Looked at once a minute. The buff lasts far longer. With
        # config__warmode_is_manual 1 it stands down in warmode, as our casts do.
        # --------------------------------------------------------------------------------
        if timer "timer__food" >= interval__food and not findbuff "Food Satisfaction"
            if config__warmode_is_manual = 0 or not warmode
                if not hidden and not queued and not casting and not targetexists
                    settimer "timer__food" 0
                    if findtype tray backpack as alias__food
                        dclick alias__food
                        wait wait__short
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # NECRO HOTBAR                                           module/necro/hotbar.razor
        #
        # The hotbar gump is the source of truth for the Unholy Symbol count the necro
        # stage reads. One block covers both the first open and any later loss, because
        # the timer starts expired. It is looked for every thirty seconds, the clock
        # leading because skipping the gump lookup is the point. The clock only restarts
        # once it has looked, so a missing hotbar behind an open cursor is tried again on
        # the next pass.
        # --------------------------------------------------------------------------------
        if timer "timer__hotbar_check" >= interval__hotbar_check
            if skill "Necromancy" > 0 and not gumpexists 622436516
                if not targetexists and not casting
                    settimer "timer__hotbar_check" 0

                    if findtype 'necromancer book' backpack
                        yell '[necromancyhotbar'
                        waitforgump 622436516 wait__hotbar_gump
                    elseif timer "timer__message" >= interval__message
                        overhead "[ necro book, out ]" 254
                        settimer "timer__message" 0
                    endif
                endif
            else
                settimer "timer__hotbar_check" 0
            endif
        endif

        # --------------------------------------------------------------------------------
        # STAT POTIONS                                           module/buff/potions.razor
        #
        # Kept up while var__fighting is 1. Strength and Agility read the stat against
        # config__str_potion and config__dex_potion, because Bless and the Strength and
        # Agility spells show the same icons as the potions, and each is tried once per
        # interval__stat_potion. Magic Resist has an icon of its own and is drunk once it
        # is missing. Each potion is judged on its own, so running out of one does not
        # hold up the others.
        # --------------------------------------------------------------------------------
        if var__fighting = 1 and config__use_potions = 1 and not paralyzed and not hidden and not targetexists
            if not queued and str < config__str_potion and timer "timer__str_potion" >= interval__stat_potion
                settimer "timer__str_potion" 0
                if findtype "White Potion" self
                    hotkey "Drink Strength"
                    wait wait__short
                endif
            endif
            if not queued and dex < config__dex_potion and timer "timer__agi_potion" >= interval__stat_potion
                settimer "timer__agi_potion" 0
                if findtype "Blue Potion" self
                    hotkey "Drink Agility"
                    wait wait__short
                endif
            endif
            if config__use_resist_potion = 1 and not queued and not findbuff "Magic Resist Potion"
                if findtype "Black Potion" self
                    hotkey "Drink Magic Resist"
                    wait wait__short
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # SUMMON NAMES                                     module/necro/summon-names.razor
        #
        # A fresh summon still wears its stock name, "a lich" and so on, and is renamed to
        # the last word of it: lich, mummy, thrall, witch, zombie, ghost, skeleton,
        # knight, mage, ghoul, corpse. Nothing here casts or opens a cursor, so it runs
        # engaged or not, one rename per run. A clock group such as every
        # interval__housekeeping keeps it off most passes.
        #
        # Summons are found by body id, because Razor may keep the old name cached after a
        # rename and the body never changes. The kind is read off the label once, before
        # the rename, and its name comes out of list__summon_kinds by index. A renamed
        # summon still matches its body, so its serial goes into list__named_summons and
        # the walk skips it from then on. The list is emptied once no follower is left.
        # The noto test keeps own summons only: they read friend, and another player's
        # summon reads innocent unless that player is guild or allied.
        # --------------------------------------------------------------------------------
        if followers > 0
            @setvar! var__fresh_summon 0

            # Bodies. Lich 24 and ancient mummy 158 read off >info, vampire thrall 722 and rag
            # witch 740 from the old bard-necro follower cache, and the Summon Creature undead
            # pool as far as the stock client art goes, zombie 3, ghost 26, skeleton 50, 56, 57,
            # skeletal knight 147, skeletal mage 148, ghoul 153, rotting corpse 155. Skeletal
            # Fiend, skeletal marksman and rotting flesh are Outlands bodies: read theirs with
            # >info when one is out and add the number here, and its name below. The plain
            # elementals and daemon a summon gives without Vengeful Spirit, 9 and 13 to 16, are
            # left out: other mages' elementals on screen were taken for our own, a guildmate's
            # among them, which the noto test cannot tell apart.
            # Walk every match, not just the first: this Razor hands back the same mobile on
            # every call. Each rejected match is ignored for the rest of the walk, and the
            # ignore list is emptied again so the rest of the loop sees everything.
            while findtype 24|158|722|740|3|26|50|56|57|147|148|153|155 ground -1 -1 config__summon_range as alias__fresh_summon
                @setvar! var__summon_seen alias__fresh_summon

                if not inlist 'list__named_summons' var__summon_seen
                    if not dead alias__fresh_summon and noto alias__fresh_summon != "hostile" and noto alias__fresh_summon != "criminal" and noto alias__fresh_summon != "enemy" and noto alias__fresh_summon != "murderer" and noto alias__fresh_summon != "innocent"
                        @setvar! var__fresh_summon alias__fresh_summon
                        break
                    endif
                endif

                @ignore alias__fresh_summon
            endwhile

            @clearignore

            if var__fresh_summon != 0
                pushlist 'list__named_summons' var__fresh_summon
                getlabel var__fresh_summon label__fresh_summon
                @setvar! var__summon_kind 99

                # A phrase of each stock name, in the order of list__summon_kinds.
                if "skeletal knight" in label__fresh_summon
                    @setvar! var__summon_kind 0
                elseif "skeletal mage" in label__fresh_summon
                    @setvar! var__summon_kind 1
                elseif "lich" in label__fresh_summon
                    @setvar! var__summon_kind 2
                elseif "mummy" in label__fresh_summon
                    @setvar! var__summon_kind 3
                elseif "thrall" in label__fresh_summon
                    @setvar! var__summon_kind 4
                elseif "witch" in label__fresh_summon
                    @setvar! var__summon_kind 5
                elseif "zombie" in label__fresh_summon
                    @setvar! var__summon_kind 6
                elseif "ghost" in label__fresh_summon
                    @setvar! var__summon_kind 7
                elseif "skeleton" in label__fresh_summon
                    @setvar! var__summon_kind 8
                elseif "ghoul" in label__fresh_summon
                    @setvar! var__summon_kind 9
                elseif "rotting corpse" in label__fresh_summon
                    @setvar! var__summon_kind 10
                endif

                foreach summon_kind in list__summon_kinds
                    if index = var__summon_kind
                        @rename var__fresh_summon summon_kind

                        if config__chatty = 1
                            overhead "[ name, {{summon_kind}} ]" 209 var__fresh_summon
                        endif
                    endif
                endfor
            endif
        else
            clearlist 'list__named_summons'
        endif

        # --------------------------------------------------------------------------------
        # GOLD                                                 module/pack/gold-drop.razor
        #
        # One drop per pass, so recovery still runs between drops. A refused drop goes
        # back to the pack.
        # --------------------------------------------------------------------------------
        if weight > maxweight
            if not hidden and not queued and not casting and not targetexists
                if findtype "gold coin" backpack as alias__found_gold
                    lift alias__found_gold config__gold_drop_amount
                    droprelloc 0 0
                    if config__sysmsg = 1
                        sysmsg "Gold drop: up to {{config__gold_drop_amount}} at your feet, weight over max." 88
                    endif
                    wait wait__short

                    if insysmsg "cannot drop anything"
                        drop backpack -1 -1 -1
                    endif

                    wait wait__gold_drop
                    if config__chatty = 1
                        overhead "[ gold, dropped ]" 290
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ weight, over ]" 254
                    settimer "timer__message" 0
                endif
            endif
        endif
    endif

    if var__fighting = 1
        # --------------------------------------------------------------------------------
        # DISCO                                                    module/bard/disco.razor
        #
        # Discordance runs about two minutes and does not break, so it is applied once per
        # target and then left alone. It goes before Peace because Ensemble wants Discord
        # AND Peace on the same creature, and the one that does not break is worth landing
        # first. bard-mace leads with Peace instead, and for a dexxer that is right: Peace
        # is what stops the mob hitting the player in melee. Here the followers hold the
        # mob and the player is ten tiles back, so the debuff outranks the pacify. Skill
        # is 80 on both, so the odds are the same either way and the order is only about
        # which effect is worth more.
        #
        # Music is shared with bard/peace, so whichever of the two fires first stands the
        # other down until the next pass. That is the arbitration, no extra state needed.
        #
        # warmode is the manual control window, tested on the gate line with the
        # instrument. A target whose label already shows discord is remembered in
        # var__disco_seen and forgotten once interval__disco_seen has run, instead of a
        # find and a getlabel a pass.
        # --------------------------------------------------------------------------------
        # Forget the target seen discorded, so its label is read again.
        if timer "timer__disco_seen" >= interval__disco_seen
            @setvar! var__disco_seen 0
        endif

        if var__combat_target != var__disco_seen and cooldown "disco" = 0 and cooldown "music" = 0 and skill "Discordance" > 0 and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
            if find var__combat_target ground -1 -1 config__target_range as alias__disco_target
                getlabel alias__disco_target label__disco_target

                if "discord" in label__disco_target
                    @setvar! var__disco_seen var__combat_target
                    settimer "timer__disco_seen" 0
                else
                    useskill 'Discordance'
                    waitfortarget wait__bard_target

                    # Answered once, before the delivery loop. Razor asks for an
                    # instrument only when its cached one is gone, and answering it
                    # makes the skill open the real target cursor, so the wait is
                    # simply repeated. replay is documented as restarting the whole
                    # script from the top, which would re-run the entire setup.
                    if insysmsg "What instrument shall you play"
                        target var__my_instrument
                        waitfortarget wait__bard_target

                        if insysmsg "That is not a musical instrument"
                            @setvar! var__my_instrument 0
                        endif
                    endif

                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__disco_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    while targetexists
                        if dead alias__disco_target or var__combat_target != alias__disco_target
                            hotkey "Cancel Current Target"
                            wait wait__short
                        else
                            target alias__disco_target
                            wait wait__short
                        endif
                    endwhile

                    wait wait__short
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # PEACE                                                    module/bard/peace.razor
        #
        # The other half of the Ensemble condition, and unlike Discordance it is short. At
        # difficulty 300 and up the duration formula floors at 15 x Musicianship / 100,
        # which is 12 seconds here, against a 10 second slot cooldown. So it is re-applied
        # continuously rather than once per target: let it lapse and Ensemble and Virtuoso
        # go dark with it.
        #
        # A pacified creature does not attack, and taking damage does NOT break that. Only
        # a barding break does, and while one is running neither Peace nor Provocation can
        # land on that creature, which is why a broken target is left alone until it
        # clears.
        #
        # Either label is then waited out on interval__peace_seen instead of a find and a
        # getlabel on every pass. A barding break runs 40 seconds, so it is read every two
        # seconds rather than on every pass, and Peace lands at most two seconds after it
        # clears.
        # --------------------------------------------------------------------------------
        if timer "timer__peace_seen" >= interval__peace_seen and cooldown "peace/provo" = 0 and cooldown "music" = 0 and skill "Peacemaking" > 0 and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
            if find var__combat_target ground -1 -1 config__target_range as alias__peace_target
                getlabel alias__peace_target label__peace_target

                if "pacified" in label__peace_target or "barding break" in label__peace_target
                    settimer "timer__target_grace" 0
                    settimer "timer__peace_seen" 0
                else
                    useskill 'Peacemaking'
                    waitfortarget wait__bard_target

                    # Answered once, before the delivery loop. Razor asks for an
                    # instrument only when its cached one is gone, and answering it
                    # makes the skill open the real target cursor, so the wait is
                    # simply repeated. replay is documented as restarting the whole
                    # script from the top, which would re-run the entire setup.
                    if insysmsg "What instrument shall you play"
                        target var__my_instrument
                        waitfortarget wait__bard_target

                        if insysmsg "That is not a musical instrument"
                            @setvar! var__my_instrument 0
                        endif
                    endif

                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__peace_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    while targetexists
                        if dead alias__peace_target or var__combat_target != alias__peace_target
                            hotkey "Cancel Current Target"
                            wait wait__short
                        else
                            target alias__peace_target
                            wait wait__short
                        endif
                    endwhile

                    wait wait__short
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # NECRO BURST                                             module/necro/burst.razor
        #
        # Each ability goes out through its Razor hotkey, resolves without a cursor, and
        # answers with either "unholy symbols remaining" or the cooldown line, so success
        # is read rather than assumed. The combat three run as one chain in value order,
        # one per pass, so the bank is re-read between them and a lower one never spends
        # what a higher one was saving.
        #
        #   blood oath     +30% follower damage, 5 self damage. The followers are 63% of the
        #                  damage, so this outweighs everything else in this block
        #   corpse skin    every damaging spell adds a disease worth 25% over 30 seconds
        #   evil omen      +20% spell damage, and a 25% chance per spell of half its mana in
        #                  self damage. Below Corpse Skin: smaller bonus with a cost attached
        #
        # Of the rest, Strangle (4) competes with Blood Oath for symbols and delays every
        # hit by five seconds, Wither (5) buys mana only for spells that do no damage, and
        # Pain Spike (5) wants a corpse next to the next mob. None earn a place here.
        #
        # Corpse Skin and Evil Omen only pay off through the loop's own spells, and the
        # loop casts no damage spell while the player is walking or has taken over in
        # warmode. So both wait for a standing player in automatic mode: the first stop
        # after a move opens them together with the procs instead of burning their
        # duration on the walk. Blood Oath feeds the followers, who fight on either way,
        # so it takes neither guard, and the two guards sit on the Corpse Skin and Evil
        # Omen lines instead of on the block. necro/vampiric-embrace has no walk guard
        # either: it is walk only, so one would have parked it for good.
        # --------------------------------------------------------------------------------
        # Set when an ability lands. necro/poison-strike sits out any pass that spent, since the
        # list is only rebuilt on the next pass.
        @setvar! var__symbols_spent 0

        if list 'list__necro_symbols' >= config__symbols_blood_oath and followers > 0 and timer "timer__blood_oath" >= interval__necro_action and not targetexists and not casting
            hotkey 'Blood Oath'
            wait wait__message

            if insysmsg "unholy symbols remaining"
                settimer "timer__blood_oath" 0
                @setvar! var__symbols_spent 1

                if config__chatty = 1
                    overhead "[ blood oath ]" 219
                endif
            elseif insysmsg "seconds before you may use that ability again."
                settimer "timer__blood_oath" 0
            endif
        elseif list 'list__necro_symbols' >= config__symbols_corpse_skin and not warmode and timer "timer__corpse_skin" >= interval__necro_action and cooldown "walk" = 0 and not targetexists and not casting
            hotkey 'Corpse Skin'
            wait wait__message

            if insysmsg "unholy symbols remaining"
                settimer "timer__corpse_skin" 0
                @setvar! var__symbols_spent 1

                if config__chatty = 1
                    overhead "[ corpse skin ]" 219
                endif
            elseif insysmsg "seconds before you may use that ability again."
                settimer "timer__corpse_skin" 0
            endif
        elseif list 'list__necro_symbols' >= config__symbols_evil_omen and not warmode and timer "timer__evil_omen" >= interval__necro_action and cooldown "walk" = 0 and not targetexists and not casting
            hotkey 'Evil Omen'
            wait wait__message

            if insysmsg "unholy symbols remaining"
                settimer "timer__evil_omen" 0
                @setvar! var__symbols_spent 1

                if config__chatty = 1
                    overhead "[ evil omen ]" 219
                endif
            elseif insysmsg "seconds before you may use that ability again."
                settimer "timer__evil_omen" 0
            endif
        endif

        # --------------------------------------------------------------------------------
        # OPENER                                                module/magery/opener.razor
        #
        # Mana Drain then Curse, once per target.
        #
        # Both spells carry a Grimoire rider that is scoped to the creature they were cast
        # on: Curse gives every spell of ours +30% against that target for 60 seconds,
        # Mana Drain gives a 30% refund chance on hostile spells against it. Neither
        # follows to the next mob, which is why membership is tracked per target and not
        # as a global stage.
        #
        # Two lists, so the branch itself is the state. A target that was retargeted mid
        # fight answers correctly with no extra bookkeeping.
        #
        # First, any disturb line nobody read is read off here, so the cursor polls from
        # here to magery/filler only ever see their own.
        # --------------------------------------------------------------------------------
        # The Grimoire riders on Curse and Mana Drain run 60 seconds while the debuff icon runs
        # two minutes, so the lists have to expire on a clock rather than on the icon. Sweeping
        # both at once re-opens on a target that was done seconds ago, which costs 22 mana now
        # and then. Per target timestamps would need arithmetic, which Razor does not have.
        if timer "timer__magic_window" >= interval__magic_window
            clearlist 'list__magic_drained_targets'
            clearlist 'list__magic_cursed_targets'
            settimer "timer__magic_window" 0
        endif

        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
            # consumed, nothing else to do
        endif

        if not inlist 'list__magic_drained_targets' var__combat_target and var__regs_mana_drain = 1 and mana >= config__mana_4th and not warmode and not targetexists and not casting and cooldown "walk" = 0
            if find var__combat_target ground -1 -1 config__target_range as alias__opener_target
                cast 'Mana Drain'

                for 60
                    if targetexists
                        break
                    endif

                    if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                        break
                    endif

                    if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                        if config__chatty = 1
                            overhead "[ drain, cut ]" 254
                        endif

                        hotkey "> Interrupt"
                        break
                    endif

                    wait wait__poll
                endfor

                if targetexists
                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__opener_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    if dead alias__opener_target or var__combat_target != alias__opener_target
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        target alias__opener_target
                        wait wait__cast

                        if insysmsg "cannot be seen"
                            # not delivered, so the target stays off the list
                        else
                            pushlist 'list__magic_drained_targets' var__combat_target

                        endif
                    endif
                endif
            endif
        elseif not inlist 'list__magic_cursed_targets' var__combat_target and var__regs_curse = 1 and mana >= config__mana_4th and not warmode and not targetexists and not casting and cooldown "walk" = 0
            if find var__combat_target ground -1 -1 config__target_range as alias__opener_target
                cast 'Curse'

                for 60
                    if targetexists
                        break
                    endif

                    if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                        break
                    endif

                    if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                        if config__chatty = 1
                            overhead "[ curse, cut ]" 254
                        endif

                        hotkey "> Interrupt"
                        break
                    endif

                    wait wait__poll
                endfor

                if targetexists
                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__opener_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    if dead alias__opener_target or var__combat_target != alias__opener_target
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        target alias__opener_target
                        wait wait__cast

                        if insysmsg "cannot be seen"
                            # not delivered, so the target stays off the list
                        else
                            pushlist 'list__magic_cursed_targets' var__combat_target
                            settimer "timer__magic_window" 0

                        endif
                    endif
                endif
            endif
        endif

        # The rotation waits for Curse, because everything after it is worth 30% more once it
        # has landed. The one thing it does not wait for is a reagent that is not coming back
        # until the next restock: with no Curse reagents the damage goes out without the rider
        # rather than the script standing still in front of a live target.
        #
        # Low mana is deliberately NOT an escape. It regenerates, the followers carry the fight
        # meanwhile, and every point dribbled into an uncursed Magic Arrow is a point the next
        # opener does not have. Waiting for 22 mana and casting with the rider is the better trade.
        if inlist 'list__magic_cursed_targets' var__combat_target
            @setvar! var__opener_done 1
        elseif var__regs_curse = 0
            @setvar! var__opener_done 1
        else
            @setvar! var__opener_done 0
        endif

        # --------------------------------------------------------------------------------
        # PROC CORE                                          module/magery/proc-core.razor
        #
        # The four Grimoire proc spells. Each carries a large first cast bonus on its own
        # timer, and the game announces when that timer is back, so cooldowns.xml already
        # tracks them and this block simply reads the bars. No timer of our own, which
        # also means the script inherits any cooldown reset the game hands out.
        #
        #   magic arrow  +250% on the first cast in the window
        #   harm         +250%
        #   fireball     +250% as a burn over 15 seconds
        #   lightning    +200% and a hinder
        #
        # Ordered cheapest first. They rarely compete, because a spell whose bar is up is
        # the only one asking, but when two are ready together the cheap one going first
        # keeps more mana available for the opener on the next mob.
        #
        # Each delivery records its mob in var__proc_target, and the flag after this block
        # tells Poison Strike and the filler whether the core is spent. Both wait for it.
        # --------------------------------------------------------------------------------
        if cooldown "magic arrow" = 0 and var__regs_magic_arrow = 1 and mana >= config__mana_1st and var__opener_done = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0
            if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                cast 'Magic Arrow'

                for 60
                    if targetexists
                        break
                    endif

                    if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                        break
                    endif

                    if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                        if config__chatty = 1
                            overhead "[ magic arrow, cut ]" 254
                        endif

                        hotkey "> Interrupt"
                        break
                    endif

                    wait wait__poll
                endfor

                if targetexists
                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    if dead alias__proc_target or var__combat_target != alias__proc_target
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        target alias__proc_target
                        wait wait__cast
                        @setvar! var__proc_target var__combat_target
                    endif
                endif
            endif
        elseif cooldown "harm" = 0 and var__regs_harm = 1 and mana >= config__mana_2nd and var__opener_done = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0
            if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                cast 'Harm'

                for 60
                    if targetexists
                        break
                    endif

                    if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                        break
                    endif

                    if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                        if config__chatty = 1
                            overhead "[ harm, cut ]" 254
                        endif

                        hotkey "> Interrupt"
                        break
                    endif

                    wait wait__poll
                endfor

                if targetexists
                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    if dead alias__proc_target or var__combat_target != alias__proc_target
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        target alias__proc_target
                        wait wait__cast
                        @setvar! var__proc_target var__combat_target
                    endif
                endif
            endif
        elseif cooldown "fireball" = 0 and var__regs_fireball = 1 and mana >= config__mana_3rd and var__opener_done = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0
            if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                cast 'Fireball'

                for 60
                    if targetexists
                        break
                    endif

                    if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                        break
                    endif

                    if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                        if config__chatty = 1
                            overhead "[ fireball, cut ]" 254
                        endif

                        hotkey "> Interrupt"
                        break
                    endif

                    wait wait__poll
                endfor

                if targetexists
                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    if dead alias__proc_target or var__combat_target != alias__proc_target
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        target alias__proc_target
                        wait wait__cast
                        @setvar! var__proc_target var__combat_target
                    endif
                endif
            endif
        elseif cooldown "lightning" = 0 and var__regs_lightning = 1 and mana >= config__mana_4th and var__opener_done = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0
            if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                cast 'Lightning'

                for 60
                    if targetexists
                        break
                    endif

                    if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                        break
                    endif

                    if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                        if config__chatty = 1
                            overhead "[ lightning, cut ]" 254
                        endif

                        hotkey "> Interrupt"
                        break
                    endif

                    wait wait__poll
                endfor

                if targetexists
                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    if dead alias__proc_target or var__combat_target != alias__proc_target
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        target alias__proc_target
                        wait wait__cast
                        @setvar! var__proc_target var__combat_target
                    endif
                endif
            endif
        endif

        # Poison Strike and the filler wait for the whole proc core. Every proc that lands while
        # Corpse Skin is up leaves its disease on the target, so a strike after Magic Arrow alone
        # pops one stack where four were on the way, and a bolt cast while a proc is ready pushes
        # that proc and its next window back by a whole cast.
        #
        # This has to be a flag. A cast does not end the pass, so every block below still gets
        # its turn, which is how both used to go out straight behind Curse and the first proc.
        #
        # 1 once no proc is ready, each one either on its bar or out of reagents. A missing
        # reagent is the same escape the opener takes, it is not coming back until the next
        # restock. Low mana is not, for the reason given at the opener. Read after the proc core
        # has had its turn, so a proc cast this pass already counts. A bar whose message has not
        # arrived yet reads as ready, which only holds both back one pass.
        if cooldown "magic arrow" = 0 and var__regs_magic_arrow = 1
            @setvar! var__procs_done 0
        elseif cooldown "harm" = 0 and var__regs_harm = 1
            @setvar! var__procs_done 0
        elseif cooldown "fireball" = 0 and var__regs_fireball = 1
            @setvar! var__procs_done 0
        elseif cooldown "lightning" = 0 and var__regs_lightning = 1
            @setvar! var__procs_done 0
        else
            @setvar! var__procs_done 1
        endif

        # --------------------------------------------------------------------------------
        # FILLER                                                module/magery/filler.razor
        #
        # The four proc spells spend about 4.3 seconds of a 15 second window and then
        # wait, so roughly two thirds of the window used to go unused. Energy Bolt has no
        # proc timer of its own, and its Grimoire upgrade adds 30% damage and hands back
        # 15 of its 20 mana when the target dies within five seconds, so it is the one
        # spell worth firing purely to fill that gap.
        #
        # Only that gap: var__procs_done keeps it out while any proc is ready, so a bar
        # coming back hands the next cast to the proc core. A bar that returns mid bolt
        # waits out the rest of the cast, 1.95 seconds at most. Poison Strike comes after
        # this block, so a bolt in the same pass adds its disease before the strike pops
        # them.
        #
        # It is also the first thing to stand down when mana runs short, which is what
        # config__filler_floor is for: the opener and one full proc cycle come first.
        # --------------------------------------------------------------------------------
        if var__procs_done = 1 and mana > config__filler_floor and var__regs_energy_bolt = 1 and var__opener_done = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0
            if find var__combat_target ground -1 -1 config__target_range as alias__filler_target
                cast 'Energy Bolt'

                for 60
                    if targetexists
                        break
                    endif

                    if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                        break
                    endif

                    if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                        if config__chatty = 1
                            overhead "[ eb, cut ]" 254
                        endif

                        hotkey "> Interrupt"
                        break
                    endif

                    wait wait__poll
                endfor

                if targetexists
                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__filler_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    if dead alias__filler_target or var__combat_target != alias__filler_target
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        target alias__filler_target
                        wait wait__cast
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # POISON STRIKE                                   module/necro/poison-strike.razor
        #
        # One symbol to resolve the disease Corpse Skin has been layering on the target:
        # up to eight ticks land at once instead of over the next thirty seconds. On a mob
        # about to die that is damage that would otherwise have gone with it. It sits at
        # the bottom of the symbol ladder and only fires while Corpse Skin is actually up.
        #
        # It goes once the proc core is spent, var__procs_done, and last in the pass,
        # behind the filler. Every damaging spell leaves one disease, so when the pass
        # that spends the core also has the mana for a bolt, the strike pops four procs
        # and a bolt instead of four. Below the filler floor there is no bolt coming, and
        # it pops the four rather than wait. var__proc_target holds it off a mob picked up
        # while the bars are still running from the last one: no proc has reached that mob
        # yet, so the strike waits until the next cycle has gone out there.
        #
        # A target with nothing on it refuses the strike without spending it. Clearing
        # var__proc_target then makes it wait for the next proc to reach that mob, rather
        # than pressing again every pass or sitting out the full window. A cooldown
        # refusal restarts the window, read on both sides of the cursor wait in case it
        # comes back instead of the cursor.
        # --------------------------------------------------------------------------------
        if timer "timer__poison_strike" >= interval__necro_action and var__procs_done = 1 and var__opener_done = 1 and var__proc_target = var__combat_target and var__symbols_spent = 0 and timer "timer__corpse_skin" < interval__necro_action and not warmode and list 'list__necro_symbols' >= config__symbols_poison_strike and not targetexists and not casting
            if find var__combat_target ground -1 -1 config__target_range as alias__strike_target
                # A bolt from the filler hits 0.5 seconds after its target and brings
                # its disease then (blueprint/pvp.html part 5). wait__cast covered 0.3 of
                # that and this covers the rest, so on a quick connection the strike
                # does not land ahead of the bolt.
                wait wait__short
                hotkey 'Poison Strike'
                waitfortarget wait__ability_target

                if targetexists
                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__combat_target alias__fresh_target
                                settimer "timer__target_grace" 0

                                if find var__combat_target ground -1 -1 config__target_range as alias__strike_target
                                    if config__chatty = 1
                                        overhead "[ target, set ]" 1288 var__combat_target
                                    endif
                                endif
                            endif
                        endif
                    endif

                    if var__combat_target != alias__strike_target
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        target alias__strike_target
                        wait wait__message

                        if insysmsg "unholy symbols remaining"
                            settimer "timer__poison_strike" 0

                            if config__chatty = 1
                                overhead "[ poison strike ]" 219
                            endif
                        elseif insysmsg "seconds before you may use that ability again."
                            settimer "timer__poison_strike" 0
                        elseif insysmsg "You do not have a poison or disease effect on that target."
                            @setvar! var__proc_target 0
                        endif
                    endif
                elseif insysmsg "seconds before you may use that ability again."
                    settimer "timer__poison_strike" 0
                endif
            endif
        endif
    else
        # --------------------------------------------------------------------------------
        # MUSHROOM                                              module/buff/mushroom.razor
        #
        # Meant for the walk, outside the fight group, so the 60 second cooldown burns
        # then rather than during a fight where the cast would compete with the spell
        # rotation. The whole block either eats or casts, so the walk guard rides on the
        # act window line.
        # --------------------------------------------------------------------------------
        if mana <= config__mushroom_eat_mana and not targetexists and not casting and cooldown "walk" = 0 and not findbuff 'Magic Mushroom Cooldown' and findtype "mushroom" backpack
            hotkey 'Eat Magic Mushroom'
            wait wait__short
        elseif mana >= config__mushroom_create_mana and var__regs_create_food = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0 and counttype "mushroom" backpack < config__mushroom_min_count
            cast 'Create Food'
            wait wait__short

            for 60
                if not casting
                    break
                endif

                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                    break
                endif

                wait wait__poll
            endfor
        endif

        # --------------------------------------------------------------------------------
        # SELF BUFFS                                              module/buff/spells.razor
        #
        # Reactive Armor, then Magic Reflection, whenever one is missing and the window is
        # free. Not started at config__buff_max_loss, and cut there mid cast so the next
        # pass can heal. With config__buff_when_poisoned 0 poison holds them back and cuts
        # them too, so the cure goes first. var__hold_casts lets another block keep the
        # cast window (a latched Recall). config__walk_guard and config__warmode_is_manual
        # apply as for the heal agents. The reflect bar is the server's recast lock after
        # Reflect is used up.
        # --------------------------------------------------------------------------------
        if config__use_magery = 1 and var__hold_casts = 0 and not paralyzed and not hidden and not queued and not casting and not targetexists and diffhits < config__buff_max_loss
            if config__buff_when_poisoned = 1 or not poisoned
                if config__warmode_is_manual = 0 or not warmode
                    if config__walk_guard = 0 or cooldown "walk" = 0
                        if config__use_reactive_armor = 1 and var__regs_reactive_armor = 1 and mana >= config__mana_reactive_armor and not findbuff "Reactive Armor"
                            cast "Reactive Armor"
                            @setvar! var__buff_cast 1
                            if config__sysmsg = 1
                                sysmsg "Buff: Reactive Armor." 88
                            endif
                            wait wait__short

                            for 60
                                if not casting
                                    break
                                endif
                                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                    break
                                endif
                                if diffhits >= config__buff_max_loss
                                    hotkey "> Interrupt"
                                    break
                                endif
                                if config__buff_when_poisoned = 0 and poisoned
                                    hotkey "> Interrupt"
                                    break
                                endif
                                wait wait__poll
                            endfor
                        elseif config__use_magic_reflect = 1 and var__regs_magic_reflect = 1 and mana >= config__mana_magic_reflect and cooldown "reflect" = 0 and not findbuff "Magic Reflection"
                            cast "Magic Reflection"
                            @setvar! var__buff_cast 1
                            if config__sysmsg = 1
                                sysmsg "Buff: Magic Reflection." 88
                            endif
                            wait wait__short

                            for 60
                                if not casting
                                    break
                                endif
                                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                                    break
                                endif
                                if diffhits >= config__buff_max_loss
                                    hotkey "> Interrupt"
                                    break
                                endif
                                if config__buff_when_poisoned = 0 and poisoned
                                    hotkey "> Interrupt"
                                    break
                                endif
                                wait wait__poll
                            endfor
                        endif
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # SPELL SIPHON                                    module/magery/spell-siphon.razor
        #
        # The first spell to hit us starts a sixty minute buff that shows on the buff bar.
        # A Magic Arrow on self is that hit. Never with Magic Reflection up, the arrow
        # would only bounce off it and burn the reflection. Any disturb line an earlier
        # cast left is read off first, so the poll only sees its own. Before self is
        # targeted, lasttarget is read once more, the way bard/song does.
        #
        # It goes on a pass when buff/spells cast nothing, var__buff_cast, so Reactive
        # Armor and Magic Reflection come first. Then it clears the flag for the next
        # pass.
        # --------------------------------------------------------------------------------
        if var__buff_cast = 0 and not findbuff 'Spell Siphon' and not findbuff 'Magic Reflection' and var__regs_magic_arrow = 1 and mana >= config__mana_1st and not warmode and not targetexists and not casting and cooldown "walk" = 0
            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                # consumed, nothing else to do
            endif

            cast 'Magic Arrow'

            for 60
                if targetexists
                    break
                endif

                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                    break
                endif

                wait wait__poll
            endfor

            if targetexists
                @setvar! var__keep_lasttarget 0

                if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                    if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                        if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                            @setvar! var__keep_lasttarget 1
                        endif
                    endif
                endif

                if var__keep_lasttarget = 1
                    hotkey "Cancel Current Target"
                    wait wait__short
                else
                    hotkey 'Target Self'
                    wait wait__cast
                endif
            endif
        endif

        @setvar! var__buff_cast 0

        # --------------------------------------------------------------------------------
        # BARD SONG                                                 module/bard/song.razor
        #
        # Three 15 minute AoE buffs, each worth 8.5% at this Effective Barding, landing on
        # the player and every follower in range. Sung on the walk between pulls, never in
        # a fight: while engaged, Discordance and Peacemaking keep Music busy so a song
        # rarely gets a window, and playing an instrument interrupts a spell already in
        # flight.
        #
        # Singing on the walk is what removes follower tracking from this script. A
        # resummoned creature picks the songs up on the next walk, so nothing has to
        # notice that it died.
        #
        # findbuff is deliberately NOT the gate. The buffs run 15 minutes, so a findbuff
        # test would be true almost always and the refresh would never fire. The gate is
        # the song cooldown plus the slot each song borrows.
        #
        # A branch only advances var__song_next once the cursor was actually delivered, so
        # a song that could not go out, for any reason, is retried next pass instead of
        # being skipped.
        #
        # The chain only picks the skill and the song after it, the three share the rest.
        # Right before the backpack is targeted, lasttarget is read once more: a hostile
        # the player has just picked would be lost to the backpack, the way a green capper
        # was on 2026-09-29. Then the song stands down, cancels its cursor and leaves
        # lasttarget for the next pass.
        # --------------------------------------------------------------------------------
        if cooldown "song" = 0 and cooldown "music" = 0 and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
            @setvar! var__song_after 0

            if var__song_next = 1 and skill "Discordance" > 0 and cooldown "disco" = 0
                useskill 'Discordance'
                @setvar! var__song_after 2
            elseif var__song_next = 2 and skill "Peacemaking" > 0 and cooldown "peace/provo" = 0
                useskill 'Peacemaking'
                @setvar! var__song_after 3
            elseif var__song_next = 3 and skill "Provocation" > 0 and cooldown "peace/provo" = 0
                useskill 'Provocation'
                @setvar! var__song_after 1
            endif

            if var__song_after != 0
                waitfortarget wait__bard_target

                if insysmsg "What instrument shall you play"
                    target var__my_instrument
                    waitfortarget wait__bard_target

                    if insysmsg "That is not a musical instrument"
                        @setvar! var__my_instrument 0
                    endif
                endif

                if targetexists
                    @setvar! var__keep_lasttarget 0

                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__keep_lasttarget 1
                            endif
                        endif
                    endif

                    if var__keep_lasttarget = 1
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        target backpack
                        @setvar! var__song_next var__song_after
                    endif
                endif
            endif
        endif

        # --------------------------------------------------------------------------------
        # VAMPIRIC EMBRACE                             module/necro/vampiric-embrace.razor
        #
        # Vampiric Embrace heals the undead followers off a corpse. Target an enemy or
        # yourself and it searches the surrounding area for one, so the cursor is answered
        # with self. Walk only, when a corpse is what is left of the last pull, and the
        # corpse check keeps it from pressing for nothing. The wiki gives no radius for
        # that search, so a corpse inside the eight tiles looked at here can still be out
        # of reach. That refusal spends nothing, so it only sits out
        # interval__embrace_miss.
        #
        # A cooldown refusal restarts the window instead: the script cannot read the
        # game's own cooldown, and the refusal nearly always answers a use whose success
        # line came in late, so a full window from there is about right. It is read on
        # both sides of the cursor wait, in case it comes back instead of the cursor.
        # Before self is targeted, lasttarget is read once more, the way bard/song does,
        # so a hostile just picked is not lost.
        # --------------------------------------------------------------------------------
        if timer "timer__vampiric_embrace" >= interval__necro_action and timer "timer__embrace_miss" >= interval__embrace_miss and followers > 0 and not warmode and list 'list__necro_symbols' >= config__symbols_vampiric_embrace and not targetexists and not casting
            if findtype 8198 ground -1 -1 8
                hotkey 'Vampiric Embrace'
                waitfortarget wait__ability_target

                if targetexists
                    @setvar! var__keep_lasttarget 0

                    if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                        if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                            if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                                @setvar! var__keep_lasttarget 1
                            endif
                        endif
                    endif

                    if var__keep_lasttarget = 1
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        hotkey 'Target Self'
                        wait wait__message

                        if insysmsg "unholy symbols remaining"
                            settimer "timer__vampiric_embrace" 0

                            if config__chatty = 1
                                overhead "[ vampiric embrace ]" 219
                            endif
                        elseif insysmsg "seconds before you may use that ability again."
                            settimer "timer__vampiric_embrace" 0
                        elseif insysmsg "You do not see any corpses near that location."
                            settimer "timer__embrace_miss" 0
                        endif
                    endif
                elseif insysmsg "seconds before you may use that ability again."
                    settimer "timer__vampiric_embrace" 0
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # END OF PASS                                                        module/base.razor
    # ------------------------------------------------------------------------------------
    wait wait__poll
endwhile
