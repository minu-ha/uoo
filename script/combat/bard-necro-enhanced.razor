@setvar! var__regs_magic_reflect 0
@setvar! var__regs_magic_arrow 0
@setvar! var__regs_harm 0
@setvar! var__regs_fireball 0
@setvar! var__regs_lightning 0
@setvar! var__regs_curse 0
@setvar! var__regs_mana_drain 0
@setvar! var__regs_energy_bolt 0
@setvar! var__has_black_pearl 0
@setvar! var__has_garlic 0
@setvar! var__has_ginseng 0
@setvar! var__has_mandrake 0
@setvar! var__has_nightshade 0
@setvar! var__has_ash 0
@setvar! var__has_silk 0


# ----------------------------------------------------------------------------------------
# module/necro/symbols.razor
#
#   var__symbols_listed
#      The reading the list was last filled from. 99 matches no reading, so the first pass
#      fills the list whatever a previous run left in it.
#
#   var__symbols_spent
#      Scratch: 1 once a necro ability spent symbols on this pass. Poison Strike sits that
#      pass out, since the list is only rebuilt on the next one.
# ----------------------------------------------------------------------------------------
@setvar! var__symbols_listed 99
@setvar! var__symbols_spent 0


# ----------------------------------------------------------------------------------------
# module/bard/instrument.razor
#
#   var__my_instrument
#      The instrument the bard skills play, kept across Plays. 0 when none.
#
#   var__instrument_ok
#      1 while the instrument was in the backpack at the last check. The bard blocks test
#      it with not warmode and var__my_instrument.
# ----------------------------------------------------------------------------------------
if not varexist var__my_instrument
    @setvar! var__my_instrument 0
endif
@setvar! var__instrument_ok 0


# ----------------------------------------------------------------------------------------
# module/necro/summon-names.razor
#
#   var__summon_seen
#      Scratch: the match the walk is looking at, copied out of its alias for inlist.
#
#   var__fresh_summon
#      Scratch: the first own summon not named yet, 0 for none.
#
#   var__summon_kind
#      Scratch: the kind read off its label, as an index into list__summon_kinds. 99 for a
#      kind the list does not have.
