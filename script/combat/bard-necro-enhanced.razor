# ----------------------------------------------------------------------------------------
# module/bard/instrument.razor
# ----------------------------------------------------------------------------------------
# Only auto detect when the cached instrument is no longer in the backpack, so a pass
# that already holds a good serial costs one find and nothing else.
if not find var__my_instrument backpack
    @setvar! var__my_instrument 0

    if config__use_magic_instrument = 1
        while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as alias__found_magic_instrument
            getlabel alias__found_magic_instrument label__found_magic_instrument

            if "supremely" in label__found_magic_instrument or "exceedingly" in label__found_magic_instrument
                @setvar! var__my_instrument alias__found_magic_instrument
                break
            endif

            @ignore alias__found_magic_instrument
        endwhile

        @clearignore
    elseif findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as alias__found_craft_instrument
        @setvar! var__my_instrument alias__found_craft_instrument
    endif
endif

# If auto detect found nothing, ask for a manual pick exactly once. A barding script with
# no instrument has nothing to do, so a failed pick stops rather than limping on.
if not find var__my_instrument backpack
    overhead "[ inst, pick ]" 255
    @setvar! var__my_instrument
    wait wait__instrument_pick

    if find var__my_instrument backpack as alias__picked_instrument
        getlabel alias__picked_instrument label__picked_instrument

        if "flute" in label__picked_instrument or "drums" in label__picked_instrument or "harp" in label__picked_instrument or "lute" in label__picked_instrument or "tambourine" in label__picked_instrument or "gemshorn" in label__picked_instrument or "hurdy" in label__picked_instrument or "psaltery" in label__picked_instrument or "sackbut" in label__picked_instrument or "shawm" in label__picked_instrument or "vielle" in label__picked_instrument
            overhead "[ inst, {{label__picked_instrument}} ]" 255
        else
            @setvar! var__my_instrument 0
            overhead "[ inst, wrong ]" 254
            stop
        endif
    else
        @setvar! var__my_instrument 0
        overhead "[ inst, out ]" 254
        stop
    endif
endif


