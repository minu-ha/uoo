clearsysmsg
clearall


if not timerexists "overhead_message_timer"
	createtimer "overhead_message_timer"
	settimer "overhead_message_timer" 2700
endif

if not timerexists "combat_target_grace_timer"
	createtimer "combat_target_grace_timer"
	settimer "combat_target_grace_timer" 1201
endif

if not timerexists "control_followup_timer"
	createtimer "control_followup_timer"
	settimer "control_followup_timer" 8001
endif

if not varexist var_my_weapon
    @setvar! var_my_weapon 0
endif

if not varexist var_combat_target
	@setvar! var_combat_target 0
endif

if not varexist var_control_followup_target
	@setvar! var_control_followup_target 0
endif

while findtype 3568|5112|3721 backpack 2767 as found_weapon
    getlabel found_weapon found_weapon_description

    if "vanquishing" in found_weapon_description or "power" in found_weapon_description or "force" in found_weapon_description or "might" in found_weapon_description
        @setvar! var_my_weapon found_weapon
        break
    endif

    @ignore found_weapon
endwhile

if not varexist var_my_instrument
    @setvar! var_my_instrument 0
endif

while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as found_instrument
    getlabel found_instrument found_instrument_description

    if "supremely" in found_instrument_description or "exceedingly" in found_instrument_description
        @setvar! var_my_instrument found_instrument
        break
    endif

    @ignore found_instrument
endwhile

@clearignore

if not find var_my_instrument backpack
    clearsysmsg
    overhead "Select instrument:" 55
    @setvar! var_my_instrument
    wait 200

    while not targetexists and not insysmsg "Select"
        @setvar! var_my_instrument
    endwhile

    wait 200
    getlabel backpack backpack_description

    if find var_my_instrument backpack as found_instrument
        getlabel found_instrument found_instrument_description

        if "flute" in found_instrument_description or "drums" in found_instrument_description or "harp" in found_instrument_description or "lute" in found_instrument_description or "tambourine" in found_instrument_description or "gemshorn" in found_instrument_description or "hurdy" in found_instrument_description or "psaltery" in found_instrument_description or "sackbut" in found_instrument_description or "shawm" in found_instrument_description or "Vielle" in found_instrument_description
            overhead "{{found_instrument_description}}"
            dclick var_my_instrument
            wait 1000
        else
            @setvar! var_my_instrument 0
            overhead "Not an instrument!" 33
            stop
        endif
    else
        @setvar! var_my_instrument 0
        overhead "Not in backpack" 33
        stop
    endif
endif

while not dead
	while queued
	    wait 100
	endwhile

	while casting
		wait 100
	endwhile

	if rhandempty
		if find var_my_weapon backpack as found_weapon
			dclick found_weapon
		endif
	endif

	if insysmsg "Your concentration is disturbed, thus ruining thy spell."
		replay
	endif

	if insysmsg "That is not a musical instrument"
		setvar var_my_instrument
	endif

	if insysmsg "What instrument shall you play"
		waitfortarget 1000

		if targetexists
			target var_my_instrument
			replay
		endif
	endif

	// ####################################################################################
	// # COMBAT TARGET CACHE
	// ####################################################################################
	// Cache the last hostile ground target so backpack or self targeting
	// does not break offensive barding and melee follow-through.
	if find lasttarget ground -1 -1 12 as fresh_target
		if not dead fresh_target
			if noto fresh_target = "hostile" or noto fresh_target = "criminal" or noto fresh_target = "enemy" or noto fresh_target = "murderer"
				@setvar! var_combat_target fresh_target
				settimer "combat_target_grace_timer" 0
			endif
		endif
	endif

	if find var_combat_target ground -1 -1 12 as stored_target
		if dead stored_target
			@setvar! var_combat_target 0
			@setvar! var_control_followup_target 0
		elseif noto stored_target != "hostile" and noto stored_target != "criminal" and noto stored_target != "enemy" and noto stored_target != "murderer"
			@setvar! var_combat_target 0
			@setvar! var_control_followup_target 0
		else
			settimer "combat_target_grace_timer" 0
		endif
	elseif var_combat_target != 0 and timer "combat_target_grace_timer" >= 1200
		@setvar! var_combat_target 0
		@setvar! var_control_followup_target 0
	endif

	if var_control_followup_target != 0
		if var_combat_target = 0
			@setvar! var_control_followup_target 0
		elseif var_control_followup_target != var_combat_target and timer "control_followup_timer" >= 1200
			@setvar! var_control_followup_target 0
		elseif timer "control_followup_timer" >= 8000
			@setvar! var_control_followup_target 0
		endif
	endif

	while weight > maxweight
		if findtype "gold coin" backpack as found_gold
			lift found_gold 500
			droprelloc 0 0
			getlabel backpack backpack_description

			if insysmsg "cannot drop anything"
				drop backpack -1 -1 -1
			endif

			wait 1000
			overhead 'You drop some gold on the ground.' 55
		endif
	endwhile

	if not findbuff 'Food Satisfaction'
        if findtype tray backpack as food
            dclick food
            wait 350
        endif
    endif

	if diffhits > 0 or poisoned
		if not bandaging and skill "Healing" > 10
			if findtype "clean bandage%s%" self
				hotkey "Bandage Self"
				wait 200
			else
				if timer "overhead_message_timer" > 2700
					overhead "You are out of bandage." 32
					settimer "overhead_message_timer" 0
				endif
			endif
		endif
	endif

	if paralyzed
		if findtype 3705 backpack 38
			yell "[Pouch"
			getlabel backpack ping
		else
			overhead "You are out of pouche." 32
		endif
	endif

	// ####################################################################################
	// # HEAL
	// ####################################################################################
	if diffhits >= 40
		if findtype "Yellow Potion" self as found_potion
				getlabel found_potion found_potion_description

			if "next usable" in found_potion_description
				if timer "overhead_message_timer" > 2700
					overhead found_potion_description 83
					settimer "overhead_message_timer" 0
				endif
			else
				overhead "You drink a healing potion." 53
				dclick found_potion
				getlabel backpack ping
				cooldown "Heal Potion" 10000
			endif
		else
			if timer "overhead_message_timer" > 2700
				overhead "You are out of healing potion." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # CURE POT
	// ####################################################################################
	if poisoned
		if findtype "Orange Potion" self as found_potion
			if hidden
				break
			endif

			overhead "You drink a cure potion." 44
			dclick found_potion
			getlabel backpack ping
		else
			if timer "overhead_message_timer" > 2700
				overhead "You are out of cure potion." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # STAMINA POT
	// ####################################################################################
	if stam < 80
		if findtype "Red Potion" backpack as found_potion
			dclick found_potion
			wait 200
		else
			if timer "overhead_message_timer" > 2700
				overhead "You are out of refresh potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # STRENGTH POT
	// ####################################################################################
	if str <= 100 and find var_combat_target ground -1 -1 12
		if findtype "White Potion" backpack as found_potion
			dclick found_potion
			wait 200
		else
			if timer "overhead_message_timer" > 2700
				overhead "You are out of strength potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # AGILITY POT
	// ####################################################################################
	if dex <= 100 and find var_combat_target ground -1 -1 12
		if findtype "Blue Potion" backpack as found_potion
			dclick found_potion
			wait 200
		else
			if timer "overhead_message_timer" > 2700
				overhead "You are out of agility potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # RESIST POT
	// ####################################################################################
	if not findbuff 'Magic Resist Potion' and find var_combat_target ground -1 -1 12
		if findtype "Black Potion" backpack as found_potion
			dclick found_potion
			wait 200
		else
			if timer "overhead_message_timer" > 2700
				overhead "You are out of magic resist potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # BARD SONG BUFF
	// ####################################################################################
	if not targetexists and cooldown "Discord" = 0 and cooldown "Music" = 0 and not findbuff "song of discordance"
		useskill 'Discordance'
		waitfortarget 1000

		if insysmsg "What instrument"
			target var_my_instrument
			replay
		elseif targetexists
			target backpack
		endif
	endif

	if not targetexists and cooldown "Provo" = 0 and cooldown "Music" = 0 and not findbuff "song of provocation"
		useskill 'Provocation'
		waitfortarget 1000

		if insysmsg "What instrument"
			target var_my_instrument
			replay
		elseif targetexists
			target backpack
		endif
	endif

	if not targetexists and cooldown "Peace" = 0 and cooldown "Music" = 0 and not findbuff "song of peacemaking"
		useskill 'Peacemaking'
		waitfortarget 1000

		if insysmsg "What instrument"
			target var_my_instrument
			replay
		elseif targetexists
			target backpack
		endif
	endif


	// ####################################################################################
	// # DISCO
	// ####################################################################################
	if not warmode and not targetexists and find var_combat_target ground -1 -1 10 as found_combat_target
		if skill "Discordance" > 0 and cooldown "Discord" = 0 and cooldown "Music" = 0
			getlabel found_combat_target target_label
            wait 200

			if "discord" in target_label
				if var_control_followup_target != found_combat_target
					@setvar! var_control_followup_target found_combat_target
					settimer "control_followup_timer" 0
				endif
			else
				clearsysmsg
				useskill 'Discordance'
				waitfortarget 500

				while targetexists
					if insysmsg "What instrument shall you play"
						target var_my_instrument
						replay
					endif

					if dead found_combat_target or var_combat_target != found_combat_target
						hotkey "Cancel Current Target"
						wait 200
					else
						target found_combat_target
						wait 200
					endif
				endwhile

				wait 200

				if find found_combat_target ground -1 -1 10 as confirmed_target and not dead confirmed_target and var_combat_target = found_combat_target
					getlabel confirmed_target target_label
					wait 200

					if "discord" in target_label
						@setvar! var_control_followup_target found_combat_target
						settimer "control_followup_timer" 0
					endif
				endif
			endif
		endif
	endif

	// ####################################################################################
	// # PEACE
	// ####################################################################################
	if not warmode and not targetexists and find var_combat_target ground -1 -1 10 as found_combat_target
		if skill "Peacemaking" > 0 and cooldown "Peace" = 0 and cooldown "Music" = 0
			getlabel found_combat_target target_label
			wait 200

			if "pacified" in target_label or "barding break" in target_label
				@setvar! var_control_followup_target 0
			elseif "discord" in target_label
				clearsysmsg
				useskill 'Peacemaking'
				waitfortarget 1000

				while targetexists
					if insysmsg "What instrument shall you play"
						target var_my_instrument
						replay
					endif

					if dead found_combat_target or var_combat_target != found_combat_target
						hotkey "Cancel Current Target"
						wait 200
					else
						target found_combat_target
						wait 200
					endif
				endwhile

				wait 200

				if find found_combat_target ground -1 -1 10 as confirmed_target and not dead confirmed_target and var_combat_target = found_combat_target
					getlabel confirmed_target target_label
					wait 200

					if "pacified" in target_label or "barding break" in target_label
						@setvar! var_control_followup_target 0
					elseif "discord" in target_label
						@setvar! var_control_followup_target found_combat_target
						settimer "control_followup_timer" 0
					else
						@setvar! var_control_followup_target 0
					endif
				else
					@setvar! var_control_followup_target 0
				endif
			endif
		endif
	endif

	// ####################################################################################
	// # DISCO & VIRTUOSO
	// ####################################################################################
	if not warmode and not targetexists and find var_combat_target ground -1 -1 10 as found_combat_target
		if skill "Discordance" > 0 and cooldown "Discord" = 0 and cooldown "Music" = 0 and not findbuff "Virtuoso"
			getlabel found_combat_target target_label
            wait 200

			clearsysmsg
			useskill 'Discordance'
			waitfortarget 500

				while targetexists
					if insysmsg "What instrument shall you play"
						target var_my_instrument
						replay
					endif

					if dead found_combat_target or var_combat_target != found_combat_target
						hotkey "Cancel Current Target"
						wait 200
					else
						target found_combat_target
						wait 200
					endif
				endwhile

				wait 200

			endif

		if cooldown "Ability" = 0 and find var_combat_target ground -1 -1 2
		    say "[weaponability1"
		    cooldown "Ability" 5000
		endif
	endif

	if timer "clear_scavenger_timer" > 30000
		sysmsg "Clear Scavenger Cache"
		hotkey "Clear Scavenger Cache"
		settimer "clear_scavenger_timer" 0
	endif
endwhile
