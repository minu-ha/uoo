clearall
clearsysmsg
cleardragdrop
clearignore

@setvar! var_use_potion 1
@setvar! var_cure_cooldown 750
@setvar! var_greate_heal_cooldown 750
@setvar! var_bless_cooldown 1000
@setvar! var_arch_protection_cooldown 1250
@setvar! var_reactive_armor_cooldown 500
@setvar! var_magic_reflection_cooldown 1500

if not timerexists "overhead_message_timer"
	createtimer "overhead_message_timer"
	settimer "overhead_message_timer" 2000
endif

if not timerexists "clear_scavenger_timer"
	createtimer "clear_scavenger_timer"
	settimer "clear_scavenger_timer" 30000
endif

if not varexist var_my_instrument
    @setvar! var_my_instrument 0
endif

while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as found_instrument
    getlabel found_instrument found_instrument_description

    if "supremely" in found_instrument_description or "exceedingly" in found_instrument_description
        @setvar! var_my_instrument found_instrument
        break
    endif

    @ignore found_instrument
endwhile

@clearignore

if not find var_my_instrument backpack
    clearsysmsg
    overhead "Select instrument:" 55
    @setvar! var_my_instrument
    wait 200

    while not targetexists and not insysmsg "Select"
        @setvar! var_my_instrument
    endwhile

    wait 200
    getlabel backpack backpack_description

    if find var_my_instrument backpack as found_instrument
        getlabel found_instrument found_instrument_description

        if "flute" in found_instrument_description or "drums" in found_instrument_description or "harp" in found_instrument_description or "lute" in found_instrument_description or "tambourine" in found_instrument_description or "gemshorn" in found_instrument_description or "hurdy" in found_instrument_description or "psaltery" in found_instrument_description or "sackbut" in found_instrument_description or "shawm" in found_instrument_description or "Vielle" in found_instrument_description
            overhead "{{found_instrument_description}}"
            dclick var_my_instrument
            wait 1000
        else
            @setvar! var_my_instrument 0
            overhead "Not an instrument!" 33
            stop
        endif
    else
        @setvar! var_my_instrument 0
        overhead "Not in backpack" 33
        stop
    endif
endif

while not dead
	if insysmsg "Your concentration is disturbed, thus ruining thy spell."
		replay
	endif

	if insysmsg "That is not a musical instrument"
		setvar var_my_instrument
	endif

	if insysmsg "What instrument shall you play" and targetexists
		target var_my_instrument
	endif

	while queued
	    wait 100
	endwhile

	while casting
		wait 100
	endwhile

	while weight > maxweight
		if findtype "gold coin" backpack as found_gold
			lift found_gold 500
			droprelloc 0 0
			getlabel backpack backpack_description

			if insysmsg "cannot drop anything"
				drop backpack -1 -1 -1
			endif

			wait 1000
			overhead 'You drop some gold on the ground.' 55
		endif
	endwhile

	if not findbuff 'Food Satisfaction'
        if findtype tray backpack as food
            dclick food
            wait 350
        endif
    endif


	if paralyzed
		if findtype 3705 backpack 38
			yell "[Pouch"
			getlabel backpack ping
		else
			overhead "You are out of pouche." 32
		endif
	endif

	// ####################################################################################
	// # HEAL
	// ####################################################################################
	if diffhits > 15 and diffhits < 35 and findtype 3972 self and findtype 3973 self and findtype 3974 self and findtype 3981 self and not casting and not targetexists
		hotkey "> Smart Heal/Cure Self"
		wait var_greate_heal_cooldown
	elseif diffhits > 35
		if findtype "Yellow Potion" self as found_potion
			getlabel found_potion found_potion_description

			if "next usable" in found_potion_description
				if timer "overhead_message_timer" > 2000
					overhead found_potion_description 83
					settimer "overhead_message_timer" 0
				endif

				if not targetexists and not casting and findtype 3972 self and findtype 3973 self and findtype 3974 self and findtype 3981 self
					hotkey "> Greater Heal/Cure Self"
					wait var_greate_heal_cooldown
				endif
			else
				overhead "You drink a healing potion." 53
				dclick found_potion
				getlabel backpack ping
				cooldown "Heal Potion" 10000
			endif
		else
			if timer "overhead_message_timer" > 2000
				overhead "You are out of healing potion." 32
				settimer "overhead_message_timer" 0
			endif

			if not targetexists and not casting and findtype 3972 self and findtype 3973 self and findtype 3974 self and findtype 3981 self
				hotkey "> Greater Heal/Cure Self"
				wait var_greate_heal_cooldown
            endif
		endif
	endif

	// ####################################################################################
	// # CURE POT
	// ####################################################################################
	if poisoned
		if findtype "Orange Potion" self as found_potion
			if hidden
				break
			endif

			overhead "You drink a cure potion." 44
			dclick found_potion
			getlabel backpack ping
		else
			if timer "overhead_message_timer" > 2000
				overhead "You are out of cure potion." 32
				settimer "overhead_message_timer" 0
			endif

			if not targetexists and not casting and findtype 3972 self and findtype 3973 self
				hotkey "> Smart Heal/Cure Self"
            endif
			wait var_cure_cooldown
		endif
	endif


	// ####################################################################################
	// # STAMINA POT
	// ####################################################################################
	if stam < 5
		if findtype "Red Potion" backpack as found_potion
			dclick found_potion
			wait 200
		else
			if timer "overhead_message_timer" > 2000
				overhead "You are out of refresh potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # STRENGTH POT
	// ####################################################################################
	if str <= 100 and var_use_potion = 1 and find lasttarget ground -1 -1 12
		if findtype "White Potion" backpack as found_potion
			dclick found_potion
			wait 200
		else
			if timer "overhead_message_timer" > 2000
				overhead "You are out of strength potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # AGILITY POT
	// ####################################################################################
	if dex <= 25 and var_use_potion = 1 and find lasttarget ground -1 -1 12
		if findtype "Blue Potion" backpack as found_potion
			dclick found_potion
			wait 200
		else
			if timer "overhead_message_timer" > 2000
				overhead "You are out of agility potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # RESIST POT
	// ####################################################################################
	if not findbuff 'Magic Resist Potion' and var_use_potion = 1 and find lasttarget ground -1 -1 12
		if findtype "Black Potion" backpack as found_potion
			dclick found_potion
			wait 200
		else
			if timer "overhead_message_timer" > 2000
				overhead "You are out of magic resist potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif


	// ####################################################################################
	// # MAGE BUFF
	// ####################################################################################
	if mana > 30 and not targetexists
		if not targetexists and not findbuff 'Strength' or not findbuff 'Agility' or not findbuff 'Cunning' and cooldown "Walk" = 0 and not find lasttarget -1 -1 12 and findtype 3972 self and findtype 3974 self and not casting
            cast 'Bless'
            wait var_bless_cooldown
            waitfortarget 1000
            hotkey 'Target Self'
        endif
		if not targetexists and not findbuff 'Protection' and cooldown "Walk" = 0 and findtype 3980 self and findtype 3972 self and findtype 3973 self and findtype 3974 self and not casting and find lasttarget ground -1 -1 12
			cast 'Arch Protection'
			wait var_arch_protection_cooldown
			waitfortarget 1000
			hotkey 'Target Self'
		endif
		if not targetexists and not findbuff 'Reactive Armor' and cooldown "Walk" = 0 and findtype 3980 self and findtype 3972 self and findtype 3981 self and not casting
			cast 'Reactive Armor'
			wait var_reactive_armor_cooldown
		endif
		if not targetexists and not findbuff 'Magic Reflection' and cooldown "Reflect" = 0 and cooldown "Walk" = 0 and findtype 3972 self and findtype 3974 self and findtype 3981 self and not casting
			cast 'Magic Reflection'
			wait var_magic_reflection_cooldown
		endif
	endif


	// ####################################################################################
	// # BARD SONG BUFF
	// ####################################################################################
	if not targetexists and not casting and cooldown "Discord" = 0 and cooldown "Music" = 0 and not findbuff "song of discordance"
		useskill 'Discordance'
		waitfortarget 1000

		if insysmsg "What instrument"
			target var_my_instrument
			replay
		elseif targetexists
			target backpack
		endif
	endif

	if not targetexists and not casting and cooldown "Provo" = 0 and cooldown "Music" = 0 and not findbuff "song of provocation"
		useskill 'Provocation'
		waitfortarget 1000

		if insysmsg "What instrument"
			target var_my_instrument
			replay
		elseif targetexists
			target backpack
		endif
	endif

	if not targetexists and not casting and cooldown "Peace" = 0 and cooldown "Music" = 0 and not findbuff "song of peacemaking"
		useskill 'Peacemaking'
		waitfortarget 1000

		if insysmsg "What instrument"
			target var_my_instrument
			replay
		elseif targetexists
			target backpack
		endif
	endif



	// ####################################################################################
	// # DISCO
	// ####################################################################################
	if not targetexists and not casting and warmode and find lasttarget ground -1 -1 10 as fount_target
		if skill "Discordance" > 0 and cooldown "Discord" = 0 and cooldown "Music" = 0
			getlabel fount_target target_label
            wait 200

			if "discord" in target_label
				//
			else
				clearsysmsg
				useskill 'Discordance'
				waitfortarget 500

				while targetexists
					if dead fount_target
						hotkey "Cancel Current Target"
						wait 200
					else
						target fount_target
						wait 200
					endif
				endwhile

				wait 200
			endif
		endif
	endif

	// ####################################################################################
	// # PEACE
	// ####################################################################################
	if not targetexists and not casting and warmode and find lasttarget ground -1 -1 10 as fount_target
		if skill "Peacemaking" > 0 and cooldown "Peace" = 0 and cooldown "Music" = 0
			getlabel fount_target target_label
            wait 200

			if "pacified" in target_label or "barding break" in target_label
				//
			elseif "discord" in target_label
				clearsysmsg
				useskill 'Peacemaking'
				waitfortarget 500

				while targetexists
					if dead fount_target
						hotkey "Cancel Current Target"
						wait 200
					else
						target fount_target
						wait 200
					endif
				endwhile

				wait 200
			endif
		endif
	endif

	// ####################################################################################
	// # DISCO & VIRTUOSO
	// ####################################################################################
	if not targetexists and not casting and warmode and find lasttarget ground -1 -1 10 as fount_target
		if skill "Discordance" > 0 and cooldown "Discord" = 0 and cooldown "Music" = 0 and not findbuff "Virtuoso"
			getlabel fount_target target_label
            wait 200

			clearsysmsg
			useskill 'Discordance'
			waitfortarget 500

			while targetexists
				if dead fount_target
					hotkey "Cancel Current Target"
					wait 200
				else
					target fount_target
					wait 200
				endif
			endwhile

			wait 200
		endif
	endif


	// ####################################################################################
	// # DISCO AOE
	// ####################################################################################
	if not targetexists and not casting and not warmode and find lasttarget ground -1 -1 10 as fount_target
		if skill "Discordance" > 0 and cooldown "Discord" = 0 and cooldown "Music" = 0
			getlabel fount_target target_label
            wait 200

			clearsysmsg
			useskill 'Discordance'
			waitfortarget 500

			while targetexists
				if dead fount_target
					hotkey "Cancel Current Target"
					wait 200
				else
					hotkey 'Target Self'
					wait 200
				endif
			endwhile

			wait 200
		endif
	endif

	if mana < 50 and not findbuff 'Magic Mushroom Cooldown'
	    hotkey 'Eat Magic Mushroom'
	endif

	if timer "clear_scavenger_timer" > 30000
		sysmsg "Clear Scavenger Cache"
		hotkey "Clear Scavenger Cache"
		settimer "clear_scavenger_timer" 0
	endif
endwhile
