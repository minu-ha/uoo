    # ------------------------------------------------------------------------------------
    # WEAPON                                                module/fight/weapon-swap.razor
    # ------------------------------------------------------------------------------------
    if not paralyzed and not hidden and not queued and not casting and not targetexists
        @setvar! var__weapon_want 0
        if config__weapon_4_graphic != 0 and cooldown "swing 4" = 0
            @setvar! var__weapon_want config__weapon_4_graphic
        elseif config__weapon_3_graphic != 0 and cooldown "swing 3" = 0
            @setvar! var__weapon_want config__weapon_3_graphic
        elseif config__weapon_2_graphic != 0 and cooldown "swing 2" = 0
            @setvar! var__weapon_want config__weapon_2_graphic
        elseif config__weapon_1_graphic != 0 and cooldown "swing 1" = 0
            @setvar! var__weapon_want config__weapon_1_graphic
        elseif lhandempty and rhandempty
            if config__weapon_1_graphic != 0
                @setvar! var__weapon_want config__weapon_1_graphic
            elseif config__weapon_2_graphic != 0
                @setvar! var__weapon_want config__weapon_2_graphic
            elseif config__weapon_3_graphic != 0
                @setvar! var__weapon_want config__weapon_3_graphic
            elseif config__weapon_4_graphic != 0
                @setvar! var__weapon_want config__weapon_4_graphic
            endif
        endif

        if var__weapon_want != 0
            if var__weapon_armed_graphic != var__weapon_want
                @setvar! var__weapon_armed_graphic var__weapon_want
                @setvar! var__weapon_armed_serial 0
                if findtype var__weapon_want self as alias__own_weapon
                    @setvar! var__weapon_armed_serial alias__own_weapon
                endif
            endif

            @setvar! var__weapon_held 0
            if findlayer self lefthand as alias__held_left
                if alias__held_left = var__weapon_armed_serial
                    @setvar! var__weapon_held 1
                endif
            endif
            if findlayer self righthand as alias__held_right
                if alias__held_right = var__weapon_armed_serial
                    @setvar! var__weapon_held 1
                endif
            endif

            if var__weapon_held = 0
                if find var__weapon_armed_serial backpack
                    dress var__weapon_armed_serial
                    if config__sysmsg = 1
                        sysmsg "PvP weapon: equip requested, graphic={{var__weapon_want}}, serial={{var__weapon_armed_serial}}." 88
                    endif
                    wait wait__short
                else
                    # Gone from hand and pack: search again next pass.
                    @setvar! var__weapon_armed_graphic 0
                    if lhandempty and rhandempty and timer "timer__message" >= interval__message
                        overhead "[ weapon, out ]" 254
                        settimer "timer__message" 0
                    endif
                endif
            endif
        endif
    endif

    # ------------------------------------------------------------------------------------
    # END OF PASS                                                        module/base.razor
    # ------------------------------------------------------------------------------------
    wait wait__poll
endwhile
