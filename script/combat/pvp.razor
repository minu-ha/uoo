# Field PvP recovery and swing-based equipment. All offense stays manual.
# Needs: > Interrupt, Cancel Current Target, Target Self, Pouch, Bandage Self,
# Drink Cure, Drink Heal, Drink Refresh, Drink Strength, Drink Agility, Drink Magic Resist.
# Bars: heal pot, walk, reflect, swing 1..4 (WeaponSwing for enabled slots).
# Arm/Dress must remove conflicting equipment. Startup preserves manual input.
# Stop before starting another manual spell during an automatic self cast.

if pvp
    overhead "[ script, blocked ]" 53
    stop
endif

# ####################################################################################
# # CONFIG
# ####################################################################################
@setvar! config__use_magery 1
@setvar! config__use_weapon 1
@setvar! config__use_bandages 1
@setvar! config__use_potions 1
@setvar! config__use_stat_potions 1
@setvar! config__use_resist_potion 1
@setvar! config__use_reactive_armor 1
@setvar! config__use_magic_reflect 1
@setvar! config__chatty 1

# Cancel a manual spell only for an available recovery at the emergency HP threshold.
# Neutral item cursors are preserved. Self MA to prime the next bandage is manual.
@setvar! config__interrupt_to_heal 1
@setvar! config__heal_hits 35
@setvar! config__emergency_hits 35
@setvar! config__light_hits 15
@setvar! config__refresh_stam 15

# Minimum current mana to start each spell. Increase a value to keep a reserve.
@setvar! config__mana_cure 6
@setvar! config__mana_greater_heal 11
@setvar! config__mana_heal 4
@setvar! config__mana_reactive_armor 4
@setvar! config__mana_magic_reflect 14

# Ready priority 4..1. Empty-hand fallback 1..4. Graphic 0 disables a slot.
@setvar! config__weapon_1_graphic 31128
@setvar! config__weapon_2_graphic 0
@setvar! config__weapon_3_graphic 0
@setvar! config__weapon_4_graphic 31190

# ####################################################################################
# # WAIT AND COOLDOWN
# ####################################################################################
@setvar! wait__poll 100
@setvar! wait__action 200
@setvar! wait__cast 6000
@setvar! cooldown__item_retry 1200
@setvar! cooldown__weapon_check 300
@setvar! cooldown__heal_retry 2500
@setvar! cooldown__support_retry 5000
@setvar! cooldown__message 3000

# ####################################################################################
# # TIMER
# ####################################################################################
# Retry clocks survive Stop/Play. These are request limits, not server cooldowns.
if not timerexists "timer__pvp_pouch"
    createtimer "timer__pvp_pouch"
    settimer "timer__pvp_pouch" cooldown__item_retry
endif
if not timerexists "timer__pvp_cure_potion"
    createtimer "timer__pvp_cure_potion"
    settimer "timer__pvp_cure_potion" cooldown__item_retry
endif
if not timerexists "timer__pvp_heal_potion"
    createtimer "timer__pvp_heal_potion"
    settimer "timer__pvp_heal_potion" cooldown__item_retry
endif
if not timerexists "timer__pvp_bandage"
    createtimer "timer__pvp_bandage"
    settimer "timer__pvp_bandage" cooldown__item_retry
endif
if not timerexists "timer__pvp_refresh"
    createtimer "timer__pvp_refresh"
    settimer "timer__pvp_refresh" cooldown__item_retry
endif
if not timerexists "timer__pvp_heal"
    createtimer "timer__pvp_heal"
    settimer "timer__pvp_heal" cooldown__heal_retry
endif
if not timerexists "timer__pvp_support"
    createtimer "timer__pvp_support"
    settimer "timer__pvp_support" cooldown__support_retry
endif
if not timerexists "timer__pvp_weapon"
    createtimer "timer__pvp_weapon"
    settimer "timer__pvp_weapon" cooldown__weapon_check
endif
if not timerexists "timer__pvp_message"
    createtimer "timer__pvp_message"
    settimer "timer__pvp_message" cooldown__message
endif
if not timerexists "timer__pvp_cast"
    createtimer "timer__pvp_cast"
endif

# ####################################################################################
# # STATE
# ####################################################################################
# This pass's item: 0 none, 1 pouch, 2 cure, 3 heal, 4 bandage, 5 refresh,
# 6 strength, 7 agility, 8 resist. Spell: 0 none, 1 Cure, 2 GH, 3 Heal, 4 RA, 5 Reflect.
@setvar! var__selected_item 0
@setvar! var__selected_self_spell 0
# Cast wait completion is not proof that healing or a buff succeeded.
@setvar! var__cast_wait_finished 0
# Only own items are cached. Reuse a serial only while it is actually held.
@setvar! var__selected_weapon_graphic 0
@setvar! var__selected_weapon_serial 0
@setvar! var__cached_weapon_graphic 0
@setvar! var__cached_weapon_serial 0

overhead "[ pvp, on ]" 90
if config__chatty = 1
    sysmsg "PvP sustain v5 loaded. Manual offense, recovery first. Interrupt={{config__interrupt_to_heal}}." 90
endif

# ####################################################################################
# # MAIN LOOP
# ####################################################################################
while not dead
    if pvp
        overhead "[ script, blocked ]" 53
        stop
    endif
    if not hidden and not queued
        @setvar! var__selected_item 0
        @setvar! var__selected_self_spell 0

        # ############################################################################
        # # SURVIVAL: select an available recovery before touching a manual cursor.
        # ############################################################################
        if paralyzed
            if timer "timer__pvp_pouch" >= cooldown__item_retry
                settimer "timer__pvp_pouch" 0
                if findtype 3705 backpack 38
                    @setvar! var__selected_item 1
                endif
            endif
        else
            if poisoned and config__use_potions = 1 and timer "timer__pvp_cure_potion" >= cooldown__item_retry
                settimer "timer__pvp_cure_potion" 0
                if findtype "Orange Potion" self
                    @setvar! var__selected_item 2
                endif
            elseif not poisoned and config__use_potions = 1 and diffhits >= config__heal_hits and cooldown "heal pot" = 0 and timer "timer__pvp_heal_potion" >= cooldown__item_retry
                settimer "timer__pvp_heal_potion" 0
                if findtype "Yellow Potion" self as alias__heal_potion
                    getlabel alias__heal_potion label__heal_potion
                    if "next usable" in label__heal_potion
                        # Respect the item label even when the cooldown bar is missing.
                    else
                        @setvar! var__selected_item 3
                    endif
                endif
            endif

            # Instant recovery first, then one spell. No cached reagent inventory.
            if var__selected_item = 0 and config__use_magery = 1 and skill "Magery" > 0 and cooldown "walk" = 0 and timer "timer__pvp_heal" >= cooldown__heal_retry
                if poisoned and mana >= config__mana_cure
                    settimer "timer__pvp_heal" 0
                    if findtype 3972 self and findtype 3973 self
                        @setvar! var__selected_self_spell 1
                    endif
                elseif not poisoned and diffhits >= config__emergency_hits and mana >= config__mana_greater_heal
                    settimer "timer__pvp_heal" 0
                    if findtype 3972 self and findtype 3973 self and findtype 3981 self and findtype 3974 self
                        @setvar! var__selected_self_spell 2
                    endif
                endif
                if var__selected_self_spell = 0 and not poisoned and diffhits >= config__light_hits and not bandaging and mana >= config__mana_heal
                    if config__use_bandages = 0 or skill "Healing" = 0 or not findtype 3617 self
                        settimer "timer__pvp_heal" 0
                        if findtype 3972 self and findtype 3973 self and findtype 3981 self
                            @setvar! var__selected_self_spell 3
                        endif
                    endif
                endif
            endif

            # Never restart a running bandage. Full health does not trigger self damage.
            if var__selected_item = 0 and var__selected_self_spell = 0 and config__use_bandages = 1 and skill "Healing" > 0 and not bandaging and timer "timer__pvp_bandage" >= cooldown__item_retry
                if diffhits > 0 or poisoned
                    settimer "timer__pvp_bandage" 0
                    if findtype 3617 self
                        @setvar! var__selected_item 4
                    elseif timer "timer__pvp_message" >= cooldown__message
                        overhead "[ bandage, out ]" 53
                        settimer "timer__pvp_message" 0
                    endif
                endif
            endif
            if var__selected_item = 0 and var__selected_self_spell = 0 and config__use_potions = 1 and stam <= config__refresh_stam and timer "timer__pvp_refresh" >= cooldown__item_retry
                settimer "timer__pvp_refresh" 0
                if findtype "Red Potion" self
                    @setvar! var__selected_item 5
                endif
            endif
        endif

        # Only immediate recovery can sacrifice a spell. Bandages/Refresh cannot.
        if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits and not targetexists "neutral"
            if var__selected_item = 1 or var__selected_item = 2 or var__selected_item = 3 or var__selected_self_spell != 0
                if casting or targetexists
                    if config__chatty = 1
                        overhead "[ cast, cut ]" 53
                    endif
                    if casting
                        hotkey "> Interrupt"
                    endif
                    if targetexists and not targetexists "neutral"
                        hotkey "Cancel Current Target"
                    endif
                    wait wait__action
                endif
            endif
        endif

        # Normal input remains manual. Every action rechecks this live window.
        if not casting and not targetexists and not queued and not hidden and not dead and not pvp
            # ########################################################################
            # # PREPARATION: one shared slow check, only when recovery has nothing to do.
            # ########################################################################
            if var__selected_item = 0 and var__selected_self_spell = 0 and not paralyzed and not poisoned and diffhits < config__light_hits and timer "timer__pvp_support" >= cooldown__support_retry
                settimer "timer__pvp_support" 0
                if config__use_potions = 1 and config__use_stat_potions = 1
                    if not findbuff "Strength" and findtype "White Potion" self
                        @setvar! var__selected_item 6
                    elseif not findbuff "Agility" and findtype "Blue Potion" self
                        @setvar! var__selected_item 7
                    elseif config__use_resist_potion = 1 and not findbuff "Magic Resist Potion" and findtype "Black Potion" self
                        @setvar! var__selected_item 8
                    endif
                endif
                if var__selected_item = 0 and config__use_magery = 1 and skill "Magery" > 0 and cooldown "walk" = 0
                    if config__use_reactive_armor = 1 and not findbuff "Reactive Armor" and mana >= config__mana_reactive_armor
                        if findtype 3972 self and findtype 3981 self and findtype 3980 self
                            @setvar! var__selected_self_spell 4
                        endif
                    endif
                    if var__selected_self_spell = 0 and config__use_magic_reflect = 1 and not findbuff "Magic Reflection" and cooldown "reflect" = 0 and mana >= config__mana_magic_reflect
                        if findtype 3972 self and findtype 3981 self and findtype 3974 self
                            @setvar! var__selected_self_spell 5
                        endif
                    endif
                endif
            endif

            # ########################################################################
            # # EXECUTE: one item, one self spell, or one equipment check.
            # ########################################################################
            if var__selected_item != 0 and not casting and not targetexists and not queued and not hidden
                if var__selected_item = 1 and paralyzed
                    hotkey "Pouch"
                elseif var__selected_item = 2 and poisoned
                    hotkey "Drink Cure"
                elseif var__selected_item = 3 and not poisoned and diffhits >= config__heal_hits and cooldown "heal pot" = 0
                    hotkey "Drink Heal"
                elseif var__selected_item = 4 and not bandaging
                    hotkey "Bandage Self"
                elseif var__selected_item = 5
                    hotkey "Drink Refresh"
                elseif var__selected_item = 6
                    hotkey "Drink Strength"
                elseif var__selected_item = 7
                    hotkey "Drink Agility"
                elseif var__selected_item = 8
                    hotkey "Drink Magic Resist"
                endif
                wait wait__action
            elseif var__selected_self_spell != 0 and not casting and not targetexists and not queued and not hidden and cooldown "walk" = 0
                @setvar! var__cast_wait_finished 0
                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                    # Consume a stale disturbance before our own cast.
                endif
                settimer "timer__pvp_cast" 0
                if var__selected_self_spell = 1
                    cast "Cure"
                elseif var__selected_self_spell = 2
                    cast "Greater Heal"
                elseif var__selected_self_spell = 3
                    cast "Heal"
                elseif var__selected_self_spell = 4
                    cast "Reactive Armor"
                else
                    cast "Magic Reflection"
                endif
                wait wait__action
                while var__cast_wait_finished = 0 and timer "timer__pvp_cast" < wait__cast
                    if dead or pvp
                        stop
                    endif
                    if targetexists
                        if var__selected_self_spell = 4 or var__selected_self_spell = 5 or not targetexists "beneficial"
                            overhead "[ cast, check ]" 55
                            stop
                        endif
                        hotkey "Target Self"
                        @setvar! var__cast_wait_finished 1
                    elseif insysmsg "Your concentration is disturbed, thus ruining thy spell."
                        @setvar! var__cast_wait_finished 1
                    elseif var__selected_self_spell = 4 or var__selected_self_spell = 5
                        if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits and casting
                            hotkey "> Interrupt"
                            @setvar! var__cast_wait_finished 1
                        elseif not casting and not queued
                            @setvar! var__cast_wait_finished 1
                        endif
                    endif
                    if var__cast_wait_finished = 0
                        wait wait__poll
                    endif
                endwhile
                if var__cast_wait_finished = 0
                    overhead "[ cast, check ]" 55
                    stop
                endif
                wait wait__action
            elseif not paralyzed and config__use_weapon = 1 and timer "timer__pvp_weapon" >= cooldown__weapon_check
                settimer "timer__pvp_weapon" 0
                @setvar! var__selected_weapon_serial 0
                # One bounded scan: ready 4..1, then empty-hand fallback 1..4.
                for 8
                    if var__selected_weapon_serial = 0
                        @setvar! var__selected_weapon_graphic 0
                        if index = 0 and cooldown "swing 4" = 0
                            @setvar! var__selected_weapon_graphic config__weapon_4_graphic
                        elseif index = 1 and cooldown "swing 3" = 0
                            @setvar! var__selected_weapon_graphic config__weapon_3_graphic
                        elseif index = 2 and cooldown "swing 2" = 0
                            @setvar! var__selected_weapon_graphic config__weapon_2_graphic
                        elseif index = 3 and cooldown "swing 1" = 0
                            @setvar! var__selected_weapon_graphic config__weapon_1_graphic
                        elseif index = 4 and lhandempty and rhandempty
                            @setvar! var__selected_weapon_graphic config__weapon_1_graphic
                        elseif index = 5 and lhandempty and rhandempty
                            @setvar! var__selected_weapon_graphic config__weapon_2_graphic
                        elseif index = 6 and lhandempty and rhandempty
                            @setvar! var__selected_weapon_graphic config__weapon_3_graphic
                        elseif index = 7 and lhandempty and rhandempty
                            @setvar! var__selected_weapon_graphic config__weapon_4_graphic
                        endif
                        if var__selected_weapon_graphic != 0
                            if var__cached_weapon_graphic = var__selected_weapon_graphic
                                if findlayer self lefthand as alias__held_left
                                    if alias__held_left = var__cached_weapon_serial
                                        @setvar! var__selected_weapon_serial alias__held_left
                                    endif
                                endif
                                if findlayer self righthand as alias__held_right
                                    if alias__held_right = var__cached_weapon_serial
                                        @setvar! var__selected_weapon_serial alias__held_right
                                    endif
                                endif
                            endif
                            if var__selected_weapon_serial = 0
                                if findtype var__selected_weapon_graphic self as alias__own_weapon
                                    @setvar! var__selected_weapon_serial alias__own_weapon
                                elseif findtype var__selected_weapon_graphic backpack as alias__packed_weapon
                                    @setvar! var__selected_weapon_serial alias__packed_weapon
                                endif
                            endif
                        endif
                    endif
                endfor
                if var__selected_weapon_serial != 0
                    @setvar! var__cached_weapon_graphic var__selected_weapon_graphic
                    @setvar! var__cached_weapon_serial var__selected_weapon_serial
                    if findlayer self lefthand as alias__held_left
                        if alias__held_left = var__selected_weapon_serial
                            @setvar! var__selected_weapon_serial 0
                        endif
                    endif
                    if findlayer self righthand as alias__held_right
                        if alias__held_right = var__selected_weapon_serial
                            @setvar! var__selected_weapon_serial 0
                        endif
                    endif
                    if var__selected_weapon_serial != 0 and not casting and not targetexists and not queued and not hidden and not dead and not pvp
                        dress var__selected_weapon_serial
                        if config__chatty = 1
                            sysmsg "PvP weapon: equip requested, graphic={{var__selected_weapon_graphic}}." 90
                        endif
                        wait wait__action
                    endif
                endif
            endif
        endif
    endif
    wait wait__poll
endwhile
