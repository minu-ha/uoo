clearsysmsg
clearall

@setvar! var_use_potion 0
# STR and DEX with the Greater potion on: your base plus 20. Below these the potion is drunk.
# Bless and the Strength and Agility spells show the same icons as the potions, so the stat
# decides. Each potion is tried once per stat_potion_retry_frequency, so a curse that holds the
# stat under the line while the potion still runs does not send a drink every pass.
@setvar! var_str_potion 120
@setvar! var_dex_potion 120
@setvar! stat_potion_retry_frequency 5000

setvar! overhead_message_timer_frequency 2700
setvar! clear_scavenger_timer_frequency 30000

if not timerexists "overhead_message_timer"
    createtimer "overhead_message_timer"
    settimer "overhead_message_timer" overhead_message_timer_frequency
endif

if not timerexists "clear_scavenger_timer"
    createtimer "clear_scavenger_timer"
    settimer "clear_scavenger_timer" overhead_message_timer_frequency
endif

if not timerexists "str_potion_timer"
    createtimer "str_potion_timer"
endif
settimer "str_potion_timer" stat_potion_retry_frequency

if not timerexists "agi_potion_timer"
    createtimer "agi_potion_timer"
endif
settimer "agi_potion_timer" stat_potion_retry_frequency


@clearignore

if not gumpexists 2016719803
    say "[codexhotbar"
endif

while not dead
    while queued
        wait 100
    endwhile

    while casting
        wait 100
    endwhile

    while weight > maxweight
        if findtype "gold coin" backpack as found_gold
            lift found_gold 500
            droprelloc 0 0
            getlabel backpack backpack_description

            if insysmsg "cannot drop anything"
                drop backpack -1 -1 -1
            endif

            wait 1000
            overhead "[ gold, dropped ]" 290
        endif
    endwhile

    if not findbuff 'Food Satisfaction'
        if findtype tray backpack as food
            dclick food
            wait 350
        endif
    endif

    if diffhits > 0 or poisoned
        if not bandaging and skill "Healing" > 10
            if findtype "clean bandage%s%" self
                hotkey "Bandage Self"
                wait 200
            else
                if timer "overhead_message_timer" > overhead_message_timer_frequency
                    overhead "[ bandage, out ]" 254
                    settimer "overhead_message_timer" 0
                endif
            endif
        endif
    endif

    if paralyzed
        if findtype 3705 backpack 38
            yell "[Pouch"
            getlabel backpack ping
        else
            overhead "[ pouch, out ]" 254
        endif
    endif

    if hp <= 65
        if findtype "Yellow Potion" self as found_potion
                getlabel found_potion found_potion_description

            if "next usable" in found_potion_description
                if timer "overhead_message_timer" > overhead_message_timer_frequency
                    overhead "[ heal pot, {{found_potion_description}} ]" 290
                    settimer "overhead_message_timer" 0
                endif
            else
                if hidden
                    break
                endif

                dclick found_potion
                getlabel backpack ping
                cooldown "heal pot" 10000
            endif
        else
            if timer "overhead_message_timer" > overhead_message_timer_frequency
                overhead "[ heal pot, out ]" 254
                settimer "overhead_message_timer" 0
            endif
        endif
    endif

    if poisoned
        if findtype "Orange Potion" self as found_potion
            if hidden
                break
            endif

            dclick found_potion
            getlabel backpack ping
        else
            if timer "overhead_message_timer" > overhead_message_timer_frequency
                overhead "[ cure pot, out ]" 254
                settimer "overhead_message_timer" 0
            endif
        endif
    endif

    if stam < 5
        if findtype "Red Potion" backpack as found_potion
            dclick found_potion
            wait 200
        else
            if timer "overhead_message_timer" > overhead_message_timer_frequency
                overhead "[ refresh, out ]" 254
                settimer "overhead_message_timer" 0
            endif
        endif
    endif

    if str < var_str_potion and timer "str_potion_timer" >= stat_potion_retry_frequency and var_use_potion = 1 and find lasttarget ground -1 -1 12
        settimer "str_potion_timer" 0
        if findtype "White Potion" backpack as found_potion
            dclick found_potion
            wait 200
        else
            if timer "overhead_message_timer" > overhead_message_timer_frequency
                overhead "[ str, out ]" 254
                settimer "overhead_message_timer" 0
            endif
        endif
    endif

    if dex < var_dex_potion and timer "agi_potion_timer" >= stat_potion_retry_frequency and var_use_potion = 1 and find lasttarget ground -1 -1 12
        settimer "agi_potion_timer" 0
        if findtype "Blue Potion" backpack as found_potion
            dclick found_potion
            wait 200
        else
            if timer "overhead_message_timer" > overhead_message_timer_frequency
                overhead "[ agi, out ]" 254
                settimer "overhead_message_timer" 0
            endif
        endif
    endif

    if not findbuff 'Magic Resist Potion' and var_use_potion = 1 and find lasttarget ground -1 -1 12
        if findtype "Black Potion" backpack as found_potion
            dclick found_potion
            wait 200
        else
            if timer "overhead_message_timer" > overhead_message_timer_frequency
                overhead "[ resist, out ]" 254
                settimer "overhead_message_timer" 0
            endif
        endif
    endif


    if timer "clear_scavenger_timer" > clear_scavenger_timer_frequency
        sysmsg "Clear Scavenger Cache"
        hotkey "Clear Scavenger Cache"
        settimer "clear_scavenger_timer" 0
    endif
endwhile