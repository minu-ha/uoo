clearall
clearsysmsg
cleardragdrop
clearignore

// ####################################################################################
// # SETUP
// ####################################################################################
// Local timing and mana policy shared by the sustain, bard, necro, and eval loops.
@setvar! var_use_potion 1

// Shared wait timings.
@setvar! var_poll_wait 100
@setvar! var_global_delay 200
@setvar! var_ui_delay 1000
@setvar! var_fast_target_delay 500
@setvar! var_food_click_delay 350
@setvar! var_necro_commit_delay 450
@setvar! var_message_debounce_delay 2000

// Timer windows.
@setvar! var_instrument_retry_delay 5000
@setvar! var_hotbar_retry_delay 3000
@setvar! var_hotbar_notice_delay 10000
@setvar! var_target_memory_delay 15000
@setvar! var_necro_action_ready_delay 30500
@setvar! var_scavenger_clear_delay 30000
@setvar! var_vampiric_embrace_retry_delay 25000

// Sustain and buff action delays.
@setvar! var_cure_action_delay 750
@setvar! var_greater_heal_action_delay 750
@setvar! var_greater_heal_retry_delay 2500
@setvar! var_heal_action_delay 1200
@setvar! var_heal_potion_cooldown 10000
@setvar! var_bless_action_delay 1000
@setvar! var_arch_protection_action_delay 1250
@setvar! var_reactive_armor_action_delay 500
@setvar! var_magic_reflection_action_delay 1500

// Magery cast delays normalized by spell circle.
@setvar! var_first_circle_cast_delay 700
@setvar! var_second_circle_cast_delay 900
@setvar! var_third_circle_cast_delay 1100
@setvar! var_fourth_circle_cast_delay 1300
@setvar! var_fifth_circle_cast_delay 1300
@setvar! var_sixth_circle_cast_delay 1800
@setvar! var_seventh_circle_cast_delay 2050
@setvar! var_magery_target_delay 1500

// Proc cadence keeps a small readiness buffer.
@setvar! var_proc_ready_delay 20200

// Mushroom sustain policy.
@setvar! var_magic_mushroom_min_count 2
@setvar! var_magic_mushroom_create_mana 70
@setvar! var_magic_mushroom_eat_mana 55

// Razor inline arithmetic in conditions is unreliable, so keep spell
// mana gates as explicit flat thresholds instead of reserve + cost.
@setvar! var_first_circle_min_mana 14
@setvar! var_second_circle_min_mana 16
@setvar! var_third_circle_min_mana 19
@setvar! var_fourth_circle_min_mana 21
@setvar! var_seventh_circle_min_mana 50

if not timerexists "overhead_message_timer"
	createtimer "overhead_message_timer"
	settimer "overhead_message_timer" var_message_debounce_delay
endif

if not timerexists "clear_scavenger_timer"
	createtimer "clear_scavenger_timer"
	settimer "clear_scavenger_timer" var_scavenger_clear_delay
endif

if not timerexists "blood_oath_timer"
	createtimer "blood_oath_timer"
	settimer "blood_oath_timer" var_necro_action_ready_delay
endif

if not timerexists "evil_omen_timer"
	createtimer "evil_omen_timer"
	settimer "evil_omen_timer" var_necro_action_ready_delay
endif

if not timerexists "vampiric_embrace_timer"
	createtimer "vampiric_embrace_timer"
	settimer "vampiric_embrace_timer" var_necro_action_ready_delay
endif

if not timerexists "magic_target_memory_timer"
	createtimer "magic_target_memory_timer"
	settimer "magic_target_memory_timer" var_target_memory_delay
endif

if not timerexists "combat_target_grace_timer"
	createtimer "combat_target_grace_timer"
	settimer "combat_target_grace_timer" var_fast_target_delay
endif

if not timerexists "control_followup_timer"
	createtimer "control_followup_timer"
	settimer "control_followup_timer" var_target_memory_delay
endif

if not timerexists "magic_arrow_proc_timer"
	createtimer "magic_arrow_proc_timer"
	settimer "magic_arrow_proc_timer" var_proc_ready_delay
endif

if not timerexists "harm_proc_timer"
	createtimer "harm_proc_timer"
	settimer "harm_proc_timer" var_proc_ready_delay
endif

if not timerexists "fireball_proc_timer"
	createtimer "fireball_proc_timer"
	settimer "fireball_proc_timer" var_proc_ready_delay
endif

if not timerexists "lightning_proc_timer"
	createtimer "lightning_proc_timer"
	settimer "lightning_proc_timer" var_proc_ready_delay
endif

if not timerexists "necro_hotbar_retry_timer"
	createtimer "necro_hotbar_retry_timer"
	settimer "necro_hotbar_retry_timer" var_hotbar_retry_delay
endif

if not timerexists "necro_hotbar_notice_timer"
	createtimer "necro_hotbar_notice_timer"
	settimer "necro_hotbar_notice_timer" var_hotbar_notice_delay
endif

if not timerexists "heal_action_timer"
	createtimer "heal_action_timer"
	settimer "heal_action_timer" var_heal_action_delay
endif

if not timerexists "greater_heal_retry_timer"
	createtimer "greater_heal_retry_timer"
	settimer "greater_heal_retry_timer" var_greater_heal_retry_delay
endif

if not timerexists "instrument_retry_timer"
	createtimer "instrument_retry_timer"
	settimer "instrument_retry_timer" var_instrument_retry_delay
endif

if not varexist var_my_instrument
	@setvar! var_my_instrument 0
endif

if not varexist var_combat_target
	@setvar! var_combat_target 0
endif

if not varexist var_magic_stage
	@setvar! var_magic_stage 0
endif

if not varexist var_control_followup_target
	@setvar! var_control_followup_target 0
endif

if not varexist var_control_followup_ready
	@setvar! var_control_followup_ready 0
endif

if not varexist var_pending_hostile_action
	// 1=disco opener, 2=peace followup
	@setvar! var_pending_hostile_action 0
endif

// Track which targets already received each magery opener during the current pull.
if not listexists 'magic_cursed_targets'
	createlist 'magic_cursed_targets'
endif

// ####################################################################################
// # INSTRUMENT SELECT
// ####################################################################################
while findtype 3740|3742|3762|3763|10245|20006|20008|20010|20012|20014|20016 backpack as found_instrument
	getlabel found_instrument found_instrument_description

	// Prefer the best instrument already in the backpack before asking for manual selection.
	if "supremely" in found_instrument_description or "exceedingly" in found_instrument_description
		@setvar! var_my_instrument found_instrument
		break
	endif

	@ignore found_instrument
endwhile

@clearignore

if not find var_my_instrument backpack
	clearsysmsg
	overhead "Select instrument:" 55
	@setvar! var_my_instrument
	wait var_global_delay

	for 30
		if targetexists or insysmsg "Select"
			break
		endif

		wait var_poll_wait
	endfor

	if not targetexists and not insysmsg "Select"
		@setvar! var_my_instrument 0
		overhead "Instrument select timed out." 32
	endif

	wait var_global_delay
	getlabel backpack backpack_description

	if find var_my_instrument backpack as found_instrument
		getlabel found_instrument found_instrument_description

		if "flute" in found_instrument_description or "drums" in found_instrument_description or "harp" in found_instrument_description or "lute" in found_instrument_description or "tambourine" in found_instrument_description or "gemshorn" in found_instrument_description or "hurdy" in found_instrument_description or "psaltery" in found_instrument_description or "sackbut" in found_instrument_description or "shawm" in found_instrument_description or "Vielle" in found_instrument_description
			overhead "{{found_instrument_description}}" 55
			dclick var_my_instrument
			wait var_ui_delay
		else
			@setvar! var_my_instrument 0
			overhead "Not an instrument!" 33
		endif
	elseif var_my_instrument != 0
		@setvar! var_my_instrument 0
		overhead "Not in backpack" 33
	endif
endif

// ####################################################################################
// # NECRO HOTBAR SETUP
// ####################################################################################
if skill "Necromancy" > 0 and not gumpexists 622436516
	if findtype 'necromancer book' backpack
		// The hotbar gump is used as the source of truth for current symbol count.
		for 3
			if gumpexists 622436516
				break
			endif

			yell '[necromancyhotbar'
			waitforgump 622436516 var_fast_target_delay
		endfor

		if not gumpexists 622436516
			overhead "Necro hotbar missing." 32
			settimer "necro_hotbar_retry_timer" 0
			settimer "necro_hotbar_notice_timer" 0
		endif
	else
		overhead "Necro Book NOT Found!" 32
	endif
endif

while not dead
	if insysmsg "Your concentration is disturbed, thus ruining thy spell."
		replay
	endif

	if insysmsg "That is not a musical instrument"
		@setvar! var_my_instrument 0
	endif

	if insysmsg "What instrument shall you play" and targetexists
		if find var_my_instrument backpack
			target var_my_instrument
		else
			@setvar! var_my_instrument 0
			hotkey "Cancel Current Target"
			wait var_global_delay
		endif
	endif

	if var_my_instrument = 0 and not targetexists and not casting and timer "instrument_retry_timer" >= var_instrument_retry_delay
		clearsysmsg
		overhead "Select instrument:" 55
		@setvar! var_my_instrument
		wait var_global_delay
		settimer "instrument_retry_timer" 0

		for 30
			if targetexists or insysmsg "Select"
				break
			endif

			wait var_poll_wait
		endfor

		if not targetexists and not insysmsg "Select"
			@setvar! var_my_instrument 0
			if timer "overhead_message_timer" >= var_message_debounce_delay
				overhead "Instrument select timed out." 32
				settimer "overhead_message_timer" 0
			endif
		elseif find var_my_instrument backpack as found_instrument
			getlabel found_instrument found_instrument_description

			if "flute" in found_instrument_description or "drums" in found_instrument_description or "harp" in found_instrument_description or "lute" in found_instrument_description or "tambourine" in found_instrument_description or "gemshorn" in found_instrument_description or "hurdy" in found_instrument_description or "psaltery" in found_instrument_description or "sackbut" in found_instrument_description or "shawm" in found_instrument_description or "Vielle" in found_instrument_description
				overhead "{{found_instrument_description}}" 55
				dclick var_my_instrument
				wait var_ui_delay
			else
				@setvar! var_my_instrument 0
				overhead "Not an instrument!" 33
			endif
		endif
	endif

	while queued
		wait var_poll_wait
	endwhile

	while casting
		wait var_poll_wait
	endwhile

	@setvar! var_necro_action_used 0

	// ####################################################################################
	// # COMBAT TARGET CACHE
	// ####################################################################################
	// Cache the last hostile ground target so self or backpack targeting
	// does not break barding, necro, or opener follow-through.
	if find lasttarget ground -1 -1 12 as fresh_target
		if not dead fresh_target and var_combat_target != fresh_target
			if noto fresh_target = "hostile" or noto fresh_target = "criminal" or noto fresh_target = "enemy" or noto fresh_target = "murderer"
				@setvar! var_combat_target fresh_target
				settimer "combat_target_grace_timer" 0

				if inlist 'magic_cursed_targets' var_combat_target
					@setvar! var_magic_stage 1
				else
					@setvar! var_magic_stage 0
				endif
			endif
		endif
	endif

	if find var_combat_target ground -1 -1 12 as stored_target
		settimer "magic_target_memory_timer" 0
		settimer "combat_target_grace_timer" 0

		if inlist 'magic_cursed_targets' var_combat_target and var_magic_stage = 0
			@setvar! var_magic_stage 1
		elseif not inlist 'magic_cursed_targets' var_combat_target
			@setvar! var_magic_stage 0
		endif

		if dead stored_target
			@setvar! var_combat_target 0
			@setvar! var_magic_stage 0
		elseif noto stored_target != "hostile" and noto stored_target != "criminal" and noto stored_target != "enemy" and noto stored_target != "murderer"
			@setvar! var_combat_target 0
			@setvar! var_magic_stage 0
		endif
	elseif var_combat_target != 0 and timer "combat_target_grace_timer" >= var_fast_target_delay
		@setvar! var_combat_target 0
		@setvar! var_magic_stage 0
	endif

	if var_control_followup_target != 0
		if var_combat_target = 0
			@setvar! var_control_followup_target 0
		elseif var_control_followup_target != var_combat_target and timer "control_followup_timer" >= var_fast_target_delay
			@setvar! var_control_followup_target 0
		elseif timer "control_followup_timer" >= var_target_memory_delay
			@setvar! var_control_followup_target 0
		endif
	endif

	if var_combat_target = 0 and timer "magic_target_memory_timer" >= var_target_memory_delay
		// Treat a quiet window with no combat target as the end of the pull
		// and forget old opener state.
		clearlist 'magic_cursed_targets'
		settimer "magic_target_memory_timer" 0
	endif

	// ####################################################################################
	// # NECRO HOTBAR RECOVERY
	// ####################################################################################
	// Reopen the necro hotbar if it closes so symbol-based necro logic
	// does not silently stop mid-session.
	if skill "Necromancy" > 0 and not targetexists and not gumpexists 622436516
		if timer "necro_hotbar_retry_timer" >= var_hotbar_retry_delay
			if findtype 'necromancer book' backpack
				yell '[necromancyhotbar'
				waitforgump 622436516 var_global_delay
				settimer "necro_hotbar_retry_timer" 0

				if gumpexists 622436516
					settimer "necro_hotbar_notice_timer" 0
				elseif timer "necro_hotbar_notice_timer" >= var_hotbar_notice_delay
					overhead "Necro hotbar missing." 32
					settimer "necro_hotbar_notice_timer" 0
				endif
			elseif timer "necro_hotbar_notice_timer" >= var_hotbar_notice_delay
				overhead "Necro Book NOT Found!" 32
				settimer "necro_hotbar_notice_timer" 0
			endif
		endif
	endif

	@setvar! var_control_followup_ready 0

	if not warmode and var_control_followup_target != 0 and var_control_followup_target = var_combat_target and not targetexists and not casting
		if skill "Peacemaking" > 0 and cooldown "Peace" = 0 and cooldown "Music" = 0
			@setvar! var_control_followup_ready 1
		endif
	endif

	if skill "Necromancy" > 0
		// ####################################################################################
		// # NECRO SYMBOL TRACKING
		// ####################################################################################
		// Rebuild symbol count from the visible necro hotbar every loop.
		if not listexists 'necro_symbols'
			createlist 'necro_symbols'
		else
			clearlist 'necro_symbols'
		endif

		if gumpexists 622436516
			if ingump "20/" 622436516
				for 20
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "19/" 622436516
				for 19
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "18/" 622436516
				for 18
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "17/" 622436516
				for 17
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "16/" 622436516
				for 16
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "15/" 622436516
				for 15
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "14/" 622436516
				for 14
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "13/" 622436516
				for 13
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "12/" 622436516
				for 12
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "11/" 622436516
				for 11
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "10/" 622436516
				for 10
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "9/" 622436516
				for 9
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "8/" 622436516
				for 8
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "7/" 622436516
				for 7
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "6/" 622436516
				for 6
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "5/" 622436516
				for 5
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "4/" 622436516
				for 4
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "3/" 622436516
				for 3
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "2/" 622436516
				for 2
					pushlist 'necro_symbols' '1' 'back'
				endfor
			elseif ingump "1/" 622436516
				for 1
					pushlist 'necro_symbols' '1' 'back'
				endfor
			endif
		endif
	endif

	// ####################################################################################
	// # WEIGHT SAFETY
	// ####################################################################################
	while weight > maxweight
		if findtype "gold coin" backpack as found_gold
			lift found_gold 1000
			droprelloc 0 0
			getlabel backpack backpack_description

			if insysmsg "cannot drop anything"
				drop backpack -1 -1 -1
				getlabel backpack backpack_description
				wait var_global_delay

				if timer "overhead_message_timer" >= var_message_debounce_delay
					overhead "Gold drop stalled." 32
					settimer "overhead_message_timer" 0
				endif

				break
			endif

			wait var_ui_delay
			overhead 'You drop some gold on the ground.' 55
		else
			if timer "overhead_message_timer" >= var_message_debounce_delay
				overhead "Overweight with no gold to drop." 32
				settimer "overhead_message_timer" 0
			endif

			break
		endif
	endwhile

	if not findbuff 'Food Satisfaction'
		if findtype tray backpack as food
			dclick food
			wait var_food_click_delay
		endif
	endif


	if paralyzed
		if findtype 3705 backpack 38
			yell "[Pouch"
			getlabel backpack ping
		else
			overhead "You are out of pouche." 32
		endif
	endif

	// ####################################################################################
	// # HEAL
	// ####################################################################################
	if diffhits > 15 and diffhits < 35 and timer "heal_action_timer" >= var_heal_action_delay and findtype 3972 self and findtype 3973 self and findtype 3974 self and findtype 3981 self and not casting and not targetexists
		hotkey "> Smart Heal/Cure Self"
		settimer "heal_action_timer" 0
		wait var_greater_heal_action_delay
	elseif diffhits > 35
		@setvar! var_greater_heal_ready 0

		if findtype "Yellow Potion" self as found_potion
			getlabel found_potion found_potion_description

			if "next usable" in found_potion_description
				if timer "overhead_message_timer" >= var_message_debounce_delay
					overhead found_potion_description 83
					settimer "overhead_message_timer" 0
				endif
				@setvar! var_greater_heal_ready 1
			elseif not targetexists
				overhead "You drink a healing potion." 53
				dclick found_potion
				getlabel backpack ping
				cooldown "Heal Potion" var_heal_potion_cooldown
			endif
		else
			if timer "overhead_message_timer" >= var_message_debounce_delay
				overhead "You are out of healing potion." 32
				settimer "overhead_message_timer" 0
			endif
			@setvar! var_greater_heal_ready 1
		endif

		if var_greater_heal_ready = 1 and not targetexists and not casting and timer "heal_action_timer" >= var_heal_action_delay and timer "greater_heal_retry_timer" >= var_greater_heal_retry_delay and findtype 3972 self and findtype 3973 self and findtype 3974 self and findtype 3981 self
			hotkey "> Greater Heal/Cure Self"
			settimer "heal_action_timer" 0
			settimer "greater_heal_retry_timer" 0
			wait var_greater_heal_action_delay
		endif
	endif

	// ####################################################################################
	// # CURE POT
	// ####################################################################################
	if poisoned
		if findtype "Orange Potion" self as found_potion
			if hidden
				break
			endif

			if not targetexists
				overhead "You drink a cure potion." 53
				dclick found_potion
				getlabel backpack ping
			endif
		else
			if timer "overhead_message_timer" >= var_message_debounce_delay
				overhead "You are out of cure potion." 32
				settimer "overhead_message_timer" 0
			endif

			if not targetexists and not casting and timer "heal_action_timer" >= var_heal_action_delay and findtype 3972 self and findtype 3973 self
				hotkey "> Smart Heal/Cure Self"
				settimer "heal_action_timer" 0
			endif

			wait var_cure_action_delay
		endif
	endif

	// ####################################################################################
	// # STAMINA POT
	// ####################################################################################
	if stam < 5 and not targetexists
		if findtype "Red Potion" backpack as found_potion
			dclick found_potion
			wait var_global_delay
		else
			if timer "overhead_message_timer" >= var_message_debounce_delay
				overhead "You are out of refresh potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # STRENGTH POT
	// ####################################################################################
	if str <= 100 and var_use_potion = 1 and not targetexists and find var_combat_target ground -1 -1 12
		if findtype "White Potion" backpack as found_potion
			dclick found_potion
			wait var_global_delay
		else
			if timer "overhead_message_timer" >= var_message_debounce_delay
				overhead "You are out of strength potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # AGILITY POT
	// ####################################################################################
	if dex <= 25 and var_use_potion = 1 and not targetexists and find var_combat_target ground -1 -1 12
		if findtype "Blue Potion" backpack as found_potion
			dclick found_potion
			wait var_global_delay
		else
			if timer "overhead_message_timer" >= var_message_debounce_delay
				overhead "You are out of agility potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # RESIST POT
	// ####################################################################################
	if not findbuff 'Magic Resist Potion' and var_use_potion = 1 and not targetexists and find var_combat_target ground -1 -1 12
		if findtype "Black Potion" backpack as found_potion
			dclick found_potion
			wait var_global_delay
		else
			if timer "overhead_message_timer" >= var_message_debounce_delay
				overhead "You are out of magic resist potions." 32
				settimer "overhead_message_timer" 0
			endif
		endif
	endif

	// ####################################################################################
	// # MUSHROOM SUPPORT
	// ####################################################################################
	// Eval rotation spends mana in bursts, so keep a small mushroom buffer
	// between pulls and eat one while rotating to the next pack.
	if not targetexists and not casting and cooldown "Walk" = 0 and var_control_followup_ready = 0 and not find var_combat_target ground -1 -1 12
		if mana <= var_magic_mushroom_eat_mana and not findbuff 'Magic Mushroom Cooldown' and findtype "mushroom" backpack
			hotkey 'Eat Magic Mushroom'
			wait var_global_delay
		elseif skill "Magery" >= 30 and counttype "mushroom" backpack < var_magic_mushroom_min_count and mana >= var_magic_mushroom_create_mana and findtype 3972 self and findtype 3973 self and findtype 3974 self
			cast 'Create Food'
			wait var_first_circle_cast_delay
			getlabel backpack ping
			wait var_global_delay
		endif
	endif

	// ####################################################################################
	// # MAGE BUFF
	// ####################################################################################
	if not targetexists and var_control_followup_ready = 0
		if mana > 30
			if not casting and cooldown "Walk" = 0 and not find var_combat_target ground -1 -1 12 and findtype 3972 self and findtype 3974 self
				if not findbuff 'Strength' or not findbuff 'Agility' or not findbuff 'Cunning'
					cast 'Bless'
					wait var_bless_action_delay
					waitfortarget var_ui_delay
					hotkey 'Target Self'
					wait var_global_delay
				endif
			endif

			if not targetexists and not findbuff 'Protection' and cooldown "Walk" = 0 and findtype 3980 self and findtype 3972 self and findtype 3973 self and findtype 3974 self and not casting and find var_combat_target ground -1 -1 12
				cast 'Arch Protection'
				wait var_arch_protection_action_delay
				waitfortarget var_ui_delay
				hotkey 'Target Self'
				wait var_global_delay
			endif

			if not targetexists and not findbuff 'Reactive Armor' and cooldown "Walk" = 0 and findtype 3980 self and findtype 3972 self and findtype 3981 self and not casting
				cast 'Reactive Armor'
				wait var_reactive_armor_action_delay
				wait var_global_delay
			endif

			if not targetexists and not findbuff 'Magic Reflection' and cooldown "Reflect" = 0 and cooldown "Walk" = 0 and findtype 3972 self and findtype 3974 self and findtype 3981 self and not casting
				cast 'Magic Reflection'
				wait var_magic_reflection_action_delay
				wait var_global_delay
			endif
		endif
	endif

	// ####################################################################################
	// # BARD SONG BUFF
	// ####################################################################################
	// Song refresh targets the backpack, while combat logic continues to
	// rely on the internal cached target instead of rewriting last target.
	if not targetexists and not casting and var_control_followup_ready = 0 and cooldown "Discord" = 0 and cooldown "Music" = 0 and not findbuff "song of discordance"
		useskill 'Discordance'
		waitfortarget var_ui_delay

		if insysmsg "What instrument"
			target var_my_instrument
			replay
		elseif targetexists
			target backpack
			getlabel backpack ping
			wait var_global_delay
		endif
	endif

	if not targetexists and not casting and var_control_followup_ready = 0 and cooldown "Peace" = 0 and cooldown "Music" = 0 and not findbuff "song of peacemaking"
		useskill 'Peacemaking'
		waitfortarget var_ui_delay

		if insysmsg "What instrument"
			target var_my_instrument
			replay
		elseif targetexists
			target backpack
			getlabel backpack ping
			wait var_global_delay
		endif
	endif

	// ####################################################################################
	// # DISCO
	// ####################################################################################
	// Automatic offensive barding only runs out of warmode. In warmode,
	// the user handles offensive targeting manually.
	if not targetexists and not casting and not warmode and find var_combat_target ground -1 -1 10 as combat_target
		if skill "Discordance" > 0 and cooldown "Discord" = 0 and cooldown "Music" = 0
			getlabel combat_target target_label
			wait var_global_delay

			if "discord" in target_label
				// Target is already discorded.
			else
				clearsysmsg
				useskill 'Discordance'
				waitfortarget var_ui_delay

				if targetexists
					@setvar! var_pending_hostile_action 1
				else
					wait var_global_delay
				endif
			endif
		endif
	endif

	// ####################################################################################
	// # CONTROL FOLLOWUP
	// ####################################################################################
	// Once a target is Discorded, hold the magery opener until
	// Peacemaking has been attempted.
	if not targetexists and not casting and not warmode and find var_combat_target ground -1 -1 10 as combat_target
		if skill "Peacemaking" > 0 and cooldown "Peace" = 0 and cooldown "Music" = 0
			getlabel combat_target target_label
			wait var_global_delay

			if "pacified" in target_label or "barding break" in target_label
				if var_control_followup_target = combat_target
					@setvar! var_control_followup_target 0
				endif
			elseif "discord" in target_label or var_control_followup_target = combat_target
				settimer "control_followup_timer" 0
				clearsysmsg
				useskill 'Peacemaking'
				waitfortarget var_ui_delay

				if targetexists
					@setvar! var_pending_hostile_action 2
				else
					wait var_global_delay
				endif
			endif
		endif
	endif

	// ####################################################################################
	// # NECRO BURST OPENER
	// ####################################################################################
	// Blood Oath can happen first, but the rest of the necro burst waits
	// for Curse so the opener becomes Curse -> Evil Omen.
	if skill "Necromancy" >= 60 and var_necro_action_used = 0 and not targetexists and not casting and not warmode and find var_combat_target ground -1 -1 12 as combat_target
		if skill "Necromancy" >= 80 and followers > 0 and list 'necro_symbols' >= 4 and timer "blood_oath_timer" >= var_necro_action_ready_delay and not dead combat_target
			clearsysmsg
			hotkey 'blood oath'
			getlabel backpack ping
			wait var_global_delay

			if insysmsg "unholy symbols remaining"
				overhead "You cast Blood Oath." 44
				settimer "blood_oath_timer" 0
				@setvar! var_necro_action_used 1
				wait var_necro_commit_delay
			elseif insysmsg "seconds before you may use that ability again."
				settimer "blood_oath_timer" 0
				@setvar! var_necro_action_used 1
			endif
		endif
	endif

	// ####################################################################################
	// # CURSE OPENER
	// ####################################################################################
	// Decide opener progress from the current combat target's memory lists
	// so retargeting does not depend on a stale global stage value.
	// Peacemaking should preempt when it is ready, but it should not freeze
	// the opener while waiting for its barding window.
	if not targetexists and not casting and not warmode and find var_combat_target ground -1 -1 12 as combat_target
		if mana >= 30
			if inlist 'magic_cursed_targets' combat_target
				if var_magic_stage = 0
					@setvar! var_magic_stage 1
				endif
			else
				@setvar! var_magic_stage 0
			endif

			if skill "Magery" >= 40 and cooldown "Walk" = 0
				if not inlist 'magic_cursed_targets' combat_target and findtype 3972 self and findtype 3976 self and findtype 3980 self and mana >= var_fourth_circle_min_mana
					clearsysmsg
					cast 'Curse'
					wait var_fourth_circle_cast_delay
					waitfortarget var_magery_target_delay

					if targetexists
						while targetexists
							if find lasttarget ground -1 -1 12 as fresh_target
								if not dead fresh_target and var_combat_target != fresh_target
									if noto fresh_target = "hostile" or noto fresh_target = "criminal" or noto fresh_target = "enemy" or noto fresh_target = "murderer"
										@setvar! var_combat_target fresh_target
										settimer "combat_target_grace_timer" 0

										if inlist 'magic_cursed_targets' var_combat_target
											@setvar! var_magic_stage 1
										else
											@setvar! var_magic_stage 0
										endif
									endif
								endif
							endif

							if var_combat_target != combat_target
								hotkey "Cancel Current Target"
								wait var_global_delay
								break
							endif

							if dead combat_target
								hotkey "Cancel Current Target"
								wait var_global_delay
							else
								target combat_target
								wait var_global_delay
							endif
						endwhile

						if find combat_target ground -1 -1 12 as confirmed_target and not dead confirmed_target and var_combat_target = combat_target
							getlabel backpack ping
							wait var_global_delay

							if insysmsg "target cannot be seen"
								@setvar! var_magic_stage 0
							else
								overhead "You cast Curse." 44

								if not inlist 'magic_cursed_targets' var_combat_target
									pushlist 'magic_cursed_targets' var_combat_target
								endif

								@setvar! var_magic_stage 1
								wait var_global_delay
							endif
						endif
					else
						wait var_global_delay
					endif
				endif
			endif
		endif
	endif

	// ####################################################################################
	// # NECRO FOLLOWUP
	// ####################################################################################
	// Once Curse lands, queue Evil Omen before the proc burst.
	if not targetexists and not casting and not warmode and find var_combat_target ground -1 -1 12 as combat_target
		if inlist 'magic_cursed_targets' combat_target
			if var_magic_stage = 0
				@setvar! var_magic_stage 1
			endif

			if skill "Necromancy" >= 60 and var_necro_action_used = 0 and list 'necro_symbols' >= 2 and timer "evil_omen_timer" >= var_necro_action_ready_delay and not dead combat_target
				clearsysmsg
				hotkey 'evil omen'
				getlabel backpack ping
				wait var_global_delay

				if not insysmsg "unholy symbols remaining" and not insysmsg "seconds before you may use that ability again."
					yell '[EvilOmen'
					getlabel backpack ping
					wait var_global_delay
				endif

				if insysmsg "unholy symbols remaining"
					overhead "You cast Evil Omen." 44
					settimer "evil_omen_timer" 0
					@setvar! var_necro_action_used 1
					wait var_global_delay
				elseif insysmsg "seconds before you may use that ability again."
					settimer "evil_omen_timer" 0
					@setvar! var_necro_action_used 1
				endif
			endif
		endif

	endif

	// Use Vampiric Embrace only out of combat so it does not slow the opener
	// or finisher cadence. Any nearby corpse can satisfy the ability.
	if skill "Necromancy" >= 70 and var_necro_action_used = 0 and not targetexists and not casting and not warmode
		if var_combat_target = 0 or not find var_combat_target ground -1 -1 12
			if followers > 0 and list 'necro_symbols' >= 3 and timer "vampiric_embrace_timer" >= var_necro_action_ready_delay and findtype 8198 ground -1 -1 8 as nearby_corpse
				clearsysmsg
				gumpresponse 14 622436516
				waitfortarget var_fast_target_delay

				if targetexists
					hotkey 'Target Self'
					getlabel backpack ping
					wait var_global_delay

					if not targetexists
						if insysmsg "unholy symbols remaining"
							overhead "You cast Vampiric Embrace." 44
							settimer "vampiric_embrace_timer" 0
							@setvar! var_necro_action_used 1
						elseif insysmsg "seconds before you may use that ability again."
							settimer "vampiric_embrace_timer" 0
							@setvar! var_necro_action_used 1
						elseif insysmsg "You do not see any corpses near that location"
							settimer "vampiric_embrace_timer" var_vampiric_embrace_retry_delay
						elseif insysmsg "None of your followers currently require healing"
							settimer "vampiric_embrace_timer" var_vampiric_embrace_retry_delay
						endif
					endif
				endif
			endif
		endif
	endif

	// ####################################################################################
	// # EVAL DAMAGE ROTATION
	// ####################################################################################
	// Once Curse and Evil Omen are established, use the four proc spells
	// and finish the target with Flame Strike.
	if not targetexists and not casting and not warmode and find var_combat_target ground -1 -1 12 as combat_target
		if inlist 'magic_cursed_targets' combat_target
			if var_magic_stage = 0
				@setvar! var_magic_stage 1
			endif

			if skill "Magery" >= 0 and cooldown "Walk" = 0 and timer "magic_arrow_proc_timer" >= var_proc_ready_delay and mana >= var_first_circle_min_mana and findtype 3980 self
				clearsysmsg
				cast 'Magic Arrow'
				wait var_first_circle_cast_delay
				waitfortarget var_magery_target_delay

				if targetexists
					while targetexists
						if find lasttarget ground -1 -1 12 as fresh_target
							if not dead fresh_target and var_combat_target != fresh_target
								if noto fresh_target = "hostile" or noto fresh_target = "criminal" or noto fresh_target = "enemy" or noto fresh_target = "murderer"
									@setvar! var_combat_target fresh_target
									settimer "combat_target_grace_timer" 0

									if inlist 'magic_cursed_targets' var_combat_target
										@setvar! var_magic_stage 1
									else
										@setvar! var_magic_stage 0
									endif
								endif
							endif
						endif

						if var_combat_target != combat_target
							hotkey "Cancel Current Target"
							wait var_global_delay
							break
						endif

						if dead combat_target
							hotkey "Cancel Current Target"
							wait var_global_delay
						else
							target combat_target
							wait var_global_delay
						endif
					endwhile

					if find combat_target ground -1 -1 12 as confirmed_target and not dead confirmed_target and var_combat_target = combat_target
						getlabel backpack ping
						wait var_global_delay

						if not insysmsg "target cannot be seen"
							overhead "You cast Magic Arrow." 83
							settimer "magic_arrow_proc_timer" 0
							wait var_global_delay
						endif
					endif
				endif
			elseif skill "Magery" >= 20 and cooldown "Walk" = 0 and timer "harm_proc_timer" >= var_proc_ready_delay and mana >= var_second_circle_min_mana and findtype 3976 self and findtype 3981 self
				clearsysmsg
				cast 'Harm'
				wait var_second_circle_cast_delay
				waitfortarget var_magery_target_delay

				if targetexists
					while targetexists
						if find lasttarget ground -1 -1 12 as fresh_target
							if not dead fresh_target and var_combat_target != fresh_target
								if noto fresh_target = "hostile" or noto fresh_target = "criminal" or noto fresh_target = "enemy" or noto fresh_target = "murderer"
									@setvar! var_combat_target fresh_target
									settimer "combat_target_grace_timer" 0

									if inlist 'magic_cursed_targets' var_combat_target
										@setvar! var_magic_stage 1
									else
										@setvar! var_magic_stage 0
									endif
								endif
							endif
						endif

						if var_combat_target != combat_target
							hotkey "Cancel Current Target"
							wait var_global_delay
							break
						endif

						if dead combat_target
							hotkey "Cancel Current Target"
							wait var_global_delay
						else
							target combat_target
							wait var_global_delay
						endif
					endwhile

					if find combat_target ground -1 -1 12 as confirmed_target and not dead confirmed_target and var_combat_target = combat_target
						getlabel backpack ping
						wait var_global_delay

						if not insysmsg "target cannot be seen"
							overhead "You cast Harm." 83
							settimer "harm_proc_timer" 0
							wait var_global_delay
						endif
					endif
				endif
			elseif skill "Magery" >= 30 and cooldown "Walk" = 0 and timer "fireball_proc_timer" >= var_proc_ready_delay and mana >= var_third_circle_min_mana and findtype 3962 self
				clearsysmsg
				cast 'Fireball'
				wait var_third_circle_cast_delay
				waitfortarget var_magery_target_delay

				if targetexists
					while targetexists
						if find lasttarget ground -1 -1 12 as fresh_target
							if not dead fresh_target and var_combat_target != fresh_target
								if noto fresh_target = "hostile" or noto fresh_target = "criminal" or noto fresh_target = "enemy" or noto fresh_target = "murderer"
									@setvar! var_combat_target fresh_target
									settimer "combat_target_grace_timer" 0

									if inlist 'magic_cursed_targets' var_combat_target
										@setvar! var_magic_stage 1
									else
										@setvar! var_magic_stage 0
									endif
								endif
							endif
						endif

						if var_combat_target != combat_target
							hotkey "Cancel Current Target"
							wait var_global_delay
							break
						endif

						if dead combat_target
							hotkey "Cancel Current Target"
							wait var_global_delay
						else
							target combat_target
							wait var_global_delay
						endif
					endwhile

					if find combat_target ground -1 -1 12 as confirmed_target and not dead confirmed_target and var_combat_target = combat_target
						getlabel backpack ping
						wait var_global_delay

						if not insysmsg "target cannot be seen"
							overhead "You cast Fireball." 83
							settimer "fireball_proc_timer" 0
							wait var_global_delay
						endif
					endif
				endif
			elseif skill "Magery" >= 40 and cooldown "Walk" = 0 and timer "lightning_proc_timer" >= var_proc_ready_delay and mana >= var_fourth_circle_min_mana and findtype 3974 self and findtype 3980 self
				clearsysmsg
				cast 'Lightning'
				wait var_fourth_circle_cast_delay
				waitfortarget var_magery_target_delay

				if targetexists
					while targetexists
						if find lasttarget ground -1 -1 12 as fresh_target
							if not dead fresh_target and var_combat_target != fresh_target
								if noto fresh_target = "hostile" or noto fresh_target = "criminal" or noto fresh_target = "enemy" or noto fresh_target = "murderer"
									@setvar! var_combat_target fresh_target
									settimer "combat_target_grace_timer" 0

									if inlist 'magic_cursed_targets' var_combat_target
										@setvar! var_magic_stage 1
									else
										@setvar! var_magic_stage 0
									endif
								endif
							endif
						endif

						if var_combat_target != combat_target
							hotkey "Cancel Current Target"
							wait var_global_delay
							break
						endif

						if dead combat_target
							hotkey "Cancel Current Target"
							wait var_global_delay
						else
							target combat_target
							wait var_global_delay
						endif
					endwhile

					if find combat_target ground -1 -1 12 as confirmed_target and not dead confirmed_target and var_combat_target = combat_target
						getlabel backpack ping
						wait var_global_delay

						if not insysmsg "target cannot be seen"
							overhead "You cast Lightning." 83
							settimer "lightning_proc_timer" 0
							@setvar! var_magic_stage 2
							wait var_global_delay
						endif
					endif
				endif
			elseif var_magic_stage >= 2 and cooldown "Walk" = 0 and mana >= var_seventh_circle_min_mana and findtype 3981 self and findtype 3980 self
				clearsysmsg
				cast 'flamestrike'
				wait var_seventh_circle_cast_delay
				waitfortarget var_magery_target_delay

				if targetexists
					while targetexists
						if find lasttarget ground -1 -1 12 as fresh_target
							if not dead fresh_target and var_combat_target != fresh_target
								if noto fresh_target = "hostile" or noto fresh_target = "criminal" or noto fresh_target = "enemy" or noto fresh_target = "murderer"
									@setvar! var_combat_target fresh_target
									settimer "combat_target_grace_timer" 0

									if inlist 'magic_cursed_targets' var_combat_target
										@setvar! var_magic_stage 1
									else
										@setvar! var_magic_stage 0
									endif
								endif
							endif
						endif

						if var_combat_target != combat_target
							hotkey "Cancel Current Target"
							wait var_global_delay
							break
						endif

						if dead combat_target
							hotkey "Cancel Current Target"
							wait var_global_delay
						else
							target combat_target
							wait var_global_delay
						endif
					endwhile

					if find combat_target ground -1 -1 12 as confirmed_target and not dead confirmed_target and var_combat_target = combat_target
						getlabel backpack ping
						wait var_global_delay

						if not insysmsg "target cannot be seen"
							overhead "You cast Flame Strike." 83
							wait var_global_delay
						endif
					endif
				endif
			else
				wait var_global_delay
			endif
		endif
	endif

	// ####################################################################################
	// # OFFENSIVE BARD TARGET DELIVERY
	// ####################################################################################
	// Keep Discord and Peace delivery in one place so instrument prompts
	// and stale-target protection stay centralized.
	if var_pending_hostile_action != 0
		if targetexists and find var_combat_target ground -1 -1 12 as combat_target
			while targetexists
				if insysmsg "What instrument shall you play"
					target var_my_instrument
					replay
				endif

				if find lasttarget ground -1 -1 12 as fresh_target
					if not dead fresh_target and var_combat_target != fresh_target
						if noto fresh_target = "hostile" or noto fresh_target = "criminal" or noto fresh_target = "enemy" or noto fresh_target = "murderer"
							@setvar! var_combat_target fresh_target
							settimer "combat_target_grace_timer" 0

							if inlist 'magic_cursed_targets' var_combat_target
								@setvar! var_magic_stage 1
							else
								@setvar! var_magic_stage 0
							endif
						endif
					endif
				endif

				if var_combat_target != combat_target
					hotkey "Cancel Current Target"
					wait var_global_delay
					break
				endif

				if dead combat_target
					hotkey "Cancel Current Target"
					wait var_global_delay
				else
					target combat_target
					wait var_global_delay
				endif
			endwhile

			if find combat_target ground -1 -1 12 as confirmed_target and not dead confirmed_target and var_combat_target = combat_target
				if var_pending_hostile_action = 1
					settimer "control_followup_timer" 0

					for 4
						getlabel confirmed_target target_label

						if "discord" in target_label
							@setvar! var_control_followup_target combat_target
							settimer "control_followup_timer" 0
							break
						endif

						wait var_poll_wait
					endfor

					wait var_global_delay
				elseif var_pending_hostile_action = 2
					settimer "control_followup_timer" 0

					for 4
						getlabel confirmed_target target_label

						if "pacified" in target_label or "barding break" in target_label
							@setvar! var_control_followup_target 0
							break
						endif

						wait var_poll_wait
					endfor

					wait var_global_delay
				endif
			endif
		elseif targetexists
			hotkey "Cancel Current Target"
			wait var_global_delay
		endif

		@setvar! var_pending_hostile_action 0
	endif

	// ####################################################################################
	// # SCAVENGER UTILITY
	// ####################################################################################
	if timer "clear_scavenger_timer" >= var_scavenger_clear_delay
		sysmsg "Clear Scavenger Cache"
		hotkey "Clear Scavenger Cache"
		settimer "clear_scavenger_timer" 0
	endif
endwhile
