// ####################################################################################
// # VENDOR MAP RESTOCK
// ####################################################################################
// Moves maps from your backpack onto the vendor one stack at a time, tells you what to
// charge, and waits while you type it.
//
// WHY THE PRICE IS TYPED BY HAND - this is a hard limit, not an oversight.
//   Razor scripts cannot type into a gump text field. gumpresponse sends only a button
//   script layer. Recorded macros can carry text, scripts cannot.
//   Neither alternative works for maps:
//     - Text prompt (pricing menu OFF): the number becomes the FLAT TOTAL for the stack,
//       not a per item price, and re-dropping merges into the stack already on the vendor.
//     - Pricing Manifest: shows Not Available For Item for maps. It does hold prices
//       for many other item types, and for those the gump can be driven end to end,
//       but maps are not in it.
//   So the script does everything except the typing, and prints the price you need.
//
// PREREQUISITE
//   Vendor Settings -> Use Item Pricing Menu must be ON so gump 685310710 opens.
//   Same gump as script/restock/store-keg.razor:10.
//
// HOW IT RUNS
//   For each map type: read its label -> lift the WHOLE stack -> drop it on the vendor ->
//   the pricing gump opens -> overhead prints the map name and the per item price from
//   the table below -> the script waits until you finish and the gump is really gone ->
//   next map type. One gump per map type, not per map.
//   Clicking the small orb refreshes the gump, which briefly makes it look closed, so the
//   script confirms it stays closed for config__delay_gump_settle before moving on.
//   To bail out mid run, toggle war mode.
//
// To narrow what gets placed, edit the graphic list on the findtype line:
//   5356 treasure, 70151 lumber, 70154 ore, 70157 skinning.

clearsysmsg
clearall
clearignore
cleardragdrop

// ####################################################################################
// # CONFIG
// ####################################################################################
// 0 = stop on each gump so you can type the price.
// 1 = press Place Item for Sale automatically. Everything lands at the default 99,999
//     and is not for sale for 6 hours. There is no bulk pricing screen, so you would
//     still have to open each item on the vendor to price it. Rarely what you want.
@setvar! config__auto_place 0

// UO caps a stack at 60000, so this grabs the whole stack in one go instead of one map
// at a time. With the pricing gump open, a stackable defaults to Sell By Stack Price
// (each), so the number you type is the per item price for the entire stack.
@setvar! config__lift_amount 60000

@setvar! config__delay_lift 600
@setvar! config__delay_place 800
@setvar! config__delay_poll 200
// How long the gump must stay closed before the script accepts that you are done.
// Raise this if it still jumps ahead while you are typing.
@setvar! config__delay_gump_settle 1200

// ####################################################################################
// # CONFIG - PER ITEM PRICES
// ####################################################################################
// Shown as an overhead hint only. The script never sends these, you type them.
// Source of truth is library/vendor-prices.md.
@setvar! config__price_treasure_lv1 '5000'
@setvar! config__price_treasure_lv2 '10000'
@setvar! config__price_treasure_lv3 '20000'
@setvar! config__price_treasure_lv4 '30000'
@setvar! config__price_treasure_lv5 '50000'

@setvar! config__price_ore_dull_copper '7000'
@setvar! config__price_ore_shadow_iron '10000'
@setvar! config__price_ore_gold '20000'
@setvar! config__price_ore_agapite '25000'
@setvar! config__price_ore_verite '40000'
@setvar! config__price_ore_valorite '52000'
@setvar! config__price_ore_avarite '100000'

@setvar! config__price_lumber_goldenwood '2000'
@setvar! config__price_lumber_rosewood '2500'
@setvar! config__price_lumber_valewood '8000'
@setvar! config__price_lumber_avarwood '50000'

@setvar! config__price_hide_shadowhide '100'
@setvar! config__price_hide_dullhide '100'
@setvar! config__price_hide_bronzehide '500'
@setvar! config__price_hide_goldenhide '800'
@setvar! config__price_hide_rosehide '1000'
@setvar! config__price_hide_verehide '5000'

// ####################################################################################
// # VENDOR TARGET
// ####################################################################################
if warmode
    hotkey "Toggle War/Peace"
    wait 500
endif

// Asked every run on purpose. Caching this is how items end up in the wrong container.
overhead "Target the vendor to stock:" 55
@setvar! var__vendor_target
wait 1000

if not varexist var__vendor_target
    overhead "No vendor selected." 33
    stop
endif

// ####################################################################################
// # PLACE MAPS
// ####################################################################################
while findtype 5356|70151|70154|70157 backpack as alias__found_map
    getlabel alias__found_map label__map
    @setvar! var__price_hint 'not in table'

    if "plainly drawn" in label__map
        @setvar! var__price_hint config__price_treasure_lv1
    elseif "expertly drawn" in label__map
        @setvar! var__price_hint config__price_treasure_lv2
    elseif "adeptly drawn" in label__map
        @setvar! var__price_hint config__price_treasure_lv3
    elseif "cleverly drawn" in label__map
        @setvar! var__price_hint config__price_treasure_lv4
    elseif "deviously drawn" in label__map
        @setvar! var__price_hint config__price_treasure_lv5
    elseif "dull copper" in label__map
        @setvar! var__price_hint config__price_ore_dull_copper
    elseif "shadow iron" in label__map
        @setvar! var__price_hint config__price_ore_shadow_iron
    elseif "agapite" in label__map
        @setvar! var__price_hint config__price_ore_agapite
    elseif "verite" in label__map
        @setvar! var__price_hint config__price_ore_verite
    elseif "valorite" in label__map
        @setvar! var__price_hint config__price_ore_valorite
    elseif "avarite" in label__map
        @setvar! var__price_hint config__price_ore_avarite
    elseif "goldenwood" in label__map
        @setvar! var__price_hint config__price_lumber_goldenwood
    elseif "rosewood" in label__map
        @setvar! var__price_hint config__price_lumber_rosewood
    elseif "valewood" in label__map
        @setvar! var__price_hint config__price_lumber_valewood
    elseif "avarwood" in label__map
        @setvar! var__price_hint config__price_lumber_avarwood
    elseif "shadowhide" in label__map
        @setvar! var__price_hint config__price_hide_shadowhide
    elseif "dullhide" in label__map
        @setvar! var__price_hint config__price_hide_dullhide
    elseif "bronzehide" in label__map
        @setvar! var__price_hint config__price_hide_bronzehide
    elseif "goldenhide" in label__map
        @setvar! var__price_hint config__price_hide_goldenhide
    elseif "rosehide" in label__map
        @setvar! var__price_hint config__price_hide_rosehide
    elseif "verehide" in label__map
        @setvar! var__price_hint config__price_hide_verehide
    elseif "gold" in label__map
        @setvar! var__price_hint config__price_ore_gold
    endif

    lift alias__found_map config__lift_amount
    wait config__delay_lift
    drop var__vendor_target
    waitforgump 685310710 3000

    if not gumpexists 685310710
        overhead "Pricing gump did not open." 33
        overhead "Turn ON Use Item Pricing Menu in Vendor Settings." 33
        @clearignore
        stop
    endif

    if config__auto_place = 1
        gumpresponse 16 685310710
        wait config__delay_place
    else
        overhead "{{label__map}}" 55
        overhead "each: {{var__price_hint}}" 88

        // The gump blinks shut every time the orb is clicked, so a single gumpexists
        // check is not enough. Require it to stay gone.
        @setvar! var__gump_done 0

        while var__gump_done = 0
            if warmode
                overhead "Aborted." 33
                @clearignore
                stop
            endif

            if gumpexists 685310710
                wait config__delay_poll
            else
                wait config__delay_gump_settle

                if not gumpexists 685310710
                    @setvar! var__gump_done 1
                endif
            endif
        endwhile
    endif

    // Guards against an endless loop if the stack came back to the backpack.
    @ignore alias__found_map
endwhile

@clearignore
overhead "All maps placed." 53
