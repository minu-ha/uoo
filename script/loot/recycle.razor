@setvar! var__chainmail_storage var__save_container
@setvar! var__plate_storage var__save_container

@setvar! var__source_container backpack

# Scratch values, set and read inside each item block.
#   save_item     1 when the item carries a kept property
#   recycle_item  1 until the item goes to identification instead
#   save_to       armor: the container its material goes to
@setvar! var__save_item 0
@setvar! var__recycle_item 0
@setvar! var__save_to 0

# ####################################################################################
# # TOOLS
# ####################################################################################
# Identification by container (Item Identification 120), by skill, or by the single item wand.
# Without any of them, or without a recycling tool, the script returns to the loop.
if skill "Item Identification" = 120
    # Identifies the whole container.
elseif skill "Item Identification" >= 100
    # Identifies by skill.
elseif findtype 20496 backpack as alias__id_wand
    # Identifies with the wand.
elseif findtype 20495 backpack as alias__id_wand
    overhead "[ id wand, wrong ]" 254
    sysmsg "Recycle: the ID wand must be the single item wand (20496)." 88
    if listexists 'list__resume_script'
        foreach resume_hotkey in list__resume_script
            hotkey resume_hotkey
        endfor
    endif
    stop
elseif skill "Item Identification" >= config__min_item_id_skill
    # Identifies by skill.
else
    overhead "[ item id, out ]" 254
    sysmsg "Recycle: needs Item Identification or the single item ID wand (20496)." 88
    if listexists 'list__resume_script'
        foreach resume_hotkey in list__resume_script
            hotkey resume_hotkey
        endfor
    endif
    stop
endif

if not findtype 4032|4032|3997|7864|4148|4136 backpack
    overhead "[ recycle tool, out ]" 254
    sysmsg "Recycle: needs a tinker tool, sewing kit or saw." 88
    if listexists 'list__resume_script'
        foreach resume_hotkey in list__resume_script
            hotkey resume_hotkey
        endfor
    endif
    stop
endif

@clearignore

# ####################################################################################
# # ITEMS
# ####################################################################################
# Each kind is checked in turn: a kept property saves the item, an unidentified one is sent to
# identification and seen again next run, the rest is recycled. Exceptional and aspect items stay.
# Hue 0 spellbooks (3834) and daggers (3922) are left alone.
while findtype 3834|3922 var__source_container 0 as alias__item
    @ignore alias__item
endwhile

# ####################################################################################
# # ARCANE STAFFS
# ####################################################################################
while findtype 31017|31019|31021|31023|31025|31027|31029|31031|31033|31035|31037|31038|31041|31043|31045|31047|31049|31051|31053|31055 var__source_container as alias__item
    getlabel alias__item label__item
    if config__sysmsg = 1
        sysmsg "Recycle check: {{label__item}}" 88
    endif
    @setvar! var__save_item 0
    @setvar! var__recycle_item 1
    if config__save_greater_slaying = 1 and "slaying" in label__item and "greater" in label__item
        @setvar! var__save_item 1
    elseif config__save_lesser_slaying = 1 and "slaying" in label__item and "lesser" in label__item
        @setvar! var__save_item 1
    elseif config__save_supremely = 1 and "supremely" in label__item
        @setvar! var__save_item 1
    elseif config__save_exceedingly = 1 and "exceedingly" in label__item
        @setvar! var__save_item 1
    elseif config__save_eminently = 1 and "eminently" in label__item
        @setvar! var__save_item 1
    elseif config__save_surpassingly = 1 and "surpassingly" in label__item
        @setvar! var__save_item 1
    elseif config__save_accurate = 1 and "accurate" in label__item
        @setvar! var__save_item 1
    elseif config__save_vanquishing = 1 and "vanquishing" in label__item
        @setvar! var__save_item 1
    elseif config__save_power = 1 and "power" in label__item
        @setvar! var__save_item 1
    elseif config__save_force = 1 and "force" in label__item
        @setvar! var__save_item 1
    elseif config__save_might = 1 and "might" in label__item
        @setvar! var__save_item 1
    elseif config__save_ruin = 1 and "ruin" in label__item
        @setvar! var__save_item 1
    elseif config__save_regular_slaying = 1 and "slaying" in label__item
        if "lesser" in label__item
            # A lesser one follows config__save_lesser_slaying above.
        else
            @setvar! var__save_item 1
        endif
    endif

    if "unidentified" in label__item
        if skill "Item Identification" = 120
            useskill "itemId"
            waitfortarget wait__target
            target var__source_container
            wait wait__item_id
            @setvar! var__recycle_item 0
        elseif findtype 20496 backpack as alias__id_wand
            dclick alias__id_wand
            waitfortarget wait__target
            target alias__item
            @setvar! var__recycle_item 0
        elseif skill "Item Identification" >= config__min_item_id_skill
            useskill "itemId"
            waitfortarget wait__target
            target alias__item
            wait wait__item_id
            @setvar! var__recycle_item 0
        endif
    endif

    if var__save_item = 1
        if config__chatty = 1
            overhead "[ item, saving ]" 290
        endif
        if config__sysmsg = 1
            sysmsg "Recycle save: {{label__item}}" 88
        endif
        lift alias__item
        drop var__staff_storage 0 0 0
        wait wait__item
        @ignore alias__item
    endif

    if var__recycle_item = 1
        if find alias__item backpack
            if config__save_exceptional = 1 and "exceptional" in label__item
                # Exceptional craft is kept.
            elseif "aspect" in label__item
                # Aspect items are kept.
            else
                if not gumpexists 949095101
                    if findtype 4032|3997|7864|4148|4136 backpack as alias__recycle_tool
                        dclick alias__recycle_tool
                        waitforgump 949095101 wait__gump
                    endif
                endif
                if gumpexists 949095101
                    gumpresponse 3 949095101
                    waitfortarget wait__target
                    target alias__item
                endif
            endif
        endif
        @ignore alias__item
    endif
endwhile

