        @setvar! var__price_hint var__price_mastery_tinkering
        @setvar! var__drop_x 115
        @setvar! var__drop_y 329
    elseif "tracking" in label__item
        @setvar! var__price_hint var__price_mastery_tracking
        @setvar! var__drop_x 130
        @setvar! var__drop_y 329
    elseif "veterinary" in label__item
        @setvar! var__price_hint var__price_mastery_veterinary
        @setvar! var__drop_x 145
        @setvar! var__drop_y 329
    endif

    # ### PLACE ON VENDOR
    lift alias__place_item var__lift_amount
    wait var__delay_lift
    drop var__vendor_container var__drop_x var__drop_y 0
    waitforgump 685310710 3000

    if not gumpexists 685310710
        overhead "Pricing gump did not open." 33
        overhead "Turn ON Use Item Pricing Menu in Vendor Settings." 33
        @clearignore
        stop
    endif

    if var__auto_place = 1
        gumpresponse 16 685310710
        wait var__delay_place
    else
        overhead "{{label__item}} : {{var__price_hint}}" 88
        settimer "timer__hint_repeat" 0

        @setvar! var__gump_done 0

        while var__gump_done = 0
            if timer "timer__hint_repeat" >= var__delay_hint_repeat
                overhead "{{label__item}} : {{var__price_hint}}" 88
                settimer "timer__hint_repeat" 0
            endif

            if warmode
                overhead "Aborted." 33
                @clearignore
                stop
            endif

            if gumpexists 685310710
                wait var__delay_poll
            else
                wait var__delay_gump_settle

                if not gumpexists 685310710
                    @setvar! var__gump_done 1
                endif
            endif
        endwhile
    endif
endfor

@clearignore
overhead "All items placed." 53
