# ----------------------------------------------------------------------------------------
# A Magic Arrow on self for the Spell Siphon buff, never with Magic Reflection up.
#
# @ hotkeys Cancel Current Target, Target Self
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # SPELL SIPHON
    #
    # The first spell to hit us starts a sixty minute buff that shows on the buff bar. A
    # Magic Arrow on self is that hit. Never with Magic Reflection up, the arrow would
    # only bounce off it and burn the reflection. Any disturb line an earlier cast left is
    # read off first, so the poll only sees its own. Before self is targeted, lasttarget
    # is read once more, the way bard/song does.
    #
    # It goes on a pass when buff/spells cast nothing, var__buff_cast, so Reactive Armor
    # and Magic Reflection come first. Then it clears the flag for the next pass.
    # ------------------------------------------------------------------------------------
    if var__buff_cast = 0 and not findbuff 'Spell Siphon' and not findbuff 'Magic Reflection' and var__regs_magic_arrow = 1 and mana >= config__mana_1st and not warmode and not targetexists and not casting and cooldown "walk" = 0
        if insysmsg "Your concentration is disturbed, thus ruining thy spell."
            # consumed, nothing else to do
        endif

        cast 'Magic Arrow'

        for 60
            if targetexists
                break
            endif

            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                break
            endif

            wait wait__poll
        endfor

        if targetexists
            @setvar! var__keep_lasttarget 0

            if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                    if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                        @setvar! var__keep_lasttarget 1
                    endif
                endif
            endif

            if var__keep_lasttarget = 1
                hotkey "Cancel Current Target"
                wait wait__short
            else
                hotkey 'Target Self'
                wait wait__cast
            endif
        endif
    endif

    @setvar! var__buff_cast 0
