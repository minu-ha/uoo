# ----------------------------------------------------------------------------------------
# The four Grimoire proc spells, each on its own bar, cheapest first.
#
# @ hotkeys > Interrupt, Cancel Current Target
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__proc_target
#      The mob the last proc spell went at. Poison Strike waits until it is the current
#      target.
#
#   var__procs_done
#      1 once no proc is ready, each on its bar or out of reagents. Poison Strike and the
#      filler wait for it.
# ----------------------------------------------------------------------------------------
if not varexist var__proc_target
    @setvar! var__proc_target 0
endif
@setvar! var__procs_done 0


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # PROC CORE
    #
    # The four Grimoire proc spells. Each carries a large first cast bonus on its own
    # timer, and the game announces when that timer is back, so cooldowns.xml already
    # tracks them and this block simply reads the bars. No timer of our own, which also
    # means the script inherits any cooldown reset the game hands out.
    #
    #   magic arrow  +250% on the first cast in the window
    #   harm         +250%
    #   fireball     +250% as a burn over 15 seconds
    #   lightning    +200% and a hinder
    #
    # Ordered cheapest first. They rarely compete, because a spell whose bar is up is the
    # only one asking, but when two are ready together the cheap one going first keeps
    # more mana available for the opener on the next mob.
    #
    # Each delivery records its mob in var__proc_target, and the flag after this block
    # tells Poison Strike and the filler whether the core is spent. Both wait for it.
    # ------------------------------------------------------------------------------------
    if cooldown "magic arrow" = 0 and var__regs_magic_arrow = 1 and mana >= config__mana_1st and var__opener_done = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0
        if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
            cast 'Magic Arrow'

            for 60
                if targetexists
                    break
                endif

                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                    break
                endif

                if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                    if config__chatty = 1
                        overhead "[ magic arrow, cut ]" 254
                    endif

                    hotkey "> Interrupt"
                    break
                endif

                wait wait__poll
            endfor

            if targetexists
                if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                    if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                        if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                            @setvar! var__combat_target alias__fresh_target
                            settimer "timer__target_grace" 0

                            if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                                if config__chatty = 1
                                    overhead "[ target, set ]" 1288 var__combat_target
                                endif
                            endif
                        endif
                    endif
                endif

                if dead alias__proc_target or var__combat_target != alias__proc_target
                    hotkey "Cancel Current Target"
                    wait wait__short
                else
                    target alias__proc_target
                    wait wait__cast
                    @setvar! var__proc_target var__combat_target
                endif
            endif
        endif
    elseif cooldown "harm" = 0 and var__regs_harm = 1 and mana >= config__mana_2nd and var__opener_done = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0
        if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
            cast 'Harm'

            for 60
                if targetexists
                    break
                endif

                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                    break
                endif

                if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                    if config__chatty = 1
                        overhead "[ harm, cut ]" 254
                    endif

                    hotkey "> Interrupt"
                    break
                endif

                wait wait__poll
            endfor

            if targetexists
                if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                    if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                        if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                            @setvar! var__combat_target alias__fresh_target
                            settimer "timer__target_grace" 0

                            if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                                if config__chatty = 1
                                    overhead "[ target, set ]" 1288 var__combat_target
                                endif
                            endif
                        endif
                    endif
                endif

                if dead alias__proc_target or var__combat_target != alias__proc_target
                    hotkey "Cancel Current Target"
                    wait wait__short
                else
                    target alias__proc_target
                    wait wait__cast
                    @setvar! var__proc_target var__combat_target
                endif
            endif
        endif
    elseif cooldown "fireball" = 0 and var__regs_fireball = 1 and mana >= config__mana_3rd and var__opener_done = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0
        if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
            cast 'Fireball'

            for 60
                if targetexists
                    break
                endif

                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                    break
                endif

                if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                    if config__chatty = 1
                        overhead "[ fireball, cut ]" 254
                    endif

                    hotkey "> Interrupt"
                    break
                endif

                wait wait__poll
            endfor

            if targetexists
                if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                    if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                        if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                            @setvar! var__combat_target alias__fresh_target
                            settimer "timer__target_grace" 0

                            if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                                if config__chatty = 1
                                    overhead "[ target, set ]" 1288 var__combat_target
                                endif
                            endif
                        endif
                    endif
                endif

                if dead alias__proc_target or var__combat_target != alias__proc_target
                    hotkey "Cancel Current Target"
                    wait wait__short
                else
                    target alias__proc_target
                    wait wait__cast
                    @setvar! var__proc_target var__combat_target
                endif
            endif
        endif
    elseif cooldown "lightning" = 0 and var__regs_lightning = 1 and mana >= config__mana_4th and var__opener_done = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0
        if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
            cast 'Lightning'

            for 60
                if targetexists
                    break
                endif

                if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                    break
                endif

                if config__interrupt_to_heal = 1 and diffhits >= config__emergency_hits
                    if config__chatty = 1
                        overhead "[ lightning, cut ]" 254
                    endif

                    hotkey "> Interrupt"
                    break
                endif

                wait wait__poll
            endfor

            if targetexists
                if find lasttarget ground -1 -1 config__acquire_range as alias__fresh_target
                    if not dead alias__fresh_target and var__combat_target != alias__fresh_target
                        if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                            @setvar! var__combat_target alias__fresh_target
                            settimer "timer__target_grace" 0

                            if find var__combat_target ground -1 -1 config__target_range as alias__proc_target
                                if config__chatty = 1
                                    overhead "[ target, set ]" 1288 var__combat_target
                                endif
                            endif
                        endif
                    endif
                endif

                if dead alias__proc_target or var__combat_target != alias__proc_target
                    hotkey "Cancel Current Target"
                    wait wait__short
                else
                    target alias__proc_target
                    wait wait__cast
                    @setvar! var__proc_target var__combat_target
                endif
            endif
        endif
    endif

    # Poison Strike and the filler wait for the whole proc core. Every proc that lands while
    # Corpse Skin is up leaves its disease on the target, so a strike after Magic Arrow alone
    # pops one stack where four were on the way, and a bolt cast while a proc is ready pushes
    # that proc and its next window back by a whole cast.
    #
    # This has to be a flag. A cast does not end the pass, so every block below still gets
    # its turn, which is how both used to go out straight behind Curse and the first proc.
    #
    # 1 once no proc is ready, each one either on its bar or out of reagents. A missing
    # reagent is the same escape the opener takes, it is not coming back until the next
    # restock. Low mana is not, for the reason given at the opener. Read after the proc core
    # has had its turn, so a proc cast this pass already counts. A bar whose message has not
    # arrived yet reads as ready, which only holds both back one pass.
    if cooldown "magic arrow" = 0 and var__regs_magic_arrow = 1
        @setvar! var__procs_done 0
    elseif cooldown "harm" = 0 and var__regs_harm = 1
        @setvar! var__procs_done 0
    elseif cooldown "fireball" = 0 and var__regs_fireball = 1
        @setvar! var__procs_done 0
    elseif cooldown "lightning" = 0 and var__regs_lightning = 1
        @setvar! var__procs_done 0
    else
        @setvar! var__procs_done 1
    endif
