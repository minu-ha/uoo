# Strength and Agility by stat value, Magic Resist by its icon, while var__fighting is 1.
#@ hotkeys Drink Strength, Drink Agility, Drink Magic Resist


#@ config ------------------------------------------------------------------------------------------

# 1 keeps the Magic Resist potion up.
@setvar! config__use_resist_potion 1

# STR with the Greater Strength potion on: your base plus 20. Below it the potion is drunk,
# and 0 turns it off. Bless and the Strength spell, ours or an ally's, show the same icon as
# the potion but add less than its 20, so the stat tells them apart.
@setvar! config__str_potion 120

# DEX with the Greater Agility potion on: your base plus 20. Below it the potion is drunk,
# and 0 turns it off. Bless and the Agility spell show the same icon, as for STR.
@setvar! config__dex_potion 100


#@ wait --------------------------------------------------------------------------------------------

# A Strength or Agility potion is tried once per window. The stat arrives a round trip after the
# drink, and a Curse, Weaken or Clumsy can hold it under the line while the potion still runs:
# without the window that refused drink would go out every pass. An empty bag is looked up at
# the same pace.
@setvar! cooldown__stat_potion 5000


#@ timer -------------------------------------------------------------------------------------------

timer__str_potion cooldown__stat_potion
timer__agi_potion cooldown__stat_potion


#@ loop --------------------------------------------------------------------------------------------
    # ################################################################################
    # # STAT POTIONS
    # ################################################################################
    # Kept up while var__fighting is 1. Strength and Agility read the stat against config__str_potion
    # and config__dex_potion, because Bless and the Strength and Agility spells show the same
    # icons as the potions, and each is tried once per cooldown__stat_potion. Magic Resist has an
    # icon of its own and is drunk once it is missing. Each potion is judged on its own, so
    # running out of one does not hold up the others.
    if var__fighting = 1 and config__use_potions = 1 and not paralyzed and not hidden and not targetexists
        if not queued and str < config__str_potion and timer "timer__str_potion" >= cooldown__stat_potion
            settimer "timer__str_potion" 0
            if findtype "White Potion" self
                hotkey "Drink Strength"
                wait wait__short
            endif
        endif
        if not queued and dex < config__dex_potion and timer "timer__agi_potion" >= cooldown__stat_potion
            settimer "timer__agi_potion" 0
            if findtype "Blue Potion" self
                hotkey "Drink Agility"
                wait wait__short
            endif
        endif
        if config__use_resist_potion = 1 and not queued and not findbuff "Magic Resist Potion"
            if findtype "Black Potion" self
                hotkey "Drink Magic Resist"
                wait wait__short
            endif
        endif
    endif
