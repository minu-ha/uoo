# ----------------------------------------------------------------------------------------
# Eats a Magic Mushroom at low mana, and makes more with Create Food at high mana.
# Create Food goes out of a fight only (var__fighting 0).
#
# @ hotkeys Eat Magic Mushroom
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__mushroom_eat_mana
#      Mana at or below which a mushroom is eaten.
#
#   config__mushroom_create_mana
#      Mana at or above which Create Food makes more. Create Food T3 returns 25 mana on a
#      60 second cooldown.
#
#   config__mushroom_min_count
#      Mushrooms kept in the backpack: Create Food runs only below this.
# ----------------------------------------------------------------------------------------
@setvar! config__mushroom_eat_mana 55
@setvar! config__mushroom_create_mana 70
@setvar! config__mushroom_min_count 2


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # MUSHROOM
    #
    # Eating is an item use, so like a potion it goes out during a cast and on the move,
    # and waits only for a held cursor. Create Food is a cast and waits for a fight to end,
    # so its 60 second cooldown burns on the walk rather than taking a cast from the
    # rotation. It also stands down in warmode and for the walk bar.
    # ------------------------------------------------------------------------------------
    if mana <= config__mushroom_eat_mana and not findbuff 'Magic Mushroom Cooldown' and not hidden and not queued and not targetexists and findtype "mushroom" backpack
        hotkey 'Eat Magic Mushroom'
        wait wait__short
    elseif var__fighting = 0 and mana >= config__mushroom_create_mana and var__regs_create_food = 1 and not warmode and not targetexists and not casting and cooldown "walk" = 0 and counttype "mushroom" backpack < config__mushroom_min_count
        cast 'Create Food'
        wait wait__short

        for 60
            if not casting
                break
            endif

            if insysmsg "Your concentration is disturbed, thus ruining thy spell."
                break
            endif

            wait wait__poll
        endfor
    endif
