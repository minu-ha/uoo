# ----------------------------------------------------------------------------------------
# The frame of every loop. Every recipe lists it first.
# It holds the settings several blocks share, the standard waits, the warning spacing, the
# signals blocks pass each other, the structured-PvP stop, the start lines and the wait at
# the end of every pass. The signals in its state keep their value unless the loop has a
# block that sets them.
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__chatty
#      1 shows the optional overheads. Warnings show either way.
#
#   config__sysmsg
#      1 writes Journal diagnostics. A block that writes one says so in its comments.
#
#   config__clear_at_start
#      What Play does first (conventions 02.D).
#        0  nothing: a cursor or a cast the player holds at Play is kept
#        1  clear the client queues, the journal and the ignore list
#
#   config__use_magery
#      1 uses Magery: the Cure and heal agents, the reagent reads and the buffs. At 0
#      potions and bandages still go out.
#
#   config__use_potions
#      1 uses potions: cure, heal, Refresh and the stat potions.
#
#   config__walk_guard
#      Our casts and the walk bar.
#        0  cast while walking, for a fight where there is no better moment to wait for
#        1  wait while the walk bar runs, so a step does not break the cast
#
#   config__warmode_is_manual
#      Whose warmode it is.
#        0  ours: our casts ignore it
#        1  the player's manual control window: our casts and the food stand down while it
#           is on. Potions and bandages still go out
# ----------------------------------------------------------------------------------------
@setvar! config__chatty 1
@setvar! config__sysmsg 1
@setvar! config__clear_at_start 1
@setvar! config__use_magery 1
@setvar! config__use_potions 1
@setvar! config__walk_guard 1
@setvar! config__warmode_is_manual 0


# ----------------------------------------------------------------------------------------
# @ wait
#
#   wait__poll
#      The poll inside a wait.
#
#   wait__short
#      The pause after an action.
#
#   interval__message
#      Spacing for repeated warnings. Without it an empty potion bag shouts every pass.
# ----------------------------------------------------------------------------------------
@setvar! wait__poll 100
@setvar! wait__short 200
@setvar! interval__message 3000


# ----------------------------------------------------------------------------------------
# @ timer
#
#   timer__message
#      Ready on the first pass, so the first warning shows at once.
# ----------------------------------------------------------------------------------------
timer__message interval__message


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__fighting
#      1 while an enemy is engaged. buff/potions drinks only then. fight/target sets it
#      every pass, and the pvp recipe keeps it at 1.
#
#   var__hold_casts
#      1 while a block keeps the cast window for itself. buff/spells stands down.
#      escape/recall sets it once a Recall is due.
#
#   var__hold_gathering
#      1 while gathering and its packing wait. escape/recall sets it.
# ----------------------------------------------------------------------------------------
@setvar! var__fighting 0
@setvar! var__hold_casts 0
@setvar! var__hold_gathering 0


# ----------------------------------------------------------------------------------------
# @ setup
# ----------------------------------------------------------------------------------------
# The pvp expression means the structured-PvP restrictions, where these loops may not run.
if pvp
    overhead "[ script, blocked ]" 254
    stop
endif

if config__clear_at_start = 1
    clearall
    clearsysmsg
    cleardragdrop
    clearignore
endif


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # STRUCTURED PVP STOP
    #
    # The pvp expression means structured-PvP restrictions, not a field PK encounter.
    # ------------------------------------------------------------------------------------
    if pvp
        overhead "[ script, blocked ]" 254
        stop
    endif


# ----------------------------------------------------------------------------------------
# @ end
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # END OF PASS
    # ------------------------------------------------------------------------------------
    wait wait__poll
