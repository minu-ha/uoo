# ----------------------------------------------------------------------------------------
# @ setup
# ----------------------------------------------------------------------------------------
# Hands. First, so a weapon is back in hand before the rest of the suit.
if findlayer self righthand as alias__dress_item
    @setvar! var__right_hand alias__dress_item

    if config__chatty = 1
        getlabel alias__dress_item label__right_hand
        overhead "[ right hand, {{label__right_hand}} ]" 290
    endif
elseif config__dress_restore = 1
    if find var__right_hand backpack
        lift var__right_hand
        drop self righthand
        wait wait__dress

        if config__chatty = 1
            getlabel var__right_hand label__right_hand
            overhead "[ worn, {{label__right_hand}} ]" 290
        endif
    endif
endif

