# ----------------------------------------------------------------------------------------
# Records what is worn on each equipment layer, and with dress_restore puts it back on.
# One block per layer findlayer accepts, so nothing is addressed by item graphic: the old
# dress equipped seven items by graphic and forced three of them onto the pants layer,
# which holds one thing, so the quiver, the short pipe and the wizard satchel overwrote
# each other. A layer that holds something is recorded. With dress_restore 1, a layer that
# is empty gets its recorded item back out of the backpack, the layer it was recorded from.
# findlayer takes 27 layers and the 25 that hold equipment are here: hair and facialhair
# are not equipment. The paperdoll slots Outlands added on top have no findlayer name, so
# gear/cosmetic puts those on (content/public/scripting/razor.md part 2).
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__dress_restore
#      What an empty layer gets.
#        0  nothing: record only, the way restock/loadout runs it at home
#        1  its recorded item back out of the backpack, after a death
# ----------------------------------------------------------------------------------------
@setvar! config__dress_restore 0


# ----------------------------------------------------------------------------------------
# @ wait
#
#   wait__dress
#      The pause after each item goes back on.
# ----------------------------------------------------------------------------------------
@setvar! wait__dress 300


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__right_hand, var__left_hand, var__one_handed_secondary, var__head, var__neck,
#   var__earrings, var__face, var__shirt, var__inner_torso, var__middle_torso,
#   var__outer_torso, var__outer_body, var__arms, var__gloves, var__ring, var__bracelet,
#   var__talisman, var__waist, var__pants, var__inner_legs, var__outer_legs, var__shoes,
#   var__cloak, var__quiver, var__backpack
#      The serial recorded on each layer, kept for the Razor session so a later run puts it
#      back. 0 until a layer is recorded.
# ----------------------------------------------------------------------------------------
if not varexist var__right_hand
    @setvar! var__right_hand 0
endif

if not varexist var__left_hand
    @setvar! var__left_hand 0
endif

if not varexist var__one_handed_secondary
    @setvar! var__one_handed_secondary 0
endif

if not varexist var__head
    @setvar! var__head 0
endif

if not varexist var__neck
    @setvar! var__neck 0
endif

if not varexist var__earrings
    @setvar! var__earrings 0
endif

if not varexist var__face
    @setvar! var__face 0
endif

if not varexist var__shirt
    @setvar! var__shirt 0
endif

if not varexist var__inner_torso
    @setvar! var__inner_torso 0
endif

if not varexist var__middle_torso
    @setvar! var__middle_torso 0
endif

if not varexist var__outer_torso
    @setvar! var__outer_torso 0
endif

if not varexist var__outer_body
    @setvar! var__outer_body 0
