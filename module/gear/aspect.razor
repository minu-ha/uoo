# ----------------------------------------------------------------------------------------
# Turns the aspects of the held item and the armor back on through the [aspect gump.
# Activated gear loses its aspect when you die, and its name loses the "<name> aspect"
# words with it (user check, 2026-10-19). So the names are read first, and only what lost
# its aspect is activated, 5 Arcane Essence each. The gump rows are what the server keeps
# for the character, so nothing is remembered here: the first run after a death or after a
# client restart works as well.
#
# The weapon row and the spellbook row share one active aspect: activating either turns
# every weapon and spellbook to it (user check, 2026-10-19). Neither the item in hand nor
# the skills tell which one a character wants, hybrids carry both. So set both rows to the
# same aspect, and aspect_hand_row picks the one pressed.
#
# Gump 2424293173, Activate buttons 8 weapon, 13 spellbook, 17 armor, each pressed twice
# the way the screen needs it (Razor recording, user check 2026-10-19). Button 102 leaves
# the unlocked list for the rows, after the "Dress Suite - Aspect" script by thisideasucks
# on outlands.uorazorscripts.com.
#
# The armor is read off the armor layers, head, neck, gloves, arms, inner torso and inner
# legs, and judged lost when one is worn and none shows an aspect. Names are matched in
# lower case, the way Razor shows them.
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__aspect_hand_row
#      The gump row pressed when the held item lost its aspect.
#        0  none: the hand is left alone
#        1  the weapon row
#        2  the spellbook row
#      Both share one aspect, so with the two rows set alike either does.
# ----------------------------------------------------------------------------------------
@setvar! config__aspect_hand_row 2


# ----------------------------------------------------------------------------------------
# @ wait
#
#   wait__aspect
#      How long an activation gets before the names are read again.
#
#   wait__aspect_gump
#      How long the gump may take to open, or to come back after a press.
# ----------------------------------------------------------------------------------------
@setvar! wait__aspect 1000
@setvar! wait__aspect_gump 1000


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__aspect_hand_item, var__aspect_armor_piece, var__aspect_armor_item
#      Scratch: the held item, the first armor piece worn, and the first one that shows
#      an aspect.
#
#   var__aspect_hand_lost, var__aspect_armor_lost
#      Scratch: 1 when that one is activated this run.
# ----------------------------------------------------------------------------------------
@setvar! var__aspect_hand_item 0
@setvar! var__aspect_armor_piece 0
@setvar! var__aspect_armor_item 0
@setvar! var__aspect_hand_lost 0
@setvar! var__aspect_armor_lost 0


# ----------------------------------------------------------------------------------------
# @ setup
# ----------------------------------------------------------------------------------------
# Whatever was still moving items has to finish before the names are read.
while queued
    wait wait__short
endwhile

# The held item. The right hand holds a one-handed weapon or the spellbook, the left a
# two-handed weapon. Empty hands leave the hand alone.
if findlayer self righthand as alias__aspect_item
    @setvar! var__aspect_hand_item alias__aspect_item
elseif findlayer self lefthand as alias__aspect_item
    @setvar! var__aspect_hand_item alias__aspect_item
endif

if config__aspect_hand_row != 0 and var__aspect_hand_item != 0
    @setvar! var__aspect_hand_lost 1
    getlabel var__aspect_hand_item label__aspect_hand
    if "aspect" in label__aspect_hand
        @setvar! var__aspect_hand_lost 0
    endif
endif

# The armor. The first piece worn is kept for the check after an activation. The armor
# still has its aspect while any piece shows one.
if findlayer self head as alias__aspect_item
    @setvar! var__aspect_armor_piece alias__aspect_item
    getlabel alias__aspect_item label__aspect_armor
    if "aspect" in label__aspect_armor
        @setvar! var__aspect_armor_item alias__aspect_item
    endif
endif

if var__aspect_armor_item = 0
    if findlayer self neck as alias__aspect_item
        if var__aspect_armor_piece = 0
            @setvar! var__aspect_armor_piece alias__aspect_item
        endif
        getlabel alias__aspect_item label__aspect_armor
        if "aspect" in label__aspect_armor
            @setvar! var__aspect_armor_item alias__aspect_item
        endif
    endif
endif

if var__aspect_armor_item = 0
    if findlayer self gloves as alias__aspect_item
        if var__aspect_armor_piece = 0
            @setvar! var__aspect_armor_piece alias__aspect_item
        endif
        getlabel alias__aspect_item label__aspect_armor
        if "aspect" in label__aspect_armor
            @setvar! var__aspect_armor_item alias__aspect_item
        endif
    endif
endif

if var__aspect_armor_item = 0
    if findlayer self arms as alias__aspect_item
        if var__aspect_armor_piece = 0
            @setvar! var__aspect_armor_piece alias__aspect_item
        endif
        getlabel alias__aspect_item label__aspect_armor
        if "aspect" in label__aspect_armor
            @setvar! var__aspect_armor_item alias__aspect_item
        endif
    endif
endif

if var__aspect_armor_item = 0
    if findlayer self innertorso as alias__aspect_item
        if var__aspect_armor_piece = 0
            @setvar! var__aspect_armor_piece alias__aspect_item
        endif
        getlabel alias__aspect_item label__aspect_armor
        if "aspect" in label__aspect_armor
            @setvar! var__aspect_armor_item alias__aspect_item
        endif
    endif
endif

if var__aspect_armor_item = 0
    if findlayer self innerlegs as alias__aspect_item
        if var__aspect_armor_piece = 0
            @setvar! var__aspect_armor_piece alias__aspect_item
        endif
        getlabel alias__aspect_item label__aspect_armor
        if "aspect" in label__aspect_armor
            @setvar! var__aspect_armor_item alias__aspect_item
        endif
    endif
endif

if var__aspect_armor_piece != 0 and var__aspect_armor_item = 0
    @setvar! var__aspect_armor_lost 1
endif

# The activation. The armor first, then the hand, the order the screen takes.
if var__aspect_hand_lost = 1 or var__aspect_armor_lost = 1
    say "[aspect"
    waitforgump 2424293173 wait__aspect_gump

    if ingump "Show Only Unlocked" 2424293173
        gumpresponse 102 2424293173
        waitforgump 2424293173 wait__aspect_gump
    endif

    if gumpexists 2424293173
        if var__aspect_armor_lost = 1
            gumpresponse 17 2424293173
            wait wait__short
            waitforgump 2424293173 wait__aspect_gump
            gumpresponse 17 2424293173
            waitforgump 2424293173 wait__aspect_gump
        endif

        if var__aspect_hand_lost = 1
            if config__aspect_hand_row = 1
                gumpresponse 8 2424293173
                wait wait__short
                waitforgump 2424293173 wait__aspect_gump
                gumpresponse 8 2424293173
                waitforgump 2424293173 wait__aspect_gump
            else
                gumpresponse 13 2424293173
                wait wait__short
                waitforgump 2424293173 wait__aspect_gump
                gumpresponse 13 2424293173
                waitforgump 2424293173 wait__aspect_gump
            endif
        endif

        gumpclose
        wait wait__aspect

        # The names show the aspect again once it took.
        if var__aspect_hand_lost = 1
            getlabel var__aspect_hand_item label__aspect_hand
            if "aspect" in label__aspect_hand
                if config__chatty = 1
                    overhead "[ aspect, on ]" 269
                endif
            else
                overhead "[ aspect, miss ]" 254
            endif
        endif

        if var__aspect_armor_lost = 1
            getlabel var__aspect_armor_piece label__aspect_armor
            if "aspect" in label__aspect_armor
                if config__chatty = 1
                    overhead "[ aspect, on ]" 269
                endif
            else
                overhead "[ aspect, miss ]" 254
            endif
        endif
    else
        overhead "[ aspect, miss ]" 254
        if config__sysmsg = 1
            sysmsg "Aspect: the [aspect gump did not open." 88
        endif
    endif
endif
