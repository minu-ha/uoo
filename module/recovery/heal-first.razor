# ----------------------------------------------------------------------------------------
# Heals first when hurt: a heal potion, then Greater Heal, then a bandage.
# For a routine that starts hurt, hotkey/regear after a resurrection. The hotkeys and
# checks of recovery/heal and recovery/bandage. A running bandage ends this part, it heals
# on while the rest runs. wait__heal_first ends it too, so nothing missing holds it up.
#
# @ hotkeys Drink Heal, > Greater Heal/Cure Self, Cancel Current Target, Bandage Self
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__heal_first_hits
#      Missing hit points at or above which the routine heals first.
#
#   config__heal_first_mana
#      Mana Greater Heal needs, as config__mana_greater_heal in recovery/heal.
# ----------------------------------------------------------------------------------------
@setvar! config__heal_first_hits 30
@setvar! config__heal_first_mana 11


# ----------------------------------------------------------------------------------------
# @ wait
#
#   wait__heal_first
#      How long the heal may take before the routine goes on regardless.
# ----------------------------------------------------------------------------------------
@setvar! wait__heal_first 10000


# ----------------------------------------------------------------------------------------
# @ timer
#
#   timer__heal_first
#      From the start of the routine.
# ----------------------------------------------------------------------------------------
timer__heal_first 0


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__heal_first_no_greater_heal
#      Scratch: 1 once Greater Heal was refused for reagents, so it is not tried again.
#
#   var__heal_first_drank
#      Scratch: 1 when a heal potion went out on this round.
# ----------------------------------------------------------------------------------------
@setvar! var__heal_first_no_greater_heal 0
@setvar! var__heal_first_drank 0


# ----------------------------------------------------------------------------------------
# @ setup
# ----------------------------------------------------------------------------------------
while diffhits >= config__heal_first_hits and timer "timer__heal_first" < wait__heal_first and not dead and not bandaging
    @setvar! var__heal_first_drank 0

    if not targetexists and findtype "Yellow Potion" self as alias__heal_first_potion
        getlabel alias__heal_first_potion label__heal_first_potion
        if "next usable" in label__heal_first_potion
            # Still on its own cooldown.
        else
            hotkey "Drink Heal"
            @setvar! var__heal_first_drank 1
        endif
    endif

    if var__heal_first_drank = 0 and var__heal_first_no_greater_heal = 0 and skill "Magery" >= 50 and mana >= config__heal_first_mana and not casting and not targetexists
        hotkey "> Greater Heal/Cure Self"
        wait wait__short

        while casting and timer "timer__heal_first" < wait__heal_first
            wait wait__short
        endwhile

        # Without the reagents it would only fail again.
        if insysmsg "More reagents are needed"
            @setvar! var__heal_first_no_greater_heal 1
        endif

        # The agent leaves its cursor up when there is nothing left to heal.
        if targetexists "beneficial" and diffhits = 0
            hotkey "Cancel Current Target"
        endif
    elseif var__heal_first_drank = 0 and skill "Healing" > 0 and not targetexists and findtype 3617 backpack
        hotkey "Bandage Self"
    endif

    wait wait__short
endwhile
