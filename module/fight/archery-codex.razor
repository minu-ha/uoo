# ----------------------------------------------------------------------------------------
# Codex of archery: Arcane, Fowling while hurt, Incendiary and Ricochet on a pack.
# A pack is two or more picked enemies alive in reach. The stance and the finisher are
# read off the codex label before either is switched, since every command is a toggle.
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__archery_stance_main
#      Stance held when neither hurt nor facing a pack, by codex slot in wiki order.
#        1  Arcane
#        2  Fowling
#        3  Incendiary
#        4  Longshot
#        5  Maiming      against casters that keep casting under Peace
#
#   config__archery_stance_pack
#      Stance while two or more picked enemies are alive in reach.
#        0  keep the main stance
#        3  Incendiary, or any slot of config__archery_stance_main
#
#   config__fowling_enter_diff
#      Missing hit points above which Fowling latches on.
#
#   config__fowling_leave_diff
#      Missing hit points below which Fowling lets go. Below the enter line, so the
#      stance cannot flap while bandages tick.
#
#   config__archery_finisher_main
#      Finisher to keep selected against one enemy.
#        0  leave the codex finisher alone
#        1  Ricochet
#        2  Pincushion
#
#   config__archery_finisher_pack
#      Finisher to keep selected against a pack.
#        0  keep the one-enemy finisher
#        1  Ricochet
#        2  Pincushion
# ----------------------------------------------------------------------------------------
@setvar! config__archery_stance_main 1
@setvar! config__archery_stance_pack 3
@setvar! config__fowling_enter_diff 45
@setvar! config__fowling_leave_diff 30
@setvar! config__archery_finisher_main 2
@setvar! config__archery_finisher_pack 1


# ----------------------------------------------------------------------------------------
# @ wait
#
#   interval__archery_check
#      How often the picked enemies are counted and the wanted stance and finisher are
#      worked out.
#
#   interval__archery_retry
#      The codex label is read at most this often while the cache differs from what is
#      wanted, so a switch that did not take is tried again.
#
#   interval__archery_resync
#      The stance and finisher cache is dropped this often, so a change made by hand is
#      picked up.
#
#   interval__archery_pack_hold
#      How long a pack is kept after fewer than two remain, so one enemy stepping out of
#      reach does not flip the stance back and forth.
# ----------------------------------------------------------------------------------------
@setvar! interval__archery_check 2000
@setvar! interval__archery_retry 3000
@setvar! interval__archery_resync 30000
@setvar! interval__archery_pack_hold 6000


# ----------------------------------------------------------------------------------------
# @ timer
#
#   timer__archery_check, timer__archery_retry
#      Ready on the first pass.
#
#   timer__archery_resync
#      Runs from the last cache drop or switch.
#
#   timer__archery_pack
#      Runs from the last count of two or more.
# ----------------------------------------------------------------------------------------
timer__archery_check interval__archery_check
timer__archery_retry interval__archery_retry
timer__archery_resync 0
timer__archery_pack 0


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__archery_want, var__archery_active
#      Stance cache by slot. 0 means unknown, which forces a codex label read.
#
#   var__archery_finisher_want, var__archery_finisher_active
#      Finisher cache: 1 Ricochet, 2 Pincushion. 0 means not managed when wanted, and
#      unknown when active, which forces a codex label read.
#
#   var__archery_disabled
#      1 when the codex label names no stance, or more than one. Switching blind could
#      toggle the stance off.
#
#   var__archery_finisher_off
#      1 when the codex label names neither finisher, or both. Switching blind could
#      toggle the finisher off.
#
#   var__archery_hurt
#      1 from the Fowling enter line until the leave line.
#
#   var__archery_pack
#      1 while two or more picked enemies are alive in reach, and for
#      interval__archery_pack_hold after.
#
#   var__archery_read
#      Scratch: 1 when the cache differs from what is wanted, so the label is read.
# ----------------------------------------------------------------------------------------
@setvar! var__archery_want config__archery_stance_main
@setvar! var__archery_active 0
@setvar! var__archery_finisher_want 0
@setvar! var__archery_finisher_active 0
@setvar! var__archery_disabled 0
@setvar! var__archery_finisher_off 0
@setvar! var__archery_hurt 0
@setvar! var__archery_pack 0
@setvar! var__archery_read 0


# ----------------------------------------------------------------------------------------
# @ setup
# ----------------------------------------------------------------------------------------
# The picked enemies are kept across Plays, as bard/provo keeps its pool. Dead and far ones
# leave on the next count in a fight.
if not listexists 'list__archery_picked'
    createlist 'list__archery_picked'
endif
if not listexists 'list__archery_keep'
    createlist 'list__archery_keep'
endif
if not listexists 'list__archery_near'
    createlist 'list__archery_near'
endif


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # ARCHERY CODEX
    #
    # Arcane is the default: accuracy and damage at 3% per rank, with no condition.
    # Fowling gives up a third of that damage for 4% damage resistance per rank after each
    # shot, so it takes over while hurt, on the same lines as the sword codex's Defensive.
    # Incendiary sends 10% per rank to a random enemy within 2 tiles of the target, so it
    # pays only with another enemy beside the target. Maiming lengthens Hinder, which
    # rides the 10% weapon special and repeats what Peace already holds. Longshot buys
    # range the crossbow does not need. Numbers and reasons: Bard Archer 02.B.
    #
    # A tier 5 finisher fires once per creature at 25% health. Pincushion lands 600% on
    # the target, Ricochet 350% on it and on up to two more within 6 tiles, so Pincushion
    # against one enemy and Ricochet against a pack (Bard Archer 02.C).
    #
    # A pack is two or more picked enemies alive within config__target_range. Razor finds
    # no enemy by itself, so every enemy you pick joins a list, the way bard/provo keeps
    # its pool, and the list is counted every interval__archery_check while fighting with
    # two or more on it. The count cannot see which enemy stands beside the target. A pack
    # outlives the count by interval__archery_pack_hold, and Fowling outranks it.
    #
    # The codex label is the only source of truth, as in fight/sword-codex. Every command
    # toggles, so a stance or finisher is switched only after the label shows which one is
    # on, and a label that names none, or more than one, stands that part down for the
    # Play. The server puts a stance change over your head itself ("Fowling ammunition"),
    # so only the finisher switch shows an overhead here.
    # ------------------------------------------------------------------------------------
    if var__combat_target != 0 and not inlist 'list__archery_picked' var__combat_target
        pushlist 'list__archery_picked' var__combat_target
    endif

    if timer "timer__archery_check" >= interval__archery_check
        settimer "timer__archery_check" 0

        if timer "timer__archery_resync" >= interval__archery_resync
            @setvar! var__archery_active 0
            @setvar! var__archery_finisher_active 0
            settimer "timer__archery_resync" 0
        endif

        clearlist 'list__archery_near'
        if var__fighting = 1 and list 'list__archery_picked' >= 2
            clearlist 'list__archery_keep'
            foreach archery_mob in list__archery_picked
                if find archery_mob ground -1 -1 config__acquire_range as alias__archery_mob
                    if not dead alias__archery_mob
                        pushlist 'list__archery_keep' archery_mob
                        if find archery_mob ground -1 -1 config__target_range
                            pushlist 'list__archery_near' archery_mob
                        endif
                    endif
                endif
            endfor

            clearlist 'list__archery_picked'
            foreach archery_mob in list__archery_keep
                pushlist 'list__archery_picked' archery_mob
            endfor
        endif

        if list 'list__archery_near' >= 2
            @setvar! var__archery_pack 1
            settimer "timer__archery_pack" 0
        elseif timer "timer__archery_pack" >= interval__archery_pack_hold
            @setvar! var__archery_pack 0
        endif

        if diffhits > config__fowling_enter_diff
            @setvar! var__archery_hurt 1
        elseif diffhits < config__fowling_leave_diff
            @setvar! var__archery_hurt 0
        endif

        if var__archery_hurt = 1
            @setvar! var__archery_want 2
        elseif var__archery_pack = 1 and config__archery_stance_pack != 0
            @setvar! var__archery_want config__archery_stance_pack
        else
            @setvar! var__archery_want config__archery_stance_main
        endif

        if var__archery_pack = 1 and config__archery_finisher_pack != 0
            @setvar! var__archery_finisher_want config__archery_finisher_pack
        else
            @setvar! var__archery_finisher_want config__archery_finisher_main
        endif

        @setvar! var__archery_read 0
        if var__archery_disabled = 0 and var__archery_want != var__archery_active
            @setvar! var__archery_read 1
        elseif var__archery_finisher_off = 0 and var__archery_finisher_want != 0 and var__archery_finisher_want != var__archery_finisher_active
            @setvar! var__archery_read 1
        endif

        if var__archery_read = 1 and timer "timer__archery_retry" >= interval__archery_retry
            settimer "timer__archery_retry" 0

            if findtype 11886 backpack as alias__archery_codex
                getlabel alias__archery_codex label__archery_codex

                # Two names at once means the label lists stances rather than the one on.
                if var__archery_disabled = 0
                    if "Arcane" in label__archery_codex and "Fowling" in label__archery_codex
                        @setvar! var__archery_disabled 1
                    elseif "Arcane" in label__archery_codex
                        @setvar! var__archery_active 1
                    elseif "Fowling" in label__archery_codex
                        @setvar! var__archery_active 2
                    elseif "Incendiary" in label__archery_codex
                        @setvar! var__archery_active 3
                    elseif "Longshot" in label__archery_codex
                        @setvar! var__archery_active 4
                    elseif "Maiming" in label__archery_codex
                        @setvar! var__archery_active 5
                    else
                        @setvar! var__archery_disabled 1
                    endif

                    if var__archery_disabled = 1
                        overhead "[ archery stance, off ]" 254
                        if config__sysmsg = 1
                            sysmsg "Archery codex label names no single stance, the stance stands down: {{label__archery_codex}}" 88
                        endif
                    endif
                endif

                if var__archery_finisher_off = 0 and var__archery_finisher_want != 0
                    if "Ricochet" in label__archery_codex and "Pincushion" in label__archery_codex
                        @setvar! var__archery_finisher_off 1
                    elseif "Ricochet" in label__archery_codex
                        @setvar! var__archery_finisher_active 1
                    elseif "Pincushion" in label__archery_codex
                        @setvar! var__archery_finisher_active 2
                    else
                        @setvar! var__archery_finisher_off 1
                    endif

                    if var__archery_finisher_off = 1
                        overhead "[ archery finisher, off ]" 254
                        if config__sysmsg = 1
                            sysmsg "Archery codex label names no single finisher, the finisher stands down: {{label__archery_codex}}" 88
                        endif
                    elseif var__archery_finisher_want != var__archery_finisher_active
                        if var__archery_finisher_want = 1
                            say "[ArcheryFinisher1"
                        elseif var__archery_finisher_want = 2
                            say "[ArcheryFinisher2"
                        endif
                        @setvar! var__archery_finisher_active var__archery_finisher_want
                        if config__sysmsg = 1
                            sysmsg "Archery finisher switch: slot {{var__archery_finisher_want}}." 88
                        endif
                        if config__chatty = 1
                            if var__archery_finisher_want = 1
                                overhead "[ archery, ricochet ]" 290
                            elseif var__archery_finisher_want = 2
                                overhead "[ archery, pincushion ]" 290
                            endif
                        endif
                        # Keep the finisher and stance commands apart.
                        wait wait__short
                    endif
                endif

                if var__archery_disabled = 0 and var__archery_want != var__archery_active
                    if config__sysmsg = 1
                        sysmsg "Archery stance switch: slot {{var__archery_active}} to {{var__archery_want}}." 88
                    endif
                    if var__archery_want = 1
                        say "[ArcheryAmmunition1"
                    elseif var__archery_want = 2
                        say "[ArcheryAmmunition2"
                    elseif var__archery_want = 3
                        say "[ArcheryAmmunition3"
                    elseif var__archery_want = 4
                        say "[ArcheryAmmunition4"
                    elseif var__archery_want = 5
                        say "[ArcheryAmmunition5"
                    endif

                    # Assume it took. Saying it again before the label catches up would risk
                    # toggling the stance straight back off.
                    @setvar! var__archery_active var__archery_want
                    settimer "timer__archery_resync" 0
                endif
            elseif timer "timer__message" >= interval__message
                overhead "[ archery codex, out ]" 254
                settimer "timer__message" 0
            endif
        endif
    endif
