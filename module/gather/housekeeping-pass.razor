# One five second clock for the slow checks. Its flag tells the later blocks this pass is one.
#@ wait
@setvar! cooldown__housekeeping 5000
#@ timer
if not timerexists "timer__housekeeping"
    createtimer "timer__housekeeping"
endif
#@ ready
settimer "timer__housekeeping" cooldown__housekeeping
#@ state
# 1 when housekeeping is due this pass. Recall uses this clock before harvesting.
# Inventory maintenance runs last, after Tracking detection.
@setvar! var__housekeeping_pass 0
#@ loop
    # Schedule slow checks without running optional inventory work ahead of recovery or harvest.
    @setvar! var__housekeeping_pass 0
    if timer "timer__housekeeping" >= cooldown__housekeeping
        @setvar! var__housekeeping_pass 1
    endif
