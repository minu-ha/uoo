# ----------------------------------------------------------------------------------------
# Moves carried leather into the loot bag every 2 minutes, between fights.
# The bag is global__my_loot_bag, picked by restock/loadout or by the recipe's setup.
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ wait
#
#   wait__pack_item
#      Allow inventory updates after opening the bag and each drag/drop.
#
#   wait__pack_batch
#      Request budget for one packing pass. Leftover leather waits for the next interval.
#
#   interval__pack_leather
#      120000 = 2 minutes. Use 180000 for 3 minutes.
# ----------------------------------------------------------------------------------------
@setvar! wait__pack_item 500
@setvar! wait__pack_batch 2500
@setvar! interval__pack_leather 120000


# ----------------------------------------------------------------------------------------
# @ timer
#
#   timer__pack_leather
#      Packing waits one full interval.
# ----------------------------------------------------------------------------------------
timer__pack_leather 0


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # LEATHER
    #
    # Same shape as the Boards pass in pack/lumber. No hue filter, so colored leather
    # moves too. Only between fights. Recursive backpack searches can return leather
    # already in the bag, so membership is checked before ignore, and only bag stacks are
    # ignored. No clearignore here: the list also holds the carved corpses. A refused
    # move is found again and retried until the pass budget runs out, then on the next
    # interval.
    # ------------------------------------------------------------------------------------
    if timer "timer__pack_leather" >= interval__pack_leather and var__combat_target = 0
        if diffhits < config__heal_hits and not poisoned and not paralyzed
            if not hidden and not queued and not casting and not targetexists
                settimer "timer__pack_leather" 0

                if find global__my_loot_bag backpack
                    if config__sysmsg = 1
                        sysmsg "Leather pack BEGIN." 88
                    endif
                    dclick global__my_loot_bag
                    wait wait__pack_item
                    settimer "timer__pack_leather" 0

                    while queued and timer "timer__pack_leather" < wait__pack_batch and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists
                        wait wait__poll
                    endwhile

                    while timer "timer__pack_leather" < wait__pack_batch and not queued and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists and find global__my_loot_bag backpack and findtype 4225 backpack as alias__leather_stack
                        if find alias__leather_stack global__my_loot_bag
                            @ignore alias__leather_stack
                        else
                            # Complete lift/drop together. Do not leave the item held during a wait.
                            if config__sysmsg = 1
                                sysmsg "Leather move request: serial={{alias__leather_stack}}." 88
                            endif
                            lift alias__leather_stack 60000
                            drop global__my_loot_bag -1 -1
                            wait wait__pack_item
                        endif

                        while queued and timer "timer__pack_leather" < wait__pack_batch and not dead and not pvp and diffhits < config__heal_hits and not poisoned and not paralyzed and not hidden and not casting and not targetexists
                            wait wait__poll
                        endwhile
                    endwhile
                    if config__sysmsg = 1
                        sysmsg "Leather pack END." 88
                    endif
                elseif timer "timer__message" >= interval__message
                    overhead "[ loot bag, out ]" 254
                    settimer "timer__message" 0
                endif
                # The next interval starts after this pass, including a missing-bag attempt.
                settimer "timer__pack_leather" 0
            endif
        endif
    endif
