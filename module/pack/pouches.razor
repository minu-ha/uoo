# ----------------------------------------------------------------------------------------
# Picks the supply pouch and the loot bag, by itself when the backpack has one of each.
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__pouches_ask
#      What happens when one of the two cannot be found by itself.
#        1  asks for it with a cursor
#        0  leaves it unset and says so with an out, so no cursor holds the run
# ----------------------------------------------------------------------------------------
@setvar! config__pouches_ask 1


# ----------------------------------------------------------------------------------------
# @ setup
# ----------------------------------------------------------------------------------------
# Two containers, so one grab off a corpse does not take everything. Both are kept in your
# Razor profile like the house containers of restock/house.
#
#   supply pouch  global__my_supply_pouch, a plain pouch (3705, hue 0). The supplies
#                 pack/sorting puts away, and what loot/recycle keeps
#   loot bag      global__my_loot_bag, a bag (3702). Raw loot only: the leather and the
#                 boards pack/leather and pack/lumber gather, and the dagger
#
# Each is found by itself when the backpack holds exactly one of its kind, and otherwise
# asked for, or left unset with config__pouches_ask 0. Until 2026-10-19 one pouch did
# both jobs as global__my_looting_pouch. That pouch is the supply pouch now, so the old
# name is dropped once the new one is set.
if not varexist global__my_supply_pouch or not find global__my_supply_pouch backpack
    unsetvar global__my_supply_pouch

    if counttype 3705 backpack 0 = 1 and findtype 3705 backpack 0 as alias__found_pouch
        setvar global__my_supply_pouch alias__found_pouch
        if config__chatty = 1
            overhead "[ supplies, set ]" 290
        endif
    elseif config__pouches_ask = 1
        overhead "[ supplies, pick ]" 255
        setvar global__my_supply_pouch
    else
        overhead "[ supplies, out ]" 254
    endif
endif

if varexist global__my_supply_pouch and varexist global__my_looting_pouch
    unsetvar global__my_looting_pouch
endif

if not varexist global__my_loot_bag or not find global__my_loot_bag backpack
    unsetvar global__my_loot_bag

    if counttype 3702 backpack = 1 and findtype 3702 backpack as alias__found_bag
        setvar global__my_loot_bag alias__found_bag
        if config__chatty = 1
            overhead "[ loot bag, set ]" 290
        endif
    elseif config__pouches_ask = 1
        overhead "[ loot bag, pick ]" 255
        setvar global__my_loot_bag
    else
        overhead "[ loot bag, out ]" 254
    endif
endif
