# ----------------------------------------------------------------------------------------
# One bard song per walk pass, Discordance, Peacemaking and Provocation in turn.
#
# @ hotkeys Cancel Current Target
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ wait
#
#   interval__song_retry
#      How long a song that was refused or blocked waits before the next try. A blocked
#      try starts the 5 second Music window again (Bard Necro part 2), so a little more.
# ----------------------------------------------------------------------------------------
@setvar! interval__song_retry 6000


# ----------------------------------------------------------------------------------------
# @ timer
#
#   timer__song_retry
#      Ready on the first pass.
# ----------------------------------------------------------------------------------------
timer__song_retry interval__song_retry


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__song_next
#      Which song plays next: 1 discordance, 2 peacemaking, 3 provocation. Literal values,
#      since Razor has no arithmetic.
#
#   var__song_after
#      Scratch: the song after the one just played.
#
#   var__song_answer
#      Scratch: 0 no answer, 1 the song took, 2 blocked or refused.
# ----------------------------------------------------------------------------------------
if not varexist var__song_next
    @setvar! var__song_next 1
endif

@setvar! var__song_after 0
@setvar! var__song_answer 0


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # BARD SONG
    #
    # Three 15 minute AoE buffs, each worth 8.5% at this Effective Barding, landing on the
    # player and every follower in range. Sung on the walk between pulls, never in a
    # fight: while engaged, Discordance and Peacemaking keep Music busy so a song rarely
    # gets a window, and playing an instrument interrupts a spell already in flight.
    #
    # Singing on the walk is what removes follower tracking from this script. A resummoned
    # creature picks the songs up on the next walk, so nothing has to notice that it died.
    #
    # findbuff is deliberately NOT the gate. The buffs run 15 minutes, so a findbuff test
    # would be true almost always and the refresh would never fire. The gate is the song
    # cooldown plus the slot each song borrows.
    #
    # var__song_next only moves on once the song took, read off "under the effect of a
    # Song". A song that was blocked or refused is tried again after interval__song_retry,
    # not every pass: a blocked try starts the server's Music window again, and before the
    # music bar learned the blocked lines (Bard Necro 02.I) trying every pass kept every
    # song blocked for good. The wait stays for a profile without those triggers.
    #
    # The song goes on yourself, the backpack. The ground works too, but a house refuses
    # it and Shadowspire Cathedral refuses the script's (Bard Necro 02.B), and each
    # refusal burns a Music window. The backpack answers a harmful cursor and moves
    # lastharmful, which the loop does not read for its target (fight/target): only the
    # keys pressed by hand point at the backpack until the next pick.
    #
    # The chain only picks the skill and the song after it, the three share the rest.
    # ------------------------------------------------------------------------------------
    if cooldown "song" = 0 and cooldown "music" = 0 and timer "timer__song_retry" >= interval__song_retry and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
        @setvar! var__song_after 0

        # Read off, so an old line cannot pass for this song's answer.
        if insysmsg "under the effect of a Song"
            # Read off.
        endif

        if insysmsg "use another skill"
            # Read off.
        endif

        if insysmsg "another barding song"
            # Read off.
        endif

        if insysmsg "provoke or pacify another creature"
            # Read off.
        endif

        if var__song_next = 1 and skill "Discordance" > 0 and cooldown "disco" = 0
            useskill 'Discordance'
            @setvar! var__song_after 2
        elseif var__song_next = 2 and skill "Peacemaking" > 0 and cooldown "peace/provo" = 0
            useskill 'Peacemaking'
            @setvar! var__song_after 3
        elseif var__song_next = 3 and skill "Provocation" > 0 and cooldown "peace/provo" = 0
            useskill 'Provocation'
            @setvar! var__song_after 1
        endif

        if var__song_after != 0
            waitfortarget wait__bard_target

            if insysmsg "What instrument shall you play"
                target var__my_instrument
                waitfortarget wait__bard_target

                if insysmsg "That is not a musical instrument"
                    @setvar! var__my_instrument 0
                endif
            endif

            if targetexists
                target backpack

                # The answer comes within a second. Read on every round until it does,
                # with no break: this loop sits inside the main one.
                @setvar! var__song_answer 0

                for 5
                    if var__song_answer = 0
                        if insysmsg "under the effect of a Song"
                            @setvar! var__song_answer 1
                        elseif insysmsg "use another skill" or insysmsg "another barding song" or insysmsg "provoke or pacify another creature"
                            @setvar! var__song_answer 2
                        else
                            wait wait__short
                        endif
                    endif
                endfor

                if var__song_answer = 1
                    @setvar! var__song_next var__song_after
                else
                    settimer "timer__song_retry" 0
                endif
            endif
        endif
    endif
