# ----------------------------------------------------------------------------------------
# Discordance once per target, read off its label, then left alone for 30 seconds.
#
# @ hotkeys Cancel Current Target
# ----------------------------------------------------------------------------------------


# ----------------------------------------------------------------------------------------
# @ config
#
#   config__keep_virtuoso
#      1 discords the target again once the Virtuoso buff is gone, even when its label
#      already shows discord. Virtuoso lasts 15 seconds after a successful barding
#      action, and a Discordance on a discorded creature still counts (Bard Necro 02.Q).
# ----------------------------------------------------------------------------------------
@setvar! config__keep_virtuoso 0


# ----------------------------------------------------------------------------------------
# @ wait
#
#   interval__disco_seen
#      How long a target is left alone once its label has shown discord. Discordance runs
#      about two minutes.
# ----------------------------------------------------------------------------------------
@setvar! interval__disco_seen 30000


# ----------------------------------------------------------------------------------------
# @ timer
#
#   timer__disco_seen
#      Runs from the last label that showed Discordance.
#
#   timer__disco_target
#      Bounds delivery of the cursor opened by this block.
# ----------------------------------------------------------------------------------------
timer__disco_seen 0
timer__disco_target 0


# ----------------------------------------------------------------------------------------
# @ state
#
#   var__disco_seen
#      The target last seen discorded, 0 when none. Empty at every start.
#
#   var__disco_again
#      1 when Virtuoso ran out on a target seen discorded, so the next Discordance goes
#      out whatever the label shows. Cleared when it goes.
# ----------------------------------------------------------------------------------------
@setvar! var__disco_seen 0
@setvar! var__disco_again 0


# ----------------------------------------------------------------------------------------
# @ loop
# ----------------------------------------------------------------------------------------
    # ------------------------------------------------------------------------------------
    # DISCO
    #
    # Discordance runs about two minutes and does not break, so it is applied once per
    # target and then left alone. In bard-necro it goes before Peace because Ensemble
    # wants Discord AND Peace on the same creature, and the one that does not break is
    # worth landing first: the followers hold the mob and the player is ten tiles back.
    # With nothing else holding the mob, Peace is what keeps it off the player, so such a
    # loop lists bard/peace first, as bard-mace led with Peace. Skill is 80 on both, so
    # the odds are the same either way and the order is only about which effect is worth
    # more.
    #
    # Music is shared with bard/peace and bard/provo, so whichever fires first stands the
    # others down until the next pass. bard/provo runs earlier in the pass, so while a
    # pair is free Discordance on a new target waits out one Music window. That is the
    # arbitration, no extra state needed.
    #
    # warmode is the manual control window, tested on the gate line with the instrument. A
    # target whose label already shows discord is remembered in var__disco_seen and
    # forgotten once interval__disco_seen has run, instead of a find and a getlabel a
    # pass.
    #
    # With config__keep_virtuoso 1 it is also forgotten once the Virtuoso buff is gone,
    # and var__disco_again sends the next Discordance whatever its label shows. Virtuoso
    # lasts 15 seconds after a successful barding action, a Discordance on a discorded
    # creature renews it and a song does not (Bard Necro 02.Q). So on one long target the
    # skill goes out about every 15 seconds, after a lapsed Peace when that block runs
    # first.
    # ------------------------------------------------------------------------------------
    # Forget the target seen discorded, so its label is read again.
    if timer "timer__disco_seen" >= interval__disco_seen
        @setvar! var__disco_seen 0
    elseif config__keep_virtuoso = 1 and var__disco_seen != 0 and not findbuff "Virtuoso"
        @setvar! var__disco_seen 0
        @setvar! var__disco_again 1
    endif

    if var__combat_target != var__disco_seen and cooldown "disco" = 0 and cooldown "music" = 0 and skill "Discordance" > 0 and not warmode and var__instrument_ok = 1 and var__my_instrument != 0 and not targetexists and not casting
        if find var__combat_target ground -1 -1 config__target_range as alias__disco_target
            @unsetvar! label__disco_target
            @setvar! label__disco_target 0
            getlabel alias__disco_target label__disco_target

            if label__disco_target = 0
                # No label, no cast decision.
            elseif "discord" in label__disco_target and var__disco_again = 0
                @setvar! var__disco_seen var__combat_target
                settimer "timer__disco_seen" 0
            elseif not warmode and not targetexists and not casting
                @setvar! var__disco_again 0

                if insysmsg "What instrument shall you play"
                    # Read off before this request.
                endif

                useskill 'Discordance'
                waitfortarget wait__bard_target

                # Answered once, before the delivery loop. Razor asks for an
                # instrument only when its cached one is gone, and answering it
                # makes the skill open the real target cursor, so the wait is
                # simply repeated. replay is documented as restarting the whole
                # script from the top, which would re-run the entire setup.
                if not warmode and targetexists and insysmsg "What instrument shall you play"
                    target var__my_instrument
                    waitfortarget wait__bard_target

                    if insysmsg "That is not a musical instrument"
                        @setvar! var__my_instrument 0
                    endif
                endif

                if find lastharmful ground -1 -1 config__acquire_range as alias__fresh_target
                    if not dead alias__fresh_target and var__combat_target != alias__fresh_target and var__target_hold != alias__fresh_target
                        if noto alias__fresh_target = "hostile" or noto alias__fresh_target = "criminal" or noto alias__fresh_target = "enemy" or noto alias__fresh_target = "murderer"
                            @setvar! var__combat_target alias__fresh_target
                            settimer "timer__target_grace" 0

                            if find var__combat_target ground -1 -1 config__target_range as alias__disco_target
                                if config__chatty = 1
                                    overhead "[ target, set ]" 1288 var__combat_target
                                endif
                            endif
                        endif
                    endif
                endif

                settimer "timer__disco_target" 0

                while targetexists and not warmode and timer "timer__disco_target" < wait__bard_target
                    if dead alias__disco_target or var__combat_target != alias__disco_target
                        hotkey "Cancel Current Target"
                        wait wait__short
                    else
                        target alias__disco_target
                        wait wait__short
                    endif
                endwhile

                if targetexists and not warmode
                    hotkey "Cancel Current Target"
                endif

                wait wait__short
            endif
        endif
    endif
