{
  "name": "uoo-razor-script",
  "displayName": "Razor Script (uoo)",
  "version": "1.0.0",
  "description": "Outlands Razor script highlighting with the uoo module, recipe and banner conventions.",
  "publisher": "uoo",
  "engines": {
    "vscode": "^1.60.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "razor-script",
        "aliases": [
          "Razor Script"
        ],
        "extensions": [
          ".razor"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "razor-script",
        "scopeName": "source.razor",
        "path": "./syntaxes/razor.tmLanguage.json"
      }
    ]
  }
}
