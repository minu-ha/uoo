# Recipe for script/gather/skinning-enhanced.razor. Build it with: node util/build-scripts.mjs
# Every setting of this loop: node util/build-scripts.mjs --settings recipe/skinning-enhanced-recipe.razor
# @ output script/gather/skinning-enhanced.razor


# ========================================================================================
# @ header
# ========================================================================================

# Dungeon Two-Handed Axe melee with Magery self support, combat potions, sword codex control and corpse skinning.
# Needs: a Two-Handed Axe, a skinning knife, codices of swords and parrying, bandages, potions and reagents.
# Optional: the loadout looting pouch.
# Template: Forensic Evaluation 120, Swordsmanship 100, Tactics 100, Magery, Resisting Spells, Parrying, Anatomy, Healing 80.
# Optional cooldown bars: heal pot, walk, reflect. A missing bar reads 0 and cannot hold a cast back.
# Melee stays manual (Z then V). The script never attacks and never picks a target.
# Magery is for recovery and PK readiness: Smart Heal/Cure, Greater Heal, Reactive Armor and Magic Reflection.
# Warmode is toggled by hand (Tab). Recovery, buffs and skinning ignore it. Meet a PK with combat/pvp (F4).
# The knife is used from the backpack, so the axe stays equipped. Leather is looted by hand from the opened corpse.
# Design notes and in-game checks: document/questions/open-items.md part 11.


# ========================================================================================
# @ blocks
#
#   One box per block, in the order the blocks run, base first. The builder writes the box.
#   Yours are the "> " lines in it (a note on the block, or under a setting the reason for
#   its value) and the @setvar! lines under it. Write a new @setvar! line under any box, its
#   reason as a "#" line right above it: the builder moves both to the box it belongs to.
# ========================================================================================

# ----------------------------------------------------------------------------------------
# @ use base
#
#   The frame of every loop. Every recipe lists it first.
#
#   heal_skill_min (default 0)
#      Healing must be above this to bandage. At or below it recovery/light-heal stands
#      in.
#      Read by recovery/bandage, recovery/light-heal.
#      > Healing 80 template. Below 10 the light Heal stands in.
# ----------------------------------------------------------------------------------------
@setvar! config__heal_skill_min 10

# ----------------------------------------------------------------------------------------
# @ use fight/target
#
#   Remembers the picked enemy and sets var__fighting while it is in reach.
# ----------------------------------------------------------------------------------------

# ========================================================================================
# @ when paralyzed or poisoned or diffhits > 0
# ========================================================================================

# ----------------------------------------------------------------------------------------
# @ use recovery/cure
#
#   The trapped pouch while paralyzed, else a cure potion or the Smart Heal/Cure agent.
# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# @ use recovery/heal
#
#   Heal potion at heal_hits, else Greater Heal at emergency_hits.
#
#   emergency_hits (default 35)
#      Missing hit points that cast Greater Heal when no heal potion went out on this
#      pass. Not below heal_hits.
#      > Bandages handle ordinary damage, so Greater Heal waits for 45.
# ----------------------------------------------------------------------------------------
@setvar! config__emergency_hits 45

# ----------------------------------------------------------------------------------------
# @ use recovery/bandage
#
#   Self bandage while hurt or poisoned, never over a running one.
# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# @ use recovery/light-heal
#
#   The light Heal agent: the bandage stand-in, or beside them with use_light_heal 1.
# ----------------------------------------------------------------------------------------

# ========================================================================================
# @ end
# ========================================================================================

# ----------------------------------------------------------------------------------------
# @ use recovery/refresh
#
#   Total Refresh at or below refresh_stam.
#
#   refresh_stam (default 15)
#      Current stamina at or below this drinks a Refresh.
#      > DEX 80 gives about 80 stamina. Refresh at 60.
# ----------------------------------------------------------------------------------------
@setvar! config__refresh_stam 60

# ----------------------------------------------------------------------------------------
# @ use fight/axe
#
#   Re-arms the cached Two-Handed Axe when the left hand is empty.
# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# @ use pack/gold-drop
#
#   Drops gold at your feet while over max weight, one drop per pass.
# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# @ use buff/potions
#
#   Strength and Agility by stat value, Magic Resist by its icon, while fighting.
#
#   str_potion (default 120, the same value)
#      STR with the Greater Strength potion on: your base plus 20. Below it the potion is
#      drunk, and 0 turns it off. Bless and the Strength spell, ours or an ally's, show
#      the same icon as the potion but add less than its 20, so the stat tells them apart.
#      > STR 100 and DEX 80 template.
# ----------------------------------------------------------------------------------------
@setvar! config__str_potion 120

# ----------------------------------------------------------------------------------------
# @ use fight/sword-codex
#
#   Codex of swords: Warrior, Defensive while hurt, and the finisher.
# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# @ use fight/parry-codex
#
#   Codex of parrying: the main stance, Warding against damage over time, the finisher.
# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# @ use fight/weapon-ability
#
#   The weapon ability on the remembered enemy within 2 tiles, once per meter fill.
# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# @ use buff/spells
#
#   Reactive Armor, then Magic Reflection, whenever one is missing.
#
#   mana_reactive_armor (default 4)
#      Minimum current mana to start Reactive Armor.
#      > Buffs keep the lumberjack handbook's 20 mana for Greater Heal and Teleport against a PK.
#
#   mana_magic_reflect (default 14)
#      Minimum current mana to start Magic Reflection.
#      > Same reserve: the base 14 plus the handbook's 20.
#
#   buff_when_poisoned (default 1)
#      Buffs while poisoned.
#        0  no: hold them back and cut one that is casting, so the cure goes first
#        1  yes
#      > The cure goes first: no buffs while poisoned.
# ----------------------------------------------------------------------------------------
@setvar! config__mana_reactive_armor 24
@setvar! config__mana_magic_reflect 34
@setvar! config__buff_when_poisoned 0

# ----------------------------------------------------------------------------------------
# @ use gather/skinning
#
#   Forensic Evaluation carving of corpses within 2 tiles, between fights.
# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# @ use magery/reagents
#
#   Reagent flags for the Magery casts, the mana per circle and the shared cast settings.
#   > Read after gather/skinning, so it cannot consume the carve replies.
# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# @ use buff/food
#
#   Eats from a tray while Food Satisfaction is missing, looked at once a minute.
# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------------------------
# @ use pack/leather
#
#   Moves carried leather into the loot pouch every 2 minutes, between fights.
# ----------------------------------------------------------------------------------------


# ========================================================================================
# @ setup
# ========================================================================================

# pack/leather moves leather into this pouch. restock/loadout picks it, this asks when it is missing.
if not varexist global__my_looting_pouch or not find global__my_looting_pouch backpack
    overhead "[ loot pouch, pick ]" 255
    setvar global__my_looting_pouch
endif

# loot/recycle runs the hotkey named in this list when it finishes or gives up. A list, because
# a variable cannot hold a word (document/scripting/razor.md part 3). It lasts until the client closes.
if not listexists 'list__resume_script'
    createlist 'list__resume_script'
endif
clearlist 'list__resume_script'
pushlist 'list__resume_script' 'Play Script: gather\skinning-enhanced'

if config__sysmsg = 1
    sysmsg "Skinning enhanced v11 loaded: skin unowned={{config__skin_unowned}}, sword stance={{config__sword_stance_main}}, parry stance={{config__parry_stance_main}}." 88
endif
if config__chatty = 1
    overhead "[ skinning, on ]" 290
endif
